    {
      "id": 4821,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e تجارت میان جمهوری اسلامی و اروپا در نخستین ماه جنگ سقوط کرد\u003cbr/\u003e\u003cbr/\u003eداده‌های مرکز آمار اتحادیۀ اروپا نشان می‌دهد تجارت میان جمهوری اسلامی و اتحادیۀ اروپا در ماه مارس، همزمان با آغاز جنگ، به‌شدت کاهش یافت.\u003cbr/\u003eصادرات آلمان به خاک ایران در ماه مارس به کمتر از ۲۵ میلیون یورو رسید. این رقم، درحدود یک‌سوم ماه‌های پیش از جنگ است.\u003cbr/\u003eهمچنین صادرات ایتالیا، فرانسه و اتریش به خاک ایران نیز کاهشی چشمگیر داشته است.\u003cbr/\u003eدر سال پیشین میلادی حدودا۷۵۰ میلیون یورو از خاک ایران به اتحادیۀ اروپا صادرات صورت گرفته بود.\u003cbr/\u003eواردات به خاک ایران از مبدأ کشورهای اتحادیه نیز رقمی درحدود ۲.۷ میلیارد یورو بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF\"\u003e#اقتصاد\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AC%D8%A7%D8%B1%D8%AA\"\u003e#تجارت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
