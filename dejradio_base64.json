    {
      "id": 4822,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e یک مقام مجلس گفت تصمیمی برای بازگشایی اینترنت جهانی گرفته نشده است\u003cbr/\u003e\u003cbr/\u003eعلی یزدی‌خواه، نائب‌ رئیس کمیسیون فرهنگی مجلس، گفت در شرایط کنونی تصمیمی برای بازگشایی اینترنت جهانی گرفته نشده و محدودیت‌ها ادامه می‌یابد.\u003cbr/\u003eاو قطعی سراسری اینترنت را برگرفته از مصوبات شورای عالی امنیت ملی نظام و بر اساس «ملاحظات امنیتی» عنوان کرد.\u003cbr/\u003eیزدی‌خواه با وجود قطعی اینترنت مدعی شد بیش از ۹۰ درصد نیازهای مردم برطرف می‌شود و اعتراض گسترده‌ای به وضعیت موجود وجود ندارد.\u003cbr/\u003e نمایندۀ مجلس شورای اسلامی همچنین ادعا کرد تاکنون بیش از یک میلیون نفر در قالب طرح موسوم به «اینترنت پرو» به اینترنت بین‌الملل متصل شده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%DB%8C%D9%86%D8%AA%D8%B1%D9%86%D8%AA\"\u003e#اینترنت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
