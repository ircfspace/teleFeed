    {
      "id": 4820,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e رایزنی مصر، قطر و عربستان دربارۀ مذاکرات تهران و واشینگتن\u003cbr/\u003e\u003cbr/\u003eوزیر امور خارجۀ مصر در تماس‌های جداگانه با همتایان قطری و سعودی، در مورد مذاکرات میان جمهوری اسلامی و آمریکا گفت‌وگو کرد.\u003cbr/\u003eقاهره اعلام کرد محور این رایزنی‌ها مهار تنش‌های منطقه‌ای و پشتیبانی از مسیر دیپلماسی بود.\u003cbr/\u003eوزیر امور خارجۀ مصر از تصمیم دونالد ترامپ برای فرصت دادن به مذاکره با تهران، قدردانی کرد.\u003cbr/\u003eاو گفت هر توافق احتمالی باید نگرانی‌های امنیتی کشورهای خلیج فارس را نیز در نظر بگیرد.\u003cbr/\u003eمصر پیش‌تر نیز در کنار قطر، پاکستان و ترکیه برای ممانعت از حمله به جمهوری اسلامی تلاش کرده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
