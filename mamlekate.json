    {
      "id": 103727,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D9%85%D8%AA%D9%86-%DB%8C%D8%A7%D8%AF%D8%AF%D8%A7%D8%B4%D8%AA-%D8%AA%D9%81%D8%A7%D9%87%D9%85-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D9%88-%D9%88%D8%A7%D8%B4%DB%8C%D9%86%DA%AF%D8%AA%D9%86-%D9%86%D9%81%D8%AA-%D8%AA%D8%AD%D8%B1%DB%8C%D9%85%E2%80%8C%D9%87%D8%A7-%D9%88-%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D9%87-%D9%87%D8%B3%D8%AA%D9%87%E2%80%8C%D8%A7%DB%8C-%D8%AF%D8%B1-%D9%85%D8%B1%DA%A9%D8%B2-%D8%AA%D9%88%D8%A7%D9%81%D9%82-06-17\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eمتن کامل یادداشت تفاهم جمهوری اسلامی و آمریکا به روایت سی‌ان‌ان\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eبا گذشت سه روز از امضای آنلاین یادداشت تفاهم تهران و واشینگتن، محرمانه ماندن سند انتقادهایی را درباره ماهیت آن و دامنه امتیازهای پیش‌بینی‌شده برای تهران برانگیخته است. گزارش‌های غیررسمی چارچوبی حاوی ۱۴ ماده درباره آتش‌بس، فروش نفت، وضعیت تحریم‌ها و برنامه هسته‌ای ترسیم می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%A8%D9%84%D9%88%D9%85%D8%A8%D8%B1%DA%AF-%D8%B3%D9%86%D8%AF-%DB%B1%DB%B4%D9%85%D8%A7%D8%AF%D9%87%E2%80%8C%D8%A7%DB%8C-%D8%AA%D9%81%D8%A7%D9%87%D9%85%E2%80%8C-%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7-%D9%88-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D8%B1%D8%A7-%D9%85%D9%86%D8%AA%D8%B4%D8%B1-%DA%A9%D8%B1%D8%AF-06-17\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eبلومبرگ «سند ۱۴ماده‌ای تفاهم‌» آمریکا و ایران را منتشر کرد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eخبرگزاری بلومبرگ متنی را منتشر کرده که به نوشته این شبکه خبری، «سند ۱۴ ماده‌ای تفاهم‌نامه» میان ایران و آمریکا است. هنوز مفاد این تفاهم‌نامه رسما منتشر نشده است. قرار است که این تفاهم‌نامه در سوئیس به امضای طرفین برسد.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%AF%D9%88%D9%86%D8%A7%D9%84%D8%AF-%D8%AA%D8%B1%D8%A7%D9%85%D9%BE-%D8%B1%DA%98%DB%8C%D9%85-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D8%B3%D9%84%D8%A7%D8%AD-%D9%87%D8%B3%D8%AA%D9%87%E2%80%8C%D8%A7%DB%8C-%D9%86%D8%AE%D9%88%D8%A7%D9%87%D8%AF-%D8%AF%D8%A7%D8%B4%D8%AA-%D9%88-%D8%AA%D9%86%DA%AF%D9%87-%D9%87%D8%B1%D9%85%D8%B2-%D9%81%D9%88%D8%B1%D8%A7-%D8%A8%D8%A7%D8%B2-%D8%AE%D9%88%D8%A7%D9%87%D8%AF-%D8%B4%D8%AF-06-17\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eدونالد ترامپ: رژیم ایران سلاح هسته‌ای نخواهد داشت و تنگه هرمز فوراً باز خواهد شد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ در مورد شرکت در اجلاس گروه هفت در فرانسه نوشت: «این سفر، یک موفقیت بزرگ بود اما عمدتاً چیزی که مردم می‌خواستند درباره‌اش صحبت کنند این بود که رژیم ایران سلاح هسته‌ای نخواهد داشت و تنگه هرمز فوراً باز خواهد شد!»\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%A7%D9%85%D8%A7%D8%B1%D8%A7%D8%AA-%D9%85%DB%8C%E2%80%8C%DA%AF%D9%88%DB%8C%D8%AF-%D9%88%D8%A7%D8%A8%D8%B3%D8%AA%DA%AF%DB%8C-%D8%A8%D9%87-%D8%AA%D9%86%DA%AF%D9%87-%D9%87%D8%B1%D9%85%D8%B2-%D8%B1%D8%A7-%D8%A8%D9%87-%D8%B5%D9%81%D8%B1-%E2%80%8C%D9%85%DB%8C%E2%80%8C%D8%B1%D8%B3%D8%A7%D9%86%D8%AF-06-17\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eامارات می‌گوید وابستگی به تنگه هرمز را به «صفر» ‌می‌رساند\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eامارات متحده عربی می‌گوید در نظر دارد وابستگی تجاری خود به تنگه هرمز را به «صفر» برساند. این کشور پیشتر خط لوله حبشان-‌فجیره با ظرفیت انتقال روزانه ۱.۹ میلیون بشکه نفت را برای دور زدن تنگه هرمز راه‌اندازی کرده بود و اخیراً توسعه خط لوله‌ جدیدی به همان ظرفیت را شتاب بخشیده است.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%AC%DB%8C%E2%80%8C%D8%AF%DB%8C-%D9%88%D9%86%D8%B3-%D9%85%D8%AA%D9%86-%D8%AA%D9%81%D8%A7%D9%87%D9%85%E2%80%8C%D9%86%D8%A7%D9%85%D9%87-%D8%AD%D8%AF%D8%A7%DA%A9%D8%AB%D8%B1-%D8%AA%D8%A7-%D8%AC%D9%85%D8%B9%D9%87-%D9%85%D9%86%D8%AA%D8%B4%D8%B1-%D8%AE%D9%88%D8%A7%D9%87%D8%AF-%D8%B4%D8%AF-06-17\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eجی‌دی ونس: متن تفاهم‌نامه حداکثر تا جمعه منتشر خواهد شد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eمعاون رئیس جمهوری آمریکا می‌گوید که متن تفاهم‌نامه‌ آمریکا و جمهوری اسلامی تا روز جمعه منتشر خواهد شد و توافق مورد نظر برای مردم آمریکا بسیار خوب خواهد بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
