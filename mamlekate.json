    {
      "id": 103895,
      "message": "\u003ctg-emoji emoji-id=\"5938550593260887559\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8E88.png\u0026#39;)\"\u003e\u003cb\u003e🎈\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بیژن مرتضوی، خواننده، آهنگساز و نوازنده سرشناس ویولون ایرانی مقیم آمریکا، در بین دو نیمه‌ رقابت فینال جام جهانی ۲۰۲۶ به روی صحنه خواهد رفت.\u003cbr/\u003e\u003cbr/\u003eبیژن مرتضوی، با بازنشر سه پیام در روایتگر اینستاگرم، خبرها درباره حضور خود در فینال جام جهانی را تائید کرده است.\u003cbr/\u003e\u003cbr/\u003eبه گزارش بیلبورد «این اجرای ۱۱ دقیقه‌ای در تاریخ ۱۹ ژوئیه (۲۸ تیرماه) در ورزشگاه مت‌لایف نیویورک/نیوجرسی برگزار می‌شود و چهره‌های مطرحی از جمله جاستین بیبر، شکیرا، مدونا و گروه بی‌تی‌اس در آن حضور خواهند داشت.\u003cbr/\u003e\u003cbr/\u003eکریس مارتین (خواننده نامدار گروه کلدپلی) مدیریت و کارگردانی هنری این اجرای ۱۱ دقیقه‌ای در بین دو نیمه فینال جام جهانی ۲۰۲۶ را بر عهده دارد و گفته می‌شود بیژن مرتضوی یکی از آثار بی‌کلام‌اش را به شکل گروهی و البته سولو نوازی ویولون معروف سفیدش، اجرا خواهد کرد.»\u003cbr/\u003e\u003ca href=\"https://x.com/indypersian/status/2076898985659228292\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eindypersian\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5958780095383477723\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29AA1.png\u0026#39;)\"\u003e\u003cb\u003e⚡️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ca href=\"https://telegra.ph/%D8%B9%D8%A8%D8%AF%D8%A7%D9%84%D8%B1%D8%B3%D9%88%D9%84-%D9%85%D8%B1%D8%AA%D8%B6%D9%88%DB%8C-%D8%A7%D8%B2-%D8%B4%DA%A9%D9%86%D8%AC%D9%87-%DA%AF%D8%B3%D8%AA%D8%B1%D8%AF%D9%87-%D8%A8%D8%A7%D8%B2%D8%AF%D8%A7%D8%B4%D8%AA%E2%80%8C%D8%B4%D8%AF%DA%AF%D8%A7%D9%86-%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA-%D8%AF%DB%8C-%D8%AF%D8%B1-%D8%A7%D8%B5%D9%81%D9%87%D8%A7%D9%86-%D8%AE%D8%A8%D8%B1-%D8%AF%D8%A7%D8%AF-06-07\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e مرتضوی از شکنجه گسترده بازداشت‌شدگان اعتراضات دی در اصفهان خبر داد\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eعبدالرسول مرتضوی، زندانی سیاسی محبوس در زندان مرکزی اصفهان، در پیامی تلفنی از شکنجه و بدرفتاری با صدها تن از بازداشت‌شدگان اعتراضات دی ۱۴۰۴ در بازداشتگاه‌های امنیتی و زندان مرکزی اصفهان خبر داده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
