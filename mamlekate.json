ate/103733\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5958758865360133207\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29D8C.png\u0026#39;)\"\u003e\u003cb\u003e❌\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://telegra.ph/%D9%88%D8%A7%DA%A9%D9%86%D8%B4%E2%80%8C%D9%87%D8%A7-%D8%A8%D9%87-%D8%B8%D8%B1%DB%8C%D9%81-%D8%AF%D8%B1%D8%A8%D8%A7%D8%B1%D9%87-%D9%BE%DB%8C%D8%B4%D9%86%D9%87%D8%A7%D8%AF%D8%B4-%D8%A8%D8%B1%D8%A7%DB%8C-%D9%BE%D8%A7%DB%8C%D8%A7%D9%86-%D8%AC%D9%86%DA%AF-%D8%B3%D9%87-%D8%B1%D9%88%D8%B2-%D9%81%D8%B1%D8%B5%D8%AA-%D8%AF%D8%A7%D8%B1%D8%AF-%D8%A8%DA%AF%D9%88%DB%8C%D8%AF-%D8%BA%D9%84%D8%B7-%DA%A9%D8%B1%D8%AF%D9%85-04-04\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eواکنش‌ها به ظریف درباره پیشنهادش برای پایان دادن به جنگ؛ «سه روز فرصت دارد بگوید غلط کردم»\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eمقاله محمدجواد ظریف، وزیر خارجه پیشین، در مجله آمریکایی فارین افرز که در آن پیشنهاد پایان دادن به جنگ در ازای پذیرش برخی از محدودیت ها در برنامه اتمی را داده، با واکنش‌های موافق و مخالف رو به رو شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
