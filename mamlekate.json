    {
      "id": 103719,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D9%85%D8%AC%DB%8C%D8%AF%D8%B1%D8%B6%D8%A7-%D8%B1%D9%87%D9%86%D9%88%D8%B1%D8%AF-%DA%A9%D8%B4%D8%AA%DB%8C%E2%80%8C%DA%AF%DB%8C%D8%B1-%D9%88-%D9%85%DB%8C%D9%88%D9%87%E2%80%8C%D9%81%D8%B1%D9%88%D8%B4-%DB%B2%DB%B3-%D8%B3%D8%A7%D9%84%D9%87%E2%80%8C%D8%A7%DB%8C-%DA%A9%D9%87-%D9%86%D9%85%D8%A7%D8%AF-%D9%85%D9%84%DB%8C-%D8%B4%D8%AF-06-16\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eمجیدرضا رهنورد؛ کشتی‌گیر و میوه‌فروش ۲۳ ساله‌ای که نماد ملی شد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eبیست‌وششم خرداد، زادروز مجیدرضا رهنورد، کشتی‌گیر جوان ایرانی است که در جریان اعتراض‌های سراسری سال ۱۴۰۱ بازداشت و در ۲۳ سالگی اعدام شد. این روز نزد ایرانیان ملی‌گرا به‌عنوان «روز ملی پرچم شیر و خورشید» شناخته می‌شود که با خالکوبی نماد شیر و خورشید روی دست مجیدرضا رهنورد ارتباط دارد.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%DB%B2--%D9%86%DB%8C%D9%88%D8%B2%DB%8C%D9%84%D9%86%D8%AF-%DB%B2-%D8%A7%D9%87%D8%AA%D8%B2%D8%A7%D8%B2-%D9%BE%D8%B1%DA%86%D9%85-%D8%B4%DB%8C%D8%B1-%D9%88-%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF-%D8%AF%D8%B1-%D8%AF%D8%B3%D8%AA-%D8%AA%D9%85%D8%A7%D8%B4%D8%A7%DA%AF%D8%B1%D8%A7%D9%86-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86%DB%8C-06-16\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eایران ۲- نیوزیلند ۲؛ اهتزاز پرچم شیر و خورشید در دست تماشاگران ایرانی\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eتیم فوتبال ایران در اولین بازی خود در جام جهانی مقابل نیوزیلند به میدان رفت و بازی با نتیجه دو - دو مساوی پایان یافت. هم‌زمان با جود مخالفت‌های فیفا و دادگاهی در لس‌آنجلس بسیاری از ایرانیان حاضر در ورزشگاه لس‌آنجلس پرچم‌های شیر و خورشید در دست یا بر تن داشتند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%A7%D8%AE%D8%B1%D8%A7%D8%AC-%D8%AF%D9%88-%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C-%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87-%D8%AA%D9%87%D8%B1%D8%A7%D9%86-%D8%A8%D9%87-%D8%A7%D8%AA%D9%87%D8%A7%D9%85-%D8%A8%D8%B1%D8%A7%D9%81%D8%B1%D8%A7%D8%B4%D8%AA%D9%86-%D9%BE%D8%B1%DA%86%D9%85-%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF-%D9%88-%D8%A2%D8%AA%D8%B4-%D8%B2%D8%AF%D9%86-%D9%BE%D8%B1%DA%86%D9%85-%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C-%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C-06-14\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eاخراج دو دانشجوی دانشگاه تهران به اتهام برافراشتن پرچم شیروخورشید و آتش زدن پرچم جمهوری اسلامی\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eدر ادامه موج فشار بر فعالان دانشجویی در دانشگاه‌های کشور، دو دانشجوی دانشگاه تهران به اتهام برافراشتن پرچم شیروخورشید نشان در این دانشگاه و آتش زدن پرچم جمهوری اسلامی اخراج شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
