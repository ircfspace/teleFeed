ت مذاکرات و آغاز جنگی تازه همچنان مبهم است\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eمحسن رضایی، دبیر شورای عالی‌امنیت ملی جمهوری اسلامی دوشنبه ۱۱ آبان تلفنی با ولادیمیر پوتین، رییس‌جمهوری روسیه، گفت‌وگو کرد و هم‌زمان علی باقری کنی،‌ معاون او، در پکن با وزیر امور خارجه چین دیدار کرد. هم‌زمان با سفر باقری کنی، مشاور امنیت ملی عربستان سعودی نیز به پکن رفته است.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5983232280502477270\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://telegra.ph/%D8%AA%D8%B1%D8%A7%D9%85%D9%BE-%D8%AF%D8%B1-%D8%A2%D8%B3%D8%AA%D8%A7%D9%86%D9%87-%D8%A7%D9%86%D8%AA%D8%AE%D8%A7%D8%A8%D8%A7%D8%AA-%D9%85%DB%8C%D8%A7%D9%86%E2%80%8C%D8%AF%D9%88%D8%B1%D9%87%E2%80%8C%D8%A7%DB%8C-%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7-%D8%AA%D9%88%D8%A7%D9%81%D9%82-%D8%A8%D8%A7-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D9%85%D9%85%DA%A9%D9%86-%D8%A7%D8%B3%D8%AA-%D8%AD%D8%A7%D8%B5%D9%84-%D8%B4%D9%88%D8%AF-11-02\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eترامپ در آستانه انتخابات میان‌دوره‌ای آمریکا: توافق با ایران ممکن است حاصل شود\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eدونالد ترامپ، رئیس‌جمهور آمریکا، روز دوشنبه ۱۱ آبان اعلام کرد جمهوری اسلامی خواهان دستیابی به توافقی برای پایان دادن به جنگ آمریکا علیه ایران است و چنین توافقی «ممکن است حاصل شود». \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
