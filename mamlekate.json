get=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eفایننشال تایمز از توافق روسیه با ایران برای فروش ۹۰ پرتابگر موشک هدایت‌شونده خبر داد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eبر اساس برنامهٔ تولید یک شرکت بزرگ صنایع دفاعی روسیه در سال‌های ۲۰۲۴ و ۲۰۲۵، سفارش صادرات ۹۰ پرتابگر موشک قابل نصب روی بالگرد برای مشتری‌ای ثبت شده که با رمز «K-10» معرفی شده است. \u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5983232280502477270\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939D.png\u0026#39;)\"\u003e\u003cb\u003e📝\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ca href=\"https://telegra.ph/%D8%B1%D9%88%D8%B3%DB%8C%D9%87-%D8%A8%D9%87-%D8%B4%D9%87%D8%B1%D9%88%D9%86%D8%AF%D8%A7%D9%86-%D8%AE%D9%88%D8%AF-%D8%AF%D8%B1%D8%A8%D8%A7%D8%B1%D9%87-%D8%B3%D9%81%D8%B1-%D8%A8%D9%87-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86-%D9%87%D8%B4%D8%AF%D8%A7%D8%B1-%D8%AF%D8%A7%D8%AF-%D9%86%DA%AF%D8%B1%D8%A7%D9%86%DB%8C-%D8%A7%D8%B2-%D8%AA%D8%B4%D8%AF%DB%8C%D8%AF-%D8%AF%D9%88%D8%A8%D8%A7%D8%B1%D9%87-%D8%AF%D8%B1%DA%AF%DB%8C%D8%B1%DB%8C%E2%80%8C%D9%87%D8%A7-11-05\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eروسیه به شهروندان خود درباره سفر به ایران هشدار داد؛ نگرانی از تشدید دوباره درگیری‌ها\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت خارجه روسیه با اشاره به تداوم خطر تشدید تنش‌های نظامی پیرامون ایران، بار دیگر از شهروندان خود خواست تا اطلاع ثانوی از سفر به این کشور خودداری کنند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8C90.png\u0026#39;)\"\u003e\u003cb\u003e🌐\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://telegra.ph/%D8%AA%D8%AD%D9%84%DB%8C%D9%84-%D8%B1%D9%88%DB%8C%D8%AA%D8%B1%D8%B2-%D9%86%D8%B4%D8%A7%D9%86-%D9%85%DB%8C%E2%