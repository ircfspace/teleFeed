    {
      "id": 105257,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5987768770989399555\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939E.png\u0026#39;)\"\u003e\u003cb\u003e📞\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e الو! بنزین وضعش خرابه!\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eما ۳تا ماشین داریم و مصرفمون کمه. ۱کارت۱۵۰۰و۳۰۰۰میدن که بابام میزنه. اون ۲کارت هرکدوم ۱۱۰تا ۱۰تومنی.\u003cbr/\u003e\u003cbr/\u003eدیروز رفتم پمپ بنزین، ۵نفر وایساده بودن خواهش و تمنا که ۱۰لیتر بگیرن ازم. توی دهاتمون. به یکیشون که پراید بود ۱گفتم بیا ۱باک بزن ۳۱لیتر زد. انقدر خوشحال شد ک نگو.\u003cbr/\u003e\u003cbr/\u003eبرگشتم شیراز همه پمپ بنزینها صف بود. ینی همین ۱۰تومنیش رو هم نمیدن به مردم بزنن.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5987768770989399555\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939E.png\u0026#39;)\"\u003e\u003cb\u003e📞\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شیراز که صف ها به شدت طولانی و چندین ساعته شده مجبور شدیم بریم شهرستان خان زنیان اونم گفته برای استفاده از سهمیه از ساعت ۶ صبح تا ۸ صبح بیایی برات میزنم اونم توی صف به شدت طولانی\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5987768770989399555\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939E.png\u0026#39;)\"\u003e\u003cb\u003e📞\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003eالو توی یزد کارت آزاد رو از اول ماه جمع کردن. یعنی اگر با ماشین بری و بنزین آزاد بخوای بزنی اصلا بهت بنزین نمیدن و حتما باید کارت سوخت داشته باشی. سهمیه بنزین کارت سوختت هم تموم بشه دیگه کلا بنزین نداری\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5987768770989399555\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F939E.png\u0026#39;)\"\u003e\u003cb\u003e📞\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003eمن حدودا ماهی ۲۵۰ لیتر بنزین مصرف می‌کنم، به خاطر دکتر و درمان مجبورم هفته‌ای یکبار تا مرکز استان برم و ۲۶۰ کیلومتر رفت و برگشتم میشه، توی شهر خودمون هم باید هر روز برم سر کار، هزینه اسنپ هم اینقدر زیاد شده که درامدم کفاف کرایه روزانه ۵۰۰ هزار تومن رو نمیده، من چه خاکی باید سرم کنم؟؟؟ باید خر و قاطر سوار بشیم از این به بعد؟\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"5922792164978336476\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F928E.png\u0026#39;)\"\u003e\u003cb\u003e💎\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e نزدیک به سالگرد \u003ca href=\"?q=%23%D8%A2%D8%A8%D8%A7%D9%86%DB%B9%DB%B8\"\u003e#آبان۹۸\u003c/a\u003e و بیاد سردار \u003ca href=\"?q=%23%D9%85%D8%AC%DB%8C%D8%AF_%D9%87%D8%A7%D8%B4%D9%85%DB%8C\"\u003e#مجید_هاشمی\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D9%88%DB%8C%D8%A7_%D8%A8%D8%AE%D8%AA%DB%8C%D8%A7%D8%B1%DB%8C\"\u003e#پویا_بختیاری\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D8%B3%D9%86_%D9%85%D8%AD%D9%85%D8%AF%D9%BE%D9%88%D8%B1\"\u003e#محسن_محمدپور\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D9%84%D9%86%D8%A7%D8%B2_%D8%B5%D9%85%D8%B5%D8%A7%D9%85%DB%8C\"\u003e#گلناز_صمصامی\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/mamlekate\" target=\"_blank\"\u003e@mamlekate\u003c/a\u003e",
