    },
    {
      "id": 538094,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003eترامپ برای سخنرانی ویژه‌‌ای که تا یکی دوساعت دیگر دارد، در شبکه اجتماعی نوشته: به همه پیشنهاد می کنم امشب تلویزیون رو روشن کنید.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
