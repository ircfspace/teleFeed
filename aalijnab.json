    {
      "id": 555039,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽\u003c/b\u003e\u003c/i\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8F86.png\u0026#39;)\"\u003e\u003cb\u003e🏆\u003c/b\u003e\u003c/i\u003e \u003cb\u003e۶۴ صنف، یک جام، یک قهرمان؛       کتاب‌فروشان فاتح فوتبال اصناف تهران شدند!\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e شور و هیجان گل کوچک در هفته تربیت بدنی ؛ جایی که ۶۴ تیم از اصناف پایتخت در نخستین دوره مسابقات \u003cb\u003e«قهرمان شهر اصناف پایتخت»\u003c/b\u003e، به همت سازمان ورزش شهرداری تهران، پنجشنبه ۳۰ مهرماه در محوطه تاریخی عمارت بلدیه به رقابت پرداختند.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA587.png\u0026#39;)\"\u003e\u003cb\u003e🥇\u003c/b\u003e\u003c/i\u003e قهرمان: کتاب‌فروشان\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA588.png\u0026#39;)\"\u003e\u003cb\u003e🥈\u003c/b\u003e\u003c/i\u003e نایب‌قهرمان: فروشندگان مواد پروتئینی\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09FA589.png\u0026#39;)\"\u003e\u003cb\u003e🥉\u003c/b\u003e\u003c/i\u003e مقام سوم: فروشندگان بستنى و آبمیوه‌\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8F85.png\u0026#39;)\"\u003e\u003cb\u003e🏅\u003c/b\u003e\u003c/i\u003e تیم اخلاق: پارچه‌فروشان\u003cbr/\u003e\u003cbr/\u003eاین رویداد با حضور حسین اوجاقی، رئیس سازمان ورزش شهرداری تهران، پیشکسوتان فوتبال کشور، حسن روشن و بهروز رهبری‌فر و جمعی از خانواده‌های معزز شهدا همراه بود.\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9186.png\u0026#39;)\"\u003e\u003cb\u003e👆\u003c/b\u003e\u003c/i\u003eویدئو را ببینید و بگویید: \u003cb\u003eقهرمان دوره بعد کدام صنف خواهد بود؟\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D9%81%D8%AA%D9%87_%D8%AA%D8%B1%D8%A8%DB%8C%D8%AA_%D8%A8%D8%AF%D9%86%DB%8C\"\u003e#هفته_تربیت_بدنی\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D9%87%D8%B1%D9%85%D8%A7%D9%86_%D8%B4%D9%87%D8%B1_%D8%A7%D8%B5%D9%86%D8%A7%D9%81_%D9%BE%D8%A7%DB%8C%D8%AA%D8%AE%D8%AA\"\u003e#قهرمان_شهر_اصناف_پایتخت\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D9%84_%DA%A9%D9%88%DA%86%DA%A9\"\u003e#گل_کوچک\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%A7%D8%B2%D9%85%D8%A7%D9%86_%D9%88%D8%B1%D8%B2%D8%B4_%D8%B4%D9%87%D8%B1%D8%AF%D8%A7%D8%B1%DB%8C_%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#سازمان_ورزش_شهرداری_تهران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B5%D9%86%D8%A7%D9%81_%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#اصناف_تهران\u003c/a\u003e \u003ca href=\"?q=%23%D9%88%D8%B1%D8%B2%D8%B4_%D8%B4%D9%87%D8%B1%D9%88%D9%86%D8%AF%DB%8C\"\u003e#ورزش_شهروندی\u003c/a\u003e",
