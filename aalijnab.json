    },
    {
      "id": 554686,
      "message": "بازار باشه\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9882.png\u0026#39;)\"\u003e\u003cb\u003e😂\u003c/b\u003e\u003c/i\u003e\u003cbr/\u003e\u003cbr/\u003eپاریس شده بازار خلازیر\u003cbr/\u003eتو فرانسه کالاهای لاکچری سرقتی از فروشگاه‌های فرانسه در جریان اعتراضات رو دارن به‌صورت علنی گوشه پیاده روها به مردم میفروشن، از برندهای سلین تا لویی ویتون!\u003cbr/\u003e\u003cbr/\u003eAmino\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
