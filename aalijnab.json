    {
      "id": 555558,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eادعای وال‌استریت ژورنال:\u003cbr/\u003e\u003cbr/\u003eنامه ونس به دبیر شورای عالی امنیت ملی ایران\u003cbr/\u003e\u003cbr/\u003e جی‌دی‌ونس، معاون رئیس‌جمهور آمریکا، در تلاشی برای ازسرگیری مذاکرات صلح، نامه‌ای به دبیر شورای عالی امنیت ملی ایران نوشته است.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-10-28T21:26:01Z",
