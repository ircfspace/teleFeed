    {
      "id": 533242,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eتخفیف ۹۰ درصدی طرح ترافیک به خودروهای برقی\u003cbr/\u003e\u003cbr/\u003eمعاون سازمان حمل و نقل و ترافیک شهرداری تهران:\u003cbr/\u003e\u003cbr/\u003eخودروهای برقی و هیبریدی در سال ۱۴۰۵، به ترتیب از تخفیفات ۹۵ و ۹۰ درصدی عوارض طرح ترافیک برخوردارند.\u003cbr/\u003e\u003cbr/\u003eلازمه برقراری این تسهیلات، مراجعه مالکین خودروهای یادشده به دفاتر خدمات الکترونیک شهر و اخذ تأییدیه‌ های لازم است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-05-10T07:26:33Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 4880,
      "forwards": 0,
