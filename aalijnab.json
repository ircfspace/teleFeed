    {
      "id": 550278,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e فوری\u003cbr/\u003e\u003cbr/\u003e هم‌اکنون حملات سنگین خدا به مواضعی از آسمانِ تهران شروع شد.\u003cbr/\u003e\u003cbr/\u003eتو آسمون تهران امشب مانور صاعقه در حال برگزاریه جهت آماده سازی ذهنی تهرانی‌ها برای درگیری های بعدی!\u003cbr/\u003e\u003cbr/\u003e‌ \u003cbr/\u003eAli\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-09-08T19:52:18Z",
