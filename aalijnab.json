    },
    {
      "id": 550280,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eهشدار فوری سپاه\u003cbr/\u003e\u003cbr/\u003e با توجه به شرارت های ارتش امریکا در هدف قرار دادن چندفروند از نفتکش های ایران\u003cbr/\u003e به تمامی خدمه نفتکش‌ها در محدود اسکله های کویت و بحرین که میزبان این نیروها و شریک در شرارت های آنان هستند اخطار می‌دهیم شناور خود را چه در لنگرگاه و چه در اسکله ها سریعا ترک نمایند چرا که مورد هدف  قرار خواهند گرفت. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
