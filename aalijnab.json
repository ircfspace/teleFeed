      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eمنابع عربی از شنیده شدن صدای انفجار از تنگه هرمز خبر می‌ دهند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e \u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
