    },
    {
      "id": 555411,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eطرح حذف کالابرگ ۳ دهک بالای درآمدی روی میز دولت قرار دارد\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eبراساس طرح جدید،حداقل ۵۰ درصد مردم استان تهران و ۳۰ درصد مردم کل کشور از لیست دریافت کالابرگ حذف می‌شوند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e \u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-10-27T05:50:00Z",
