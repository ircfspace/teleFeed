    {
      "id": 546102,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eبه علت اقدامات تجاوزکارانه ایالات متحده، تردد از تنگه‌ی هرمز امکان‌پذیر نمی‌باشد\u003cbr/\u003e\u003cbr/\u003eنهاد مدیریت آبراهه خلیج فارس با توجه به سوالات مکرر متقاضیان، مجددا به اطلاع می‌رساند:\u003cbr/\u003eبه علت تداوم اقدامات تجاوزکارانه نیروهای نظامی ایالات متحده در منطقه، تردد از تنگه هرمز امکان‌پذیر نمی‌باشد.\u003cbr/\u003e\u003cbr/\u003eبه محض برقراری ثبات و آرامش، کلیه درخواست‌ها بر اساس ترتیب و زمان‌بندی بررسی و مجوزها به مرور صادر خواهند شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
