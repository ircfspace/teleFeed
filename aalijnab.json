    {
      "id": 537245,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eترامپ به ان‌بی‌سی نیوز: لزومی ندارد  لبنان در توافق کوتاه‌مدت ایران گنجانده شود\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-07T13:25:07Z",
