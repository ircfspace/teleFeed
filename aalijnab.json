39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eمهمترین ناکامی چینی‌ها \u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eچین، اوپک جدید؟ دروغ یا واقعیت\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29C85.png\u0026#39;)\"\u003e\u003cb\u003e✅\u003c/b\u003e\u003c/i\u003eمدرسه سرمایه‌گذاری\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eقدرت جادویی متنوع‌سازی\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eچطور تشنه سودهای بزرگ می‌شوی؟\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eبا ۵۰۰ میلیون تومان چه بخریم\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eپیش‌بینی‌های جدید خبرگان بازار\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eپول تازه به کدام نمادها رفت؟\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E297BB.png\u0026#39;)\"\u003e\u003cb\u003e◻️\u003c/b\u003e\u003c/i\u003eفرصت‌های سرمایه‌گذاری این هفته\u003cbr/\u003e\u003cbr/\u003e\u003ctg-emoji emoji-id=\"6048535802244243604\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9497.png\u0026#39;)\"\u003e\u003cb\u003e🔗\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e مج