    {
      "id": 549609,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eمرگ تلخ ۴عضو یک خانواده بر اثر مسمومیت با گاز مونوکسیدکربن شب گذشته در سراب؛\u003cbr/\u003e\u003cbr/\u003e قربانیان مردی ۴۵ ساله، زنی ۳۸ ساله و دو کودک ۹ و ۱۲ ساله بودند.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
