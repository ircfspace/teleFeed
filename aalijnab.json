    {
      "id": 545762,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BB.png\u0026#39;)\"\u003e\u003cb\u003e🔻\u003c/b\u003e\u003c/i\u003eسخنگوی دولت: فرودگاه بوشهر از مدار خدمت‌رسانی کاملاً خارج است\u003cbr/\u003e\u003cbr/\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B9.png\u0026#39;)\"\u003e\u003cb\u003e🔹\u003c/b\u003e\u003c/i\u003eفرودگاه بوشهر از مدار خدمت‌رسانی کاملاً خارج است و هواپیمایی که به‌تازگی خریداری شده بود مورد اصابت موشک دشمن قرار گرفت و تنها قسمتی از دم آن باقی مانده است.\u003cbr/\u003e\u003cbr/\u003eمهاجرانی:\u003cbr/\u003eیک‌چهارم ظرفیت تولید گاز کشور تو جنگ ۴۰روز از دست رفته\u003cbr/\u003e\u003cbr/\u003e\u003cblockquote expandable=\"\"\u003eمرکز هواشناسی بوشهر چیزی ازش باقی نمونده \u003cbr/\u003e\u003cbr/\u003eکسب‌وکار های گردشگری به شدت آسیب دیدند \u003cbr/\u003e\u003cbr/\u003eفرودگاه بوشهر به هیچ عنوان قابل استفاده نیست و باید از اول ساخته بشه \u003cbr/\u003e\u003cbr/\u003eبرج مراقبت دریایی چابهار فرو ریخت\u003cbr/\u003e\u003cbr/\u003e۱۲ دستگاه پل و ۲ دستگاه تونل آسیب دیدند\u003cbr/\u003e\u003cbr/\u003eحمله به ایستگاه بزرگ راه آهن بندرعباس\u003cbr/\u003e\u003cbr/\u003eآسیب فرودگاهی به فرودگاه‌های ایرانشهر، سمنان و بندرعباس\u003cbr/\u003e﻿\u003c/blockquote\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-07-28T08:45:04Z",
      "edited": false,
      "edit_date": "0001-01-01T00:00:00Z",
      "views": 21000,
      "forwards": 0,
      "replies": 0,
