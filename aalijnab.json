    },
    {
      "id": 535031,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003e مقام ایرانی به الجزیره :\u003cbr/\u003e\u003cbr/\u003eایران از طریق میانجیگری پاکستان به «یادداشت تفاهم» دست یافته و اکنون در انتظار پاسخ آمریکا است.\u003cbr/\u003e\u003cbr/\u003eقرار بود فرمانده ارتش پاکستان تفاهم نامه را در تهران اعلام کند، اما برای هماهنگی با واشنگتن از ایران رفت\u003cbr/\u003e\u003cbr/\u003eاین یادداشت تفاهم شامل پایان جنگ، لغو محاصره، باز کردن تنگه هرمز و خروج نیروهای آمریکایی از منطقه جنگی است.\u003cbr/\u003e\u003cbr/\u003eاین یادداشت تفاهم شامل مسائل هسته‌ای نمی‌شود زیرا این مسائل پیچیده هستند و به زمان کافی برای مذاکره نیاز دارند.\u003cbr/\u003e\u003cbr/\u003e30 روز پس از توافق، می‌توان درهای مذاکرات هسته‌ای را باز کرد.\u003cbr/\u003e\u003cbr/\u003eاین مقام افزود که قطر نقش عمده‌ای در تدوین این یادداشت تفاهم و تسهیل ارتباط بین میانجی‌ها و آمریکا ایفا کرده است،\u003cbr/\u003e ایران نمی‌تواند امتیازاتی بیشتر از آنچه در یادداشت تفاهم آمده است، بدهد.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
