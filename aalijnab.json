    {
      "id": 537381,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B4.png\u0026#39;)\"\u003e\u003cb\u003e🔴\u003c/b\u003e\u003c/i\u003eترامپ به اکسیوس:\u003cbr/\u003eهر کدام از طرفین امروز تفریح خودشان را داشتند \u003cbr/\u003eمن فکر میکنم اسرائیل به اندازه کافی پاسخ داده است \u003cbr/\u003e\u003cbr/\u003eما میتوانیم بعداز 3000 سال به صلح دستیابیم\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Aalijnab\" target=\"_blank\"\u003e@Aalijnab\u003c/a\u003e",
      "date": "2026-06-07T20:19:46Z",
