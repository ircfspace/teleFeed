    {
      "id": 4561,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شیراز؛ چند بـ.ـسیجی در اثر انفجار مهمات عمل‌نکرده مصدوم شدند\u003cbr/\u003e\u003cbr/\u003eمنابع غیررسمی روز دوشنبه ۲۱ اردبهشت ۱۴۰۵ گزارش دادند در اثر انفجار مهمات عملکرد نکرده در یک پایگاه بـ.ـسیج در شیراز تعدادی از نیروها صدمه دیده‌اند. بعد از جنگ ۴۰ روزه دستکم ۲۰ نفر از نیروهای نظامی در اثر انفجار بمب‌های عمل‌نکرده کشته و زخمی شدند.\u003cbr/\u003eعملیات خنثی‌سازی مهمات عمل‌نکرده به دلیل فقدان تجهیزات و نیروی متخصص کافی به کُندی و پر تلفات پیش می‌رود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%B3%DB%8C%D8%AC%DB%8C\"\u003e#بسیجی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%DB%8C%D8%B1%D8%A7%D8%B2\"\u003e#شیراز\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
