    {
      "id": 4938,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e سفر همتی به قطر در راستای پروندۀ پول‌های بلوکه‌شدۀ رژیم\u003cbr/\u003e\u003cbr/\u003eخبرگزاری‎‌های داخلی ایران، از سفر عبدالناصر همتی، رئیس کل بانک مرکزی جمهوری اسلامی، به قطر خبر دادند. بنا بر گزارش‌ها یکی از محورهای این سفر، پیگیری آزادسازی منابع ارزی جمهوری اسلامی است.\u003cbr/\u003eقطر از سال ۲۰۲۳ و پس از انتقال حدود شش میلیارد دلار از دارایی‌های بلوکه‌شده ایران در کرۀ جنوبی، به یکی از محورهای اصلی پروندۀ مالی تهران و واشینگتن تبدیل شد.\u003cbr/\u003eدر هفته‌های اخیر، همزمان با مذاکرات غیرمستقیم تهران و واشینگتن، موضوع آزادسازی دارایی‌های مسدودشدۀ جمهوری اسلامی مطرح شد.\u003cbr/\u003eبرخی از منابع خارجی گزارش دادند که آزادسازی بخشی از این منابع می‌تواند به پیشرفت مذاکرات و امنیت تنگۀ هرمز پیوند خورده باشد.\u003cbr/\u003eقطر اکنون علاوه بر نگهداری بخشی از منابع مالی بلوکه شدۀ جمهوری اسلامی، یکی از مسیرهای فعال میانجی‌گری میان تهران و واشینگتن به شمار می‌رود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
