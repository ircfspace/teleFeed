    {
      "id": 7430,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eجمهوری اسلامی به شبه‌نظامیان عراق دستور داده سلاح‌های خود را تحویل ندهند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://responsiblestatecraft.org/iran-backed-militias-in-iraq/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eوب‌سایت رسپانسیبل استیت‌کرفت در گزارشی نوشت \u003c/a\u003eهم‌زمان با تلاش دولت عراق برای خلع سلاح گروه‌های شبه‌نظامی تا ۳۰ سپتامبر، جمهوری اسلامی برای حفظ توان نظامی نیروهای وابسته به خود در این کشور وارد عمل شده است.\u003cbr/\u003eبراساس این گزارش، اسماعیل قاآنی، فرمانده نیروی قدس سپاه پاسداران، ۱۰ اوت در سفری اعلام‌نشده به بغداد، از فرماندهان گروه‌های شبه‌نظامی خواست سلاح‌های خود را حفظ کنند و آن‌ها را به دولت عراق تحویل ندهند. علی الزیدی، نخست‌وزیر عراق، از دیدار با قاآنی خودداری کرد.\u003cbr/\u003eهم‌زمان، محمدباقر قالیباف نیز در سفر به بغداد طرحی را برای مخفی‌کردن تسلیحات سنگین شبه‌نظامیان یا انتقال آن‌ها به ایران مطرح کرده است.\u003cbr/\u003eدر مقابل، تام باراک، نماینده ویژه آمریکا در امور عراق و سوریه، با حضور چهره‌های نزدیک به گروه‌های شبه‌نظامی در کابینه عراق مخالفت کرده است. براساس این گزارش، همین مخالفت‌ها باعث شده ۹وزارتخانه عراق، از جمله وزارتخانه‌های دفاع و کشور، همچنان بدون وزیر باقی بمانند.\u003cbr/\u003eاگرچه دو گروه عصائب اهل‌الحق و کتائب امام علی اعلام کرده‌اند سلاح‌هایشان را زیر نظر دولت قرار می‌دهند، گزارش‌ها نشان می‌دهد تسلیحات تحویل‌شده عمدتا فرسوده بوده و درباره سرنوشت پهپادها، موشک‌ها و دیگر تجهیزات سنگین، نظارت مستقلی وجود ندارد.\u003cbr/\u003eدر همین حال، کتائب حزب‌الله، جنبش نجبا و کتائب سیدالشهدا آشکارا با خلع سلاح مخالفت کرده‌اند.\u003cbr/\u003eرسپانسیبل استیت‌کرفت تأکید کرد سرنوشت مهلت ۳۰سپتامبر بیش از آنکه به تصمیم دولت عراق وابسته باشد، به تحولات جنگ میان آمریکا و جمهوری اسلامی بستگی دارد؛ زیرا خلع سلاح کامل این گروه‌ها مستلزم کنارگذاشتن حمایت تهران و رویارویی دولت عراق با بخشی از ائتلاف حاکم است؛ اقدامی که می‌تواند خطر جنگ داخلی را افزایش دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A7%D9%82\"\u003e#عراق\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AD%D8%B4%D8%AF%D8%A7%D9%84%D8%B4%D8%B9%D8%A8%DB%8C\"\u003e#حشدالشعبی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
