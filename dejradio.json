    {
      "id": 6977,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eهشدار آمریکا به شهروندانش درباره احتمال تشدید ناگهانی تنش‌ها در خاورمیانه\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eهمزمان با اوج‌گیری دوبارۀ تنش‌ها میان جمهوری اسلامی و آمریکا،سفارتخانه‌های ایالات متحده در اردن و عراق هشدارهای امنیتی تازه‌ای برای شهروندان آمریکایی صادر کردند.\u003cbr/\u003eسفارت آمریکا در اردن در پیامی در شبکۀ اجتماعی ایکس از شهروندان آمریکایی حاضر در خاورمیانه خواست احتیاط بیشتری به خرج دهند و خروج از منطقه را مدنظر قرار دهند.\u003cbr/\u003eدر این پیام آمده است که وضعیت خاورمیانه همچنان بی‌ثبات است و احتمال تشدید غیرمنتظرۀ تنش‌ها وجود دارد. سفارت آمریکا همچنین جمهوری اسلامی را حکومتی غیرقابل پیش‌بینی توصیف کرد و به حملات اخیر آن به کشورهای منطقه،بدون هشدار قبلی و گسترش حملات به اهدافی که پیش‌تر هدف قرار نگرفته بودند،از جمله مصر،اشاره کرد.\u003cbr/\u003eسفارت آمریکا تأکید کرد اینکه منافع یا کسب‌وکارهای آمریکایی تاکنون در یک کشور مشخص هدف قرار نگرفته‌اند،تضمینی برای امنیت آنها در آینده نیست.\u003cbr/\u003eهمزمان،سفارت آمریکا در عراق نیز با انتشار هشدار امنیتی از شهروندان این کشور خواست هوشیار بمانند و دستورالعمل‌های مقام‌های محلی را رعایت کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D8%B4%D8%AF%D8%A7%D8%B1\"\u003e#هشدار\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
