    {
      "id": 6918,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003eسنتکام:سپاه حق تعیین مسیر عبور کشتی‌ها از تنگۀ هرمز را ندارد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eفرماندهی مرکزی ایالات متحده،سنتکام،در واکنش به ادعای تازۀ سپاه پاسداران درباره کنترل مسیرهای کشتیرانی در تنگۀ هرمز \u003ca href=\"https://x.com/CENTCOM/status/2082489530322419822?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eاعلام کرد\u003c/a\u003e این آبراه یک گذرگاه بین‌المللی است و سپاه هیچ اختیاری برای تعیین مسیر حرکت کشتی‌های تجاری ندارد.\u003cbr/\u003eساعاتی پیش،مقام‌های جمهوری اسلامی ضمن رد پیشنهاد عمان برای مدیریت مشترک تنگۀ هرمز،ادعا کردند تهران باید کنترل کامل مسیر ورود کشتی‌ها و بخشی از مسیر خروج آنها را در اختیار داشته باشد. جمهوری اسلامی همچنین بر دریافت عوارض از کشتی‌های عبوری و الزام شناورها به استفاده از مسیرهای مورد تأیید سپاه تأکید کرده است.\u003cbr/\u003eسنتکام این ادعا را رد کرد و گفت سپاه پس از تهدید و تلاش برای حمله به کشتی‌های تجاری و دریانوردان غیرنظامی،همچنان مدعی است شناورهای بین‌المللی باید تنها از مسیرهای تعیین‌شده از سوی این نهاد نظامی عبور کنند.\u003cbr/\u003eفرماندهی مرکزی آمریکا تأکید کرد تنگۀ هرمز یک آبراه بین‌المللی است و سپاه پاسداران حق ندارد مسیر تردد آزاد و باز کشتی‌ها را تعیین کند.\u003cbr/\u003eبر اساس این اطلاعیه،کشتی‌های تجاری با پشتیبانی نظامی آمریکا همچنان از تنگۀ هرمز عبور می‌کنند.\u003cbr/\u003eسنتکام اعلام کرد نیروهای آمریکایی از اوایل ماه مه تاکنون به عبور حدود هزار کشتی و انتقال نزدیک به ۵۰۰میلیون بشکه نفت خام از این آبراه باریک کمک کرده‌اند.\u003cbr/\u003eفرماندهی مرکزی آمریکا پیش از این نیز اعلام کرده بود تهدید کشتی‌ها،تلاش برای حمله به شناورهای تجاری و ایجاد محدودیت در مسیرهای بین‌المللی کشتیرانی را تحمل نخواهد کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
