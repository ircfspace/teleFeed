    {
      "id": 5361,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e دادگاه بریتانیا دو متهم حمله به روزنامه‌نگار ایرانی را مجرم شناخت\u003cbr/\u003e\u003cbr/\u003eدادگاه وولیچ لندن، دو شهروند رومانیایی را در پروندهٔ حمله با چاقو به پوریا زراعتی، روزنامه‌نگار شبکهٔ ایران‌اینترنشنال، مجرم شناخت.\u003cbr/\u003eپوریا زراعتی در فروردین‌ماه دو سال پیش در نزدیکی خانه‌اش در جنوب غربی لندن هدف حمله قرار گرفت و از ناحیهٔ پا زخمی شد.\u003cbr/\u003eدادستان پرونده گفت این حمله از پیش برنامه‌ریزی شده بود و عاملان، پس از عملیات شناسایی، اقدام به حمله کردند.\u003cbr/\u003eدادستانی بریتانیا اعلام کرد این عملیات از سوی شخص یا اشخاصی به نمایندگی از حکومت جمهوری اسلامی هدایت شده بود.\u003cbr/\u003eجمهوری اسلامی هرگونه دست داشتن در این پرونده را رد کرده است.\u003cbr/\u003eناندیتو بادئا ۲۱ ساله و جورج استانا ۲۵ ساله اتهام جراحت عامدانه به مضروب را رد کرده بودند، اما دادگاه آن‌ها را مجرم شناخت.\u003cbr/\u003eدادستانی همچنین گفت متهم سوم پرونده، دیوید آندری، در رومانی بازداشت شده اما در جلسات دادگاه حضور نداشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B2%D8%AF%D9%88%D8%B1\"\u003e#مزدور\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
