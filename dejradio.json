    {
      "id": 4833,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e اعتصاب مرغ‌داران بهبهان در استان خوزستان موجب کمبود مرغ در شهر شده است.\u003cbr/\u003eمرغ‌داران که ۸ روز است در اعتصاب به سر می‌برند، علت اعتصاب خود را بالا بودن هزینه‌ها عنوان کرده‌اند.\u003cbr/\u003eدر مرغ‌فروشی‌ها تنها ران یخ زده مرغ که از شهرهای دیگر آورده می‌شود موجود است و هر کیلو نزدیک به ۴۰۰ هزار تومان به فروش می‌رسد که توان خرید آن برای اقشار ضعیف اصلا ممکن نیست.\u003cbr/\u003eمرغ‌داران می‌گویند توان تامین ذرت و سویا را ندارند و بدهکارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B1%D8%BA\"\u003e#مرغ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
