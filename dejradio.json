      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e کرج؛ اطلاعیه مفقودی مجتبی خامنه‌ای\u003cbr/\u003e\u003cbr/\u003eدر خیابان‌های کرج اطلاعیه‌ای به در و دیوار نصب شده که در آن اعلام شده مجتبی خامنه‌ای مفقود شده است و یابنده خواسته شده او را پیدا کنند و یک میلیون تومان پاداش بگیرند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%81%D9%82%D9%88%D8%AF%DB%8C\"\u003e#مفقودی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
