    {
      "id": 5332,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e جاده‌های شمال در سالمرگ خمینی بازهم به گذرگاه تفریحی تبدیل شد\u003cbr/\u003e\u003cbr/\u003eخبرگزاری دولت جمهوری اسلامی گزارش داد جاده‌های منتهی به مقاصد گردشگری و تفریحی شمال ایران، روز پنج‌شنبه ۱۴ خردادماه با ترافیک سنگین مواجه است.\u003cbr/\u003eرئیس پلیس راه مازندران، با اعلام وقوع ترافیک سنگین در محورهای ورودی استان، گفت احتمال اعمال محدودیت در جاده‌های کندوان و هراز وجود دارد.\u003cbr/\u003eتعطیلی رسمی حکومتی برای «سوگواری» مرگ روح‌الله خمینی در چهاردهم خرداد هر سال، با سفرهای تفریحی میلیون‌ها تن از شهروندان همراه می‌شود.\u003cbr/\u003eاز دهه‌های پیشین بسیاری از مردم، مراسم حکومتی «ارتحال» خمینی را مراسم «عشق‌وحال» نامگذاری کرده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%AD%D8%A7%D9%84_%D9%BE%D8%A7%D8%B1%D8%AA%DB%8C\"\u003e#ارتحال_پارتی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
