    {
      "id": 8621,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e درگیری‌ها میان پلیس فرانسه و معترضان در اعتراضات شنبه ۲۵ مهرماه ۱۴۰۵ در شهرهای لیون، پاریس، لیل، مارسی و چند شهر دیگر به شدت بالاگرفت و به خشونت کشیده شد. معترضان اغلب آفریقایی‌تبارها، چپ‌های کمونیست و عرب‌های حامی فلسطین هستند.\u003cbr/\u003eبراساس گزارش رسانه‌های فرانسوی ده‌ها فروشگاه غارت شد، تعداد زیادی اتومبیل شخصی آسیب دید.\u003cbr/\u003eامانوئل ماکرون تهدید به بازداشت تخریبگران کرد و گزارش شد حدود ۱۲۰۰ نفر بازداشت شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D8%A7%D9%86%D8%B3%D9%87\"\u003e#فرانسه\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D9%85%D9%88%D9%86%DB%8C%D8%B3%D8%AA\"\u003e#کمونیست\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%B4%D9%88%D8%A8\"\u003e#آشوب\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
