    {
      "id": 6528,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e تهدید صریح عضو شورای عالی انقلاب فرهنگی به ترور رهبران  مخالف جمهوری اسلامی در آمریکا\u003cbr/\u003e\u003cbr/\u003e​ انتشار ویدئویی از اظهارات حسن رحیم‌پور ازغدی، عضو شورای عالی انقلاب فرهنگی جمهوری اسلامی، موج تازه‌ای از واکنش‌ها را برانگیخته است. وی در این سخنان به‌طور صریح و تهدیدآمیزی خواهان «ترور» رهبران مخالفان حکومت ایران در خاک آمریکا شد.\u003cbr/\u003e\u003cbr/\u003e​رحیم‌پور ازغدی در این اظهارات مدعی شد که اگر این افراد در ایالات متحده ترور نشوند، بار دیگر برای سازماندهی و برنامه‌ریزی «اغتشاشات داخلی» در ایران اقدام خواهند کرد.\u003cbr/\u003e\u003cbr/\u003e​اگرچه تاریخ دقیق ضبط و مکان این سخنرانی هنوز به‌طور رسمی مشخص نشده است، اما این اولین بار نیست که چهره‌های شاخص و وابسته به حکومت ایران، مواضعی مبنی بر حذف فیزیکی و ترور مقامات خارجی یا مخالفان سیاسی اتخاذ می‌کنند. \u003cbr/\u003e\u003cbr/\u003eپیش از این نیز بارها نهادها و چهره‌های تندرو اسلامی برای ترور مقامات ارشد آمریکایی و اسرائیلی، از جمله دونالد ترامپ و بنیامین نتانیاهو، اقدام به تعیین جایزه یا انتشار ویدئوهای شبیه‌سازی‌شده کرده بودند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%87%D8%AF%DB%8C%D8%AF\"\u003e#تهدید\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
