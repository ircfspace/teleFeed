    {
      "id": 5824,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eفرانسه لغو تحریم‌ها را مشروط به تغییر رفتار جمهوری اسلامی و حل مسئلۀ موشکی و هسته‌ای دانست\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eژان-نوئل بارو، وزیر امور خارجۀ فرانسه اعلام کرد پاریس تا زمانی که از تغییر رفتار جمهوری اسلامی اطمینان نیابد، با لغو تحریم‌های بین‌المللی علیه تهران موافقت نمی‌کند.\u003cbr/\u003eاو گفت مذاکرات آتی باید علاوه بر برنامۀ هسته‌ای، به موضوع موشک‌های بالستیک و پشتیبانی جمهوری اسلامی از نیروهای نیابتی در منطقه نیز بپردازد.\u003cbr/\u003eبارو تأکید کرد ثبات پایدار در خاورمیانه بدون تغییر اساسی در سیاست‌های منطقه‌ای جمهوری اسلامی امکان‌پذیر نیست.\u003cbr/\u003eوزیر امور خارجه فرانسۀ همچنین گفت پاریس در شورای امنیت سازمان ملل متحد، از لغو تحریم‌ها علیه رژیم حاکم بر ایران پشتیبانی نمی‌کند.\u003cbr/\u003eژان-نوئل بارو افزود پشتیبانی فرانسه از لغو تحریم‌ها علیه رژیم، در صورتی رخ می‌دهد که نتیجۀ مذاکره با جمهوری اسلامی، انتظارات کشورهای غربی را برآورده کند.\u003cbr/\u003eپیش‌تر نیز کایا کالاس، مسئول سیاست خارجی اتحادیۀ اروپا، اعلام کرده بود هنوز برای بحث دربارۀ لغو تحریم‌های اروپا علیه جمهوری اسلامی زود است.\u003cbr/\u003eبه گفتۀ کایا کالاس، این موضوع تنها پس از دستیابی به توافق جامع هسته‌ای می‌تواند بررسی شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D8%A7%D9%86%D8%B3%D9%87\"\u003e#فرانسه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
