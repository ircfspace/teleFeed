    {
      "id": 5822,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eمذاکرات روز آدینۀ نمایندگان جمهوری اسلامی و آمریکا رسما لغو شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت خارجۀ سوئیس رسماً اعلام کرد مذاکرات برنامه‌ریزی‌شده میان نمایندگان جمهوری اسلامی و آمریکا که قرار بود روز آدینه ۲۹ خردادماه آغاز شود، لغو شده است.\u003cbr/\u003eاین تصمیم اندکی بعد از آن اعلام شد که کاخ سفید خبر لغو سفر جی‌دی ونس، معاون رئیس‌ جمهوری آمریکا به سوئیس را تأیید کرد.\u003cbr/\u003eلغو این مذاکرات تنها یک روز پس از امضای تفاهم‌نامه تهران و واشینگتن رخ داده است.\u003cbr/\u003eدر این تفاهمنامه قید شده که تهران و واشینگتن ۶۰ روز فرصت دارند طی مذاکرات دربارۀ پرونده هسته‌ای جمهوری اسلامی به توافقی جامع دست یابند.\u003cbr/\u003eخبرگزاری حکومتی تسنیم، پیش‌تر گزارش داده بود مذاکره‌کنندگان جمهوری اسلامی پیش از آغاز دور تازۀ گفت‌وگوها خواهان مشاهدۀ نشانه‌هایی از اجرای توافق از سوی آمریکا شده‌اند.\u003cbr/\u003eوزارت امور خارجۀ سوئیس درمورد زمان ازسرگیری دوبارۀ مذاکرات توضیحی ارائه نکرده است.\u003cbr/\u003eمقام‌های جمهوری اسلامی هنوز واکنشی رسمی به لغو نشست سوئیس نشان نداده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%88%D8%A6%DB%8C%D8%B3\"\u003e#سوئیس\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
