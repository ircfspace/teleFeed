    {
      "id": 7814,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e جمهوری اسلامی تلاش می‌کند از مسیر دولت‌های شرق آسیا تحریم‌های آمریکا موسوم به \u0026#34;عملیات طرد اقتصادی\u0026#34; را دور بزند.\u003cbr/\u003e\u003cbr/\u003eدر همین ارتباط طاهر عبدالحی، مدیرعامل ایران‌ایر ۱۸ شهریور ۱۴۰۵ با داتو وان يوسری سفیر مالزی در تهران دیدار کردند.\u003cbr/\u003e\u003cbr/\u003eایسنا گزارش داد اولویت‌های راهبردی ایران از سرگیری پروازهای مستقیم به فرودگاه بین‌المللی کوالالامپور (KLIA) و برگزاری کمپین‌های مشترک اقتصادی است.\u003cbr/\u003eگفته می‌شود پروازهای ایران‌ایر به مالزی از ۱۰ آبان آغاز خواهد شد‌.\u003cbr/\u003e\u003cbr/\u003eبه‌تازگی آمریکا ۲۷ شرکت هواپیمایی جمهوری اسلامی را در فهرست تحریم قرار داد و اعلام کرد هر کشوری با آنها ارتباط داشته باشد، مجازات خواهد شد.\u003cbr/\u003e\u003cbr/\u003eمالزی از مسیر دریا نیز به جمهوری اسلامی در دور زدن تحریم‌ها کمک می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
