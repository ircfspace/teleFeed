    {
      "id": 7840,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بلومبرگ گزارش داد با ادامه محاصره دریایی آمریکا، بارگیری نفت خام و میعانات ایران در مرداد حدود ۷۴ درصد کاهش یافت و به ۲۴۷ هزار بشکه در روز رسید؛ رقمی که کمتر از ۱۵ درصد میزان ثبت‌شده پیش از آغاز جنگ است.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، با گذشت نزدیک به دو ماه از آغاز دوباره محاصره دریایی آمریکا، صادرات نفت ایران همچنان به‌شدت محدود است. تصاویر ماهواره‌ای اتحادیه اروپا نیز دست‌کم در دو هفته گذشته هیچ ابرنفتکشی را در حال بارگیری در جزیره خارک، پایانه اصلی صادرات نفت ایران، نشان نداده‌اند.\u003cbr/\u003e\u003cbr/\u003eبلومبرگ نوشت ذخایر نفت خام و میعانات در تاسیسات اصلی ایران، از جمله خارک، گوره و عسلویه، به حدود ۶۷ میلیون بشکه رسیده و به بالاترین میزان ثبت‌شده در چند ماه گذشته نزدیک شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA_%D8%AE%D8%A7%D9%85\"\u003e#نفت_خام\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
