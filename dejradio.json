      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e در شرایطی که پس از جنگ صدها واحد صنفی نابود یا فعالیت آنها متوقف شد، به دستور قوه قضاییه با لودر ساختمان یک کارگاه با بیش از ۱۰۰ کارگر و صنعتگر را تخریب کردند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%82%D9%88%D9%82_%DA%A9%D8%A7%D8%B1%DA%AF%D8%B1%D8%A7%D9%86\"\u003e#حقوق_کارگران\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%DB%8C%DA%A9%D8%A7%D8%B1%DB%8C\"\u003e#بیکاری\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
