    {
      "id": 8455,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e هم‌زمان با افزایش احتمال آغاز درگیری‌ها در منطقه، علی جهانشاهی فرمانده نیروی زمینی ارتش اعلام کرد بیش از ۵۰ یگان رزمی و پشتیبانی این نیرو در مرزهای ایران مستقر هستند. \u003cbr/\u003e\u003cbr/\u003eجهانشاهی می‌گوید نیروی زمینی ارتش ایران برای مقابله با احتمال ورود نیرو به خاک ایران نیز اقداماتی انجام داده است.\u003cbr/\u003eاو توضیح داد استقرار این یگان‌ها با آغاز جنگ در نهم اسفند سال گذشته آغاز شد.\u003cbr/\u003e\u003cbr/\u003eبه گفته جهانشاهی، این یگان‌ها شامل تیپ‌های متحرک، واکنش، زرهی و مکانیزه و همچنین یگان‌های توپخانه، مهندسی، موشکی و پهپادی است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
