    {
      "id": 7126,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e حمله جمهوری اسلامی به کشتی اماراتی در تنگه هرمز \u003cbr/\u003eامارات، سپاه را به «دزدی دریایی» متهم کرد\u003cbr/\u003e\u003cbr/\u003eامارات متحده عربی شنبه ۱۷ مرداد حمله موشکی جمهوری اسلامی به یک نفتکش متعلق به شرکت ملی نفت ابوظبی «ادنوک» در هنگام عبور از تنگه هرمز را محکوم و سپاه پاسداران را به « دزدی دریایی» متهم کرد. \u003cbr/\u003e\u003cbr/\u003eکشورهای منطقه نیز این حمله را به‌شدت محکوم کردند.\u003cbr/\u003eاین حمله یک روز پس از آن رخ داد که ادنوک اعلام کرد از آغاز جنگ، ۱۵ شناور این شرکت هنگام عبور از تنگه هرمز با موشک و پهپاد هدف قرار گرفته‌اند که سه فروند از آنها تنها در هفته گذشته بوده است. آن حملات یک کشته و ۲۰ زخمی در میان خدمه بر جای گذاشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
