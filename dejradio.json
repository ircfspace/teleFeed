    {
      "id": 8317,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e \u003cb\u003eهواپیمای سی-۱۳۰ لهستان از ترکیه به لبنان رفت\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eهواپیمای سی‌-۱۳۰ نیروی هوایی لهستان ۱۱ مهرماه ۱۴۰۵ پایگاه هوایی پوییدز را ترک کرد و پس از توقف در سارایوو، برای گذراندن شب به پایگاه هوایی اینجرلیک در آدانا، ترکیه رفت. این هواپیما اکنون با شناسه پروازی PLF251 وارد بیروت شده و بعدتر به پوییدز بازخواهد گشت.\u003cbr/\u003eدر حال حاضر ۱۴۰ نیروی نظامی لهستان در لبنان در چارچوب مأموریت «یونیفل» حضور دارند؛ این تعداد در سال ۲۰۲۳، ۳۱۱ نفر بود.\u003cbr/\u003eاین پرواز در شرایطی انجام می‌شود که مأموریت «یونیفل» در پایان سال جاری میلادی خاتمه خواهد یافت و نیروهای این مأموریت طی سال ۲۰۲۷ از لبنان خارج خواهند شد. یونیفل یکی از ابزارهای بین‌المللی نظارت بر فعالیت‌های نظامی در جنوب لبنان و اجرای قطعنامه ۱۷۰۱ است؛ قطعنامه‌ای که محدود کردن حضور و فعالیت گروه‌های مسلح از جمله حزب‌الله در جنوب لبنان را دنبال می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DB%8C%D9%88%D9%86%DB%8C%D9%81%D9%84\"\u003e#یونیفل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
