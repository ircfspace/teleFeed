    {
      "id": 8084,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e عطا حسینیان، روزنامه‌نگار اقتصادی، باور دارد در حالی‌که ویژه‌خواران و آقازاده‎‌ها و فرماندهان پول نفت و معاملات پنهان را جارو می‌کنند، نظامی‌ها در بدترین شرایط با حقوق بخور و نمیر معاش می‌کنند. \u003cbr/\u003e\u003cbr/\u003eاو اشاره کرد ارتشی‌ها و نیروهای پلیس در دوران صدام حسین هم چنین وضعیتی داشتند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
