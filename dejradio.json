    {
      "id": 5986,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003ca href=\"https://x.com/LauraLoomer/status/2070241148724228546?s=20\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cb\u003eخبرنگار آمریکایی دربارۀ مشورت‌های سهراب احمری و تریتا پارسی به جی‌دی ونس، خواستار شفافیت شد\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eلورا لومر، روزنامه‌نگار و فعال سیاسی نزدیک به جریان «آمریکا نخست» با انتشار مطالبی خواستار شفاف‌سازی کاخ سفید پیرامون نقش سهراب احمری و تریتا پارسی در مشاوره به جی‌دی ونس، معاون دونالد ترامپ شد.\u003cbr/\u003eتریتا پارسی از لابی‌گران اصلی جمهوری اسلامی در آمریکا به‌شمار می‌رود و در مورد سهراب احمری نیز ابهامات بسیاری وجود دارد.\u003cbr/\u003eبه گفتۀ لورا لورمر، سهراب احمری اعلام کرده که همراه جی‌دی ونس، معاون رئیس‌ جمهوری آمریکا با هواپیمای اختصاصی ایر فورس تو، سفر کرده و گفت‌وگوهایی دربارۀ مسائل ایران داشته است.\u003cbr/\u003eاین خبرنگار آمریکایی نوشت منابعی در کاخ سفید پیش‌تر به او گفته بودند احمری در محافل مختلف ادعا می‌کند دربارۀ ایران و برخی موضوعات سیاست خارجی به ونس مشاوره می‌دهد.\u003cbr/\u003eجی‌دی ونس به عنوان فرد نخست در شکل‌گیری تفاهم میان تهران و واشینگتن شناخته می‌شود. پیش‌تر گزارش شده بود که قالیباف برای حضور خود در مذاکرات، بر حضور ونس در هیئت آمریکایی پافشاری کرده است.\u003cbr/\u003eلورا لومرهمچنین اعلام کرد تریتا پارسی، رئیس پیشین نایاک نیز به افرادی گفته است که در موضوع ایران به معاون رئیس‌ جمهوری آمریکا مشاوره می‌دهد.\u003cbr/\u003eاین خبرنگار آمریکایی یادآور شد که فعالیت‌های پیشین تریتا پارسی در خاک آمریکا، توسط وزارت امور خارجۀ ایالات متحده تحت بررسی قرار گرفته است.\u003cbr/\u003eبنا بر گزارش‌ها، مارکو روبیو، وزیر امور خارجۀ آمریکا بررسی پروندۀ تریتا پارسی را با هدف اخراج او از خاک ایالات متحده، در دستور کار قرار داده بود.\u003cbr/\u003eبه گفتۀ لورا لومر، چند سناتور جمهوری‌خواه خواستار پژوهش دربارۀ نقش تریتا پارسی در مورد تفاهم با جمهوری اسلامی شده‌اند.\u003cbr/\u003eبنیان‌گذار رسانۀ لومرد، از دولت ترامپ خواست در صورت نادرست بودن این ادعاها، به‌صورت علنی آن را اعلام کند.\u003cbr/\u003eاو تأکید کرد افرادی که مورد تحقیقات امنیتی یا مهاجرتی قرار دارند، نباید به رئیس‌ جمهوری ایالات متحده یا معاون او از نزدیک دسترسی داشته باشند.\u003cbr/\u003eبه گفتۀ لورا لورمر، وقتی پروندۀ تریتا پارسی برای اخراج دردست بررسی است، او نباید بتواند به رئیس جمهوری آمریکا یا معاونش نزدیک شود.\u003cbr/\u003eلورا لومر مدعی شد سهراب احمری آشکارا با دشمنان آمریکا رفت‌وآمد دارد و از اسلام‌گرایان دفاع می‌کند.\u003cbr/\u003eمجری برنامۀ لومر آنلیشد، نوشت ممکن است تریتا پارسی و سهراب احمری، با نزدیک شدن به دولت ترامپ در حال جمع‌آوری اطلاعات برای سپاه باشند.\u003cbr/\u003eبه گفتۀ لورا لومر، چند سناتور جمهوری‌خواه خواستار پژوهش دربارۀ نقش تریتا پارسی در مورد تفاهم با جمهوری اسلامی شده‌اند.\u003cbr/\u003eلورا لورمر یادآوری کرد اسلام‌گرایان برای پیشبرد اهداف اسلام در آمریکا، مجاز به دروغ‌گویی‌اند.\u003cbr/\u003eروزنامه‌نگار پژوهشی آمریکایی نوشت سهراب احمری پس از یک عمر کمونیست بودن، اکنون خود را کاتولیک می‌داند و با ابزار مذهب به جریان راست در آمریکا ورود کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%D8%A7%DB%8C%D8%A7%DA%A9\"\u003e#نایاک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%DB%8C%E2%80%8C%D8%AF%DB%8C%E2%80%8C%D9%88%D9%86%D8%B3\"\u003e#جی‌دی‌ونس\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
