    {
      "id": 7380,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک مقام ستاد کل نیروهای مسلح:\u003cbr/\u003eسه خلبان نهاجا اسیر در قطر، مجروح و بیمارند\u003cbr/\u003e\u003cbr/\u003eمحمد باقرزاده، فرمانده کمیته جست‌وجوی مفقودین ستاد کل نیروهای مسلح، مدعی شد سه خلبان نیروی هوایی ارتش که در جنگ مفقود شدند، در مکانی «روی آب» نگهداری می‌شوند.\u003cbr/\u003e\u003cbr/\u003eتسنیم شنبه ۳۱ امرداد ۱۴۰۵ به نقل از باقرزاده مدعی شد آنها وضعیت جسمی مناسبی ندارند. \u003cbr/\u003eاو از دولت قطر خواست آن‌ها را به بیمارستانی مجهز در خشکی منتقل کند. باقرزاده همچنین خواستار اعزام آمبولانس هوایی کمیته بین‌المللی صلیب سرخ به قطر برای انتقال خلبانان مجروح و بیمار به ایران شد.\u003cbr/\u003e\u003cbr/\u003eدولت قطر ادعای جمهوری اسلامی در مورد این سه خلبان را رد می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%B7%D8%B1\"\u003e#قطر\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
