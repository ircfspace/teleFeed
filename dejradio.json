    {
      "id": 7942,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e در شرایطی که طی جنگ طولانی، شمار زیادی از سربازان وظیفه در پی ضعف پدافندی جمهوری اسلامی جان خود را از دست دادند، گزارش‌ها حاکی است بسیاری از سربازان نیروی زمینی ارتش بدون در اختیار داشتن امکانات و تجهیزات مناسب، به تخریب مغازه‌های قدیمی پادگان تیپ ۴۰ سراب وادار شده‌اند.\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌های منتشرشده در ۲۵ شهریور ۱۴۰۵، این تخریب‌ها در ارتباط با پروژه ساخت اتوبان سراب–نیر انجام شده و از سربازان وظیفه برای انجام این کار بیگاری کشیده شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%DB%8C%DA%AF%D8%A7%D8%B1%DB%8C\"\u003e#بیگاری\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%B2%D9%85%DB%8C%D9%86%DB%8C_%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#نیروی_زمینی_ارتش\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B1%D8%AA%D8%B4\"\u003e#ارتش\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
