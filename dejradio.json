    {
      "id": 5470,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e حمله اسرائیل به لبنان؛ پوست موزی که زیر پای نظام انداخته شد\u003cbr/\u003eدر حالی که سپاه بارها تهدید کرده بود در صورت حمله اسرائیل به لبنان، به حمایت از حزب الله درگیری‌ها را از سر خواهد گرفت، اسرائیل پوست موز را زیر پای نظام انداخت و آن را وادار به واکنش کرد. \u003cbr/\u003e\u003cbr/\u003eسپاه پاسداران بیابان و در نهایت مناطق مسکونی اسرائیل را مورد اصابت قرار داد، بدون آنکه حملاتش ارزش نظامی داشته باشد. اما اسرائیل در واکنش به این حملات، به صورت هدفمند و دقیق چندین نقطه دارای ارزش نظامی و چند سایت پدافندی و پهپادی نظام را مورد حمله قرار داد و عملا تلاش‌های نظام در این مدت برای احیای تجهیزات نظامی را ناکام گذاشت.\u003cbr/\u003e\u003cbr/\u003eعقل بچه‌ عرزشی بیش از این نیست؛ هم چوب را خورد، هم پیاز را.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
