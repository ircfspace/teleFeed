    {
      "id": 5966,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e روبیو: جمهوری اسلامی به‌جای صدور ایدئولوژی، به رفاه مردم بیندیشد؛ توافق بی‌فایده برای آمریکا پذیرفتنی نیست\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eمارکو روبیو، وزیر امور خارجۀ ایالات متحده گفت تنها توافقی برای آمریکا قابل پذیرش است  که واقعی، قابل راستی‌آزمایی و پایدار باشد.\u003cbr/\u003eروبیو تأکید کرد رژیم حاکم بر ایران به جای صدور ایدئولوژی به کشورهای دیگر، باید به یک «دولت-ملت» تبدیل شود که بر رفاه مردم ایران تمرکز کند.\u003cbr/\u003eوزیر امور خارجۀ آمریکا در نشست با همتایان خود در شورای همکاری خلیج فارس در بحرین گفت آمریکا همچنان آمادۀ دستیابی به توافق با جمهوری اسلامی است. \u003cbr/\u003eبه گفتۀ وزیر امور خارجۀ آمریکا هر توافقی باید تضمین‌هایی قابل راستی‌آزمایی برای جلوگیری از دستیابی به سلاح اتمی داشته باشد.\u003cbr/\u003eمارکو روبیو هشدار داد که  جمهوری اسلامی هرگز نباید به سلاح هسته‌ای دست یابد.\u003cbr/\u003eروبیو همچنین گفت تنگۀ هرمز یک آبراه بین‌المللی است و هیچ کشوری حق ندارد عوارض یا هزینه‌ای را برای عبور کشتی‌ها از این مسیر دریافت کند.\u003cbr/\u003eوزیر امور خارجۀ آمریکا افزود هیچ بخشی از توافق احتمالی نباید امنیت و ثبات کشورهای حوزه خلیج فارس را تضعیف کند و آمریکا این موضوع را در مذاکرات با تهران مدنظر قرار می‌دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%A7%D8%B1%DA%A9%D9%88_%D8%B1%D9%88%D8%A8%DB%8C%D9%88\"\u003e#مارکو_روبیو\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
