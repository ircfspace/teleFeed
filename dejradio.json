    {
      "id": 8264,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e بازداشت شهروند ایرانی-بریتانیایی در پرونده طرح تروریستی پایگاه فرفورد؛ پلیس احتمال دخالت دولت خارجی را بررسی می‌کند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eپلیس ضدتروریسم بریتانیا روز پنج‌شنبه یک مرد ۲۷ساله با تابعیت دوگانه ایرانی و بریتانیایی را در منطقه وست‌مینستر لندن، در ارتباط با پرونده امنیتی پایگاه هوایی فرفورد بازداشت کرد.\u003cbr/\u003eبر اساس بیانیه رسمی پلیس ضدتروریسم، این فرد به ظن «آماده‌سازی برای اقدامات تروریستی» و بر اساس ماده ۵ قانون تروریسم سال ۲۰۰۶ بازداشت شده است. مأموران همچنین دو ملک در لندن را بازرسی کرده‌اند و یک مرد ۲۶ساله بریتانیایی نیز در ارتباط با این تحقیقات تحت بازجویی قرار گرفته است.\u003cbr/\u003eاین تازه‌ترین تحول در پرونده‌ای است که از روز یک‌شنبه و پس از بازداشت پنج مرد بریتانیایی در نزدیکی پایگاه هوایی فرفورد آغاز شد. این پنج نفر به ظن جرائم مرتبط با مواد منفجره و آماده‌سازی اقدام تروریستی بازداشت و سپس با قرار وثیقه آزاد شدند. \u003cbr/\u003eبازداشت شهروند ایرانی-بریتانیایی یک روز پس از آن صورت می‌گیرد که اندی برنام، نخست‌وزیر بریتانیا، گفت «نشانه‌های قوی» از نقش جمهوری اسلامی در حادثه فرفورد وجود دارد. پایگاه فرفورد در عملیات نظامی آمریکا، از جمله حملات اخیر علیه جمهوری اسلامی، مورد استفاده قرار گرفته است. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D9%81%D9%88%D8%B1%D8%AF\"\u003e#فرفورد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B1%DB%8C%D8%AA%D8%A7%D9%86%DB%8C%D8%A7\"\u003e#بریتانیا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D9%85%D9%84%DB%8C%D8%A7%D8%AA_%D8%AA%D8%B1%D9%88%D8%B1%DB%8C%D8%B3%D8%AA%DB%8C\"\u003e#عملیات_تروریستی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
