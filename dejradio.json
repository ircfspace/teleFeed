    {
      "id": 6635,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e سازمان انرژی اتمی جمهوری اسلامی از حملۀ آمریکا به نیروگاه هسته‌ای دارخوین خبر داد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eسازمان انرژی اتمی جمهوری اسلامی اعلام کرد ارتش آمریکا بامداد یکشنبه ۲۸ تیر به سایت در حال ساخت نیروگاه هسته‌ای دارخوین در استان خوزستان حمله کرده است.\u003cbr/\u003eاین سازمان در بیانیه‌ای اعلام کرد این حمله حوالی ساعت ۳:۳۹ بامداد با شلیک چند پرتابه انجام شده است. \u003cbr/\u003eبنا بر ادعای مقامات جمهوری اسلامی، این حمله اقدامی «خلاف قوانین بین‌المللی» به‌شمار می‌رود.\u003cbr/\u003eنیروگاه هسته‌ای کارون در دارخوین، با ظرفیت ۳۰۰ مگاوات، از آذرماه سال ۲۵۸۱ در نزدیکی شادگان در استان خوزستان در دست ساخت است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DA%AF%D8%A7%D9%87_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#نیروگاه_اتمی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%A7%D8%B1%D8%AE%D9%88%DB%8C%D9%86\"\u003e#دارخوین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
