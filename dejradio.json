    {
      "id": 8203,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eتحریم‌های تازه آمریکا علیه شبکه تأمین تسلیحات جمهوری اسلامی\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت خزانه‌داری آمریکا ۱۰ فرد و نهاد در چند کشور را به اتهام تأمین تسلیحات، قطعات نظامی و تجهیزات دومنظوره برای وزارت دفاع جمهوری اسلامی تحریم کرد.\u003cbr/\u003eدر میان تحریم‌شدگان، یک نماینده وزارت دفاع جمهوری اسلامی در پکن، شرکت‌هایی در ایران و هنگ‌کنگ و همچنین «وسیم پاشا تجمل» و سه شرکت مرتبط با او در پاکستان، عربستان سعودی و ترکیه قرار دارند.\u003cbr/\u003eواشینگتن می‌گوید این شبکه‌ها در تأمین تجهیزات مورد استفاده در برنامه‌های موشک‌های بالستیک، پهپادها و هواپیماهای نظامی جمهوری اسلامی نقش داشته‌اند. اسکات بسنت، وزیر خزانه‌داری آمریکا، نیز تأکید کرد واشینگتن به شناسایی و قطع شبکه‌های مالی و تدارکاتی جمهوری اسلامی ادامه خواهد داد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D8%B7%D8%B1%D8%AF_%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%DB%8C\"\u003e#طرد_اقتصادی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
