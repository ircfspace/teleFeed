    {
      "id": 6376,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eچین خرید نفت از جمهوری اسلامی را به پایین‌ترین سطح دو سال اخیر رساند \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eداده‌های شرکت کپلر نشان می‌دهد واردات نفت از ایران به چین، در ماه جاری میلادی به ۵۵۶ هزار بشکه در روز کاهش یافته است.\u003cbr/\u003eاین پایین‌ترین میزان صادرات نفت توسط جمهوری اسلامی به چین از ژانویۀ ۲۰۲۳ به‌شمار می‌رود.\u003cbr/\u003eرویترز گزارش داد پالایشگاه‌های چین در هفته‌های اخیر خرید نفت از عراق، قطر، امارات و عربستان را افزایش داده‌اند.\u003cbr/\u003eبر پایۀ گزارش‌ها پالایشگاه‌های مستقل چین در هفته‌های اخیر بین ۱۶ تا ۲۰ میلیون و ۵۰۰ هزار بشکه نفت از عراق، قطر و امارات خریدند.\u003cbr/\u003eبرخی تحلیلگران پیش‌بینی می‌کنند جمهوری اسلامی برای امکان افزایش فروش، تخفیف‌هایی بیش از پیش را در محموله‌های نفتی خود اعمال کند. \u003cbr/\u003eخبرگزاری رویترز گزارش داد حجم نفت روی آب ایران به دلیل فروش نرفتن، افزایش یافته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%86%DB%8C%D9%86\"\u003e#چین\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
