    {
      "id": 7705,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e رسانه‌های محلی کرمانشاه روز آدینه ۱۴ شهریور ۱۴۰۵ گزارش دادند دو ارتشی به نام‌های امیرحسین ماوایی و صادق امیری در پادگان‌هایشان به زندگی خود پایان دادند. \u003cbr/\u003e\u003cbr/\u003eامیرحسین ماوایی در پادگان لشکر ۸۱ زرهی کرمانشاه و صادق امیری در پادگان جیران‌بلاغ، محل استقرار تیپ ۳۵ تکاور نیروی زمینی ارتش تصمیم گرفتند به زندگی خود پایان دهند. \u003cbr/\u003e\u003cbr/\u003eمشکلات مالی و معیشتی به‌عنوان یکی از عوامل مرتبط با خودکشی این دو افسر مطرح شده است؛ با این حال، ارتباط مستقیم این مشکلات مالی با مرگ آنان تاکنون به‌صورت مستقل تأیید نشده است.\u003cbr/\u003eبه ویژه پس از جنگ آمار مرگ خودساخته در بین نیروهای مسلح افزایش پیدا کرد.\u003cbr/\u003e\u003cbr/\u003eهر دو ارتشی جوان ساکن محله شهیاد این شهر بوده‌اند.\u003cbr/\u003eهمچنین بر اساس اعلامیه منتشرشده درباره امیرحسین ماوایی، مراسم تشییع و خاکسپاری او روز آدینه ۱۴ شهریور ۱۴۰۵ در باغ فردوس کرمانشاه برگزار شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D8%B1%D9%85%D8%A7%D9%86%D8%B4%D8%A7%D9%87\"\u003e#کرمانشاه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D9%88%D8%AF%DA%A9%D8%B4%DB%8C\"\u003e#خودکشی\u003c/a\u003e \u003ca href=\"?q=%23%DA%AF%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#گرانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
