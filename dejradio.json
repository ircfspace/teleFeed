    {
      "id": 8499,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B5.png\u0026#39;)\"\u003e\u003cb\u003e🔵\u003c/b\u003e\u003c/i\u003e \u003cb\u003eبرگزاری جشن مهرگان و هشتادوهشتمین زادروز شهبانو فرح پهلوی در شهر کلن آلمان\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eروز یکشنبه ۱۱ اکتبر،مراسم جشن مهرگان و گرامیداشت هشتادوهشتمین زادروز شهبانو فرح پهلوی در شهر کلن آلمان،به همت انجمن «هما،هنرمندان میهن‌پرست ایران» و با مشارکت جمعی از ایران‌دوستان برگزار شد.\u003cbr/\u003eاز نکات قابل توجه این مراسم،آشنایی و شناخت شماری از شهروندان آلمانی رهگذر با شخصیت شهبانو فرح پهلوی بود که نشان‌دهنده شناخته‌شدن نام و جایگاه ایشان فراتر از جامعه ایرانیان است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%87%D8%B1%DA%AF%D8%A7%D9%86\"\u003e#مهرگان\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D9%84%D9%86\"\u003e#کلن\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%87%D8%A8%D8%A7%D9%86%D9%88\"\u003e#شهبانو\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
