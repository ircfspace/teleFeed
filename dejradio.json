    {
      "id": 9294,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5841473431744287874\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9B91.png\u0026#39;)\"\u003e\u003cb\u003e🛑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eنیویورک‌تایمز: افزایش نارضایتی ترامپ از ونس؛ جنگ با جمهوری اسلامی به محور رقابت جانشینی تبدیل شد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eروزنامه نیویورک‌تایمز در گزارشی از افزایش نارضایتی دونالد ترامپ از مواضع جی‌دی ونس، معاون رئیس‌جمهوری آمریکا، درباره جنگ با جمهوری اسلامی خبر داد.\u003cbr/\u003eبه نوشته این روزنامه، ونس پس از شکست سنگین جمهوری‌خواهان در انتخابات میان‌دوره‌ای، جنگ با جمهوری اسلامی را عامل اصلی شکست حزب معرفی کرد. ترامپ اگرچه ابتدا با بخشی از این ارزیابی موافقت کرده بود، اما طی دو هفته گذشته در گفت‌وگوهای خصوصی از اینکه معاونش بر درستی تصمیم آغاز جنگ تأکید نکرده، ابراز نارضایتی کرده است.\u003cbr/\u003eنیویورک‌تایمز گزارش داد که همزمان با افزایش تنش میان ترامپ و ونس، رئیس‌جمهوری آمریکا در محافل خصوصی از مارکو روبیو، وزیر خارجه خود، تمجید کرده و او را گزینه‌ای قدرتمند برای انتخابات ریاست‌جمهوری ۲۰۲۸ دانسته است. روبیو برخلاف ونس، بارها از تصمیم ترامپ برای حمله به جمهوری اسلامی دفاع کرده و آن را اقدامی ضروری برای امنیت ملی آمریکا خوانده است.\u003cbr/\u003eاین گزارش همچنین به تصمیم ترامپ برای کنار گذاشتن ونس از مذاکرات صلح با جمهوری اسلامی اشاره می‌کند؛ مذاکراتی که معاون رئیس‌جمهوری پیش از انتخابات میان‌دوره‌ای تلاش‌های خود را برای پیشبرد آن افزایش داده بود.\u003cbr/\u003eبه نوشته نیویورک‌تایمز، اختلاف بر سر جنگ با جمهوری اسلامی اکنون به یکی از عوامل تعیین‌کننده در رقابت احتمالی ونس و روبیو برای جانشینی ترامپ تبدیل شده است؛ رقابتی که می‌تواند آینده سیاست خارجی حزب جمهوری‌خواه و مسیر انتخابات ریاست‌جمهوری ۲۰۲۸ را تحت تأثیر قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D9%88%D9%86%D8%B3\"\u003e#ونس\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%88%D8%A8%DB%8C%D9%88\"\u003e#روبیو\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
