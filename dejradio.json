    {
      "id": 4992,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e رسانۀ نزدیک به نهادهای امنیتی: جمهوری اسلامی به دنبال آزادسازی ۲۴ میلیارد دلار است\u003cbr/\u003e\u003cbr/\u003eخبرگزاری حکومتی تسنیم، نزدیک به سپاه پاسداران به نقل از یک منبع آگاه گزارش داد جمهوری اسلامی در مذاکره با آمریکا در پی رفع انسداد از بیست و چهار میلیارد دلار از منابع است.\u003cbr/\u003eبر اساس این گزارش، تهران درخواست کرده دوازده میلیارد دلار از این مبلغ، همزمان با رونمایی از تفاهم‌نامۀ احتمالی آزاد شود و بقیه نیز طی شصت روز در دسترس قرار گیرد.\u003cbr/\u003eبنا بر ادعای این خبرگزاری نزدیک به نیروهای امنیتی، سفر محمدباقر قالیباف به قطر نیز در همین چارچوب و برای رایزنی درباره نحوۀ دسترسی به این منابع انجام شد.\u003cbr/\u003eقطر گزارش‌ها دربارۀ پیشنهاد وام دوازده میلیارد دلاری به جمهوری اسلامی برای تضمین توافق را «نادرست» خوانده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%B7%D8%B1\"\u003e#قطر\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
