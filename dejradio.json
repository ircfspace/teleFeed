    {
      "id": 5335,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسرائیل: در صورت حملۀ حزب‌الله، هدف گرفتن بیروت را حق خود می‌دانیم\u003cbr/\u003e\u003cbr/\u003eیسرائیل کاتز، وزیر دفاع اسرائیل روز پنج‌شنبه گفت ارتش اسرائیل در صورت حملۀ حزب‌الله، حق هدف قرار دادن بیروت را برای خود محفوظ می‌داند.\u003cbr/\u003eوزیر دفاع اسرائیل گفت ارتش این کشور عملیات زمینی و حملات در جنوب لبنان را ادامه می‌دهد و نیروها را در منطقۀ امنیتی ایجادشده، از جمله قلعۀ بوفور، نگه می‌دارد.\u003cbr/\u003eکاتز گفت اسرائیل با پشتیبانی آمریکا برای پاسخ به هر حمله علیه شهرها و قلمرو اسرائیل، از آزادی عمل برخوردار است.\u003cbr/\u003eاسرائیل و لبنان روز چهارشنبه  با میانجی‌گری آمریکا برای تمدید آتش‌بس توافق کرده بودند.\u003cbr/\u003eادامۀ آتش‌بس به توقف کامل حملات حزب‌الله و عقب‌نشینی نیروهای این گروه به شمال رود لیتانی، مشروط است.\u003cbr/\u003eشبه‌نظامیان حزب‌الله که از پشتیبانی مالی و فکری جمهوری اسلامی برخوردارند، در سیاهۀ تروریستی اتحادیۀ اروپا و آمریکا قرار دارند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
