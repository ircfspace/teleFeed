    {
      "id": 5008,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e دفتر رسانه‌ای شاهزاده احکام اعدام پروندهٔ اکباتان را سندی بر ماهیت جمهوری اسلامی خواند\u003cbr/\u003e\u003cbr/\u003eدفتر رسانه‌ای شاهزاده رضا پهلوی، در واکنش به صدور حکم اعدام برای چهار متهم پروندهٔ اکباتان، تصریح کرد که جمهوری اسلامی از اعدام برای وحشت‌آفرینی استفاده می‌کند.\u003cbr/\u003eدر بیانیهٔ دفتر شاهزاده با اشاره به نام میلاد آرمون، محمدمهدی حسینی، مهدی ایمانی و نوید نجاران که در پروندهٔ اکباتان به اعدام محکوم شدند، تأکید شد که جمهوری اسلامی برای حفظ قدرت، جوانان ایران را به قتل می‌رساند.\u003cbr/\u003eدفتر رسانه‌ای شاهزاده رضا پهلوی افزود دادگاه به ابزار سرکوب تبدیل شده و اعدام، سلاح حکومت برای بقای آن است.\u003cbr/\u003eدر این بیانیه از جامعهٔ جهانی نیز انتقاد شده است.\u003cbr/\u003eهمچنین سکوت کشورهای غربی در برابر اعدام معترضان ایرانی شکستی اخلاقی و‌ سیاسی، عنوان شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%DA%86%D9%87_%D9%87%D8%A7%DB%8C_%D8%A7%DA%A9%D8%A8%D8%A7%D8%AA%D8%A7%D9%86\"\u003e#بچه_های_اکباتان\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
