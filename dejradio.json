    {
      "id": 8557,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eریزش حمایت شیعیان لبنان از حزب‌الله؛ ۶۶ درصد خواستار خلع سلاح و ۶۳ درصد موافق توافق با اسرائیل هستند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eروزنامه جروزالم پست روز چهارشنبه ۲۲ مهرماه گزارش داد که حزب‌الله لبنان با وجود پولپاشی و وعده پرداخت کمک‌های مالی به خانواده‌های جنگ‌زده با پشتیبانی جمهوری اسلامی، با بحران اعتماد در میان جامعه شیعیان این کشور روبه‌رو است.\u003cbr/\u003eبر اساس نظرسنجی مؤسسه «استاتیستیکس لبنان» از ۸۰۰ شهروند شیعه در ماه سپتامبر، ۶۶.۴ درصد شرکت‌کنندگان از تحویل سلاح‌های حزب‌الله به دولت لبنان حمایت کرده‌اند و ۷۱.۱ درصد معتقدند تصمیم‌گیری درباره جنگ و صلح باید منحصراً در اختیار دولت باشد.\u003cbr/\u003eهمچنین ۶۳.۳ درصد پاسخ‌دهندگان از نوعی توافق با اسرائیل حمایت کرده‌اند و ۶۷.۴ درصد معتقدند حزب‌الله به اهداف خود در جنگ دست نیافته است.\u003cbr/\u003eدر این نظرسنجی، ۴۲.۱ درصد شرکت‌کنندگان نیز از عملکرد و رهبری حزب‌الله ابراز ناامیدی، خشم یا نگرانی کرده‌اند.\u003cbr/\u003eاین گزارش در حالی منتشر شده که حزب‌الله وعده داده به خانواده‌های واجد شرایطی که خانه‌هایشان در جنگ اخیر ویران شده، در بیروت و حومه جنوبی آن تا ۱۴ هزار دلار و در سایر مناطق لبنان تا ۱۲ هزار دلار کمک مالی پرداخت کند. پیش از این نیز گزارش شده بود که جمهوری اسلامی دویست میلیون دلار برای این گروه تحت امر خود در لبنان ارسال کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#جمهوری_اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
