    {
      "id": 4567,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e نمایشگاه سالیانه خودروهای کلاسیک و لوکس در برلین که همه‌ساله به مدت ۲ روز در خیابان «کودام» برگزار می‌شود، زیر تاثیر جنگ خاورمیانه قرار گرفت. \u003cbr/\u003e\u003cbr/\u003eرانندگان ماشین‌های قدیمی به دلیل افزایش بهای بنزین بعد از جنگ ۴۰ روزه ایران، کمتر گشت‌زنی می‌کردند و ایرانی‌های بازدیدکننده از نمایشگاه می‌گفتند با توجه به شرایط ایران حس و حالی برای خوش بودن نیست و دور از وطن با این جور نمایشگاه‌ها وقت تلف می‌کنیم.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D9%88%D8%AF%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%DA%A9%D9%84%D8%A7%D8%B3%DB%8C%DA%A9\"\u003e#خودروهای_کلاسیک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
