    {
      "id": 5849,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شهرداری پاریس، میزبان زادروز مجیدرضا رهنورد و بزرگداشت هزاران قربانی جمهوری اسلامی\u003cbr/\u003e\u003cbr/\u003eشهردار و دیگر مقامات شهرداری منطقۀ شانزدهم پاریس، با اجرای مراسمی یاد مجیدرضا رهنورد، و هزاران تن دیگر از کشته‌شدگان به‌دست حکومت جمهوری اسلامی را گرامی داشتند.\u003cbr/\u003eدر مراسمی که با حضور شماری از مقامات سیاسی و شهری پاریس برگزار شد، شهردار منطقۀ شانزدهم با اشاره به این که رژیم جمهوری اسلامی مانند حکومت «نازی‌های آلمان» علاوه بر قتل عام و اعدام شهروندان ایران، به کشورهای دیگر نیز آسیب می‌زند، تأکید کرد که در کنار مردم ایران ایستاده است.\u003cbr/\u003eدر جریان این مراسم که با نوازندگی موسیقی سنتی ایرانی همراه شد، ویدئویی ساختۀ مژگان عرفانی، به‌نمایش درآمد که در آن تصاویر صدها تن از قربانیان جمهوری اسلامی، از افسران و وزاری شاهنشاهی تا جان‌باختگان انقلاب شیر و خورشید، به‌تصویر کشیده شده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AC%DB%8C%D8%AF%D8%B1%D8%B6%D8%A7_%D8%B1%D9%87%D9%86%D9%88%D8%B1%D8%AF\"\u003e#مجیدرضا_رهنورد\u003c/a\u003e  \u003ca href=\"?q=%23%D9%87%D9%85%D8%A8%D8%B3%D8%AA%DA%AF%DB%8C\"\u003e#همبستگی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
