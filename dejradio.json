    {
      "id": 7202,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بخشش اضافه خدمت سربازان در ازای حفظ قرآن\u003cbr/\u003e\u003cbr/\u003eعلی شیرازی رئیس سازمان عقیدتی سیاسی فراجا اعلام کرده است که در صورت «حفظ یک جزء از قرآن یا فراگیری برخی احکام دینی» توسط سربازان، اضافه خدمت دوره سربازی اجباری آنها بخشیده می‌شود. \u003cbr/\u003e\u003cbr/\u003eکارشناسان نظامی می‌گویند، این اقدام بر خلاف اصول عدالت و برابری، تبعیض آشکاری را نسبت به شهروندان نامسلمان یا کسانی که به چنین معیارهایی باور ندارند، ایجاد می‌‌کند.\u003cbr/\u003e\u003cbr/\u003eبه نظر می‌رسد این اقدام راهی برای بازگرداندن سربازانی باشد که پس از قتل‌عام مردم در انقلاب ملی و شروع جنگ، ترک خدمت کردند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%DA%A9_%D8%AE%D8%AF%D9%85%D8%AA\"\u003e#ترک_خدمت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%81%D8%B8_%D9%82%D8%B1%D8%A2%D9%86\"\u003e#حفظ_قرآن\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%D8%A8%D8%A7%D8%B2%DB%8C\"\u003e#سربازی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
