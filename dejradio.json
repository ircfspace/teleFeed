    {
      "id": 7073,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e در شرایطی که خلبانان آمریکا و اسرائیل از پیشرفته‌ترین امکانات برای جنگ برخوردارند، مسعود جعفری، معاون هماهنگ‌کننده نیروی هوایی ارتش جمهوری اسلامی ایران، در گفت‌وگویی تلویزیونی اعلام کرد خلبانان ارتش، برای انجام ماموریت‌های منطقه‌ای بدون جی‌پی‌اس پرواز می‌کنند.\u003cbr/\u003e\u003cbr/\u003eاین اعتراف در حالی صورت می‌گیرد که اسفند ۱۴۰۴ با آغاز جنگ چهار خلبان سوخوهای نهاجا در ماموریت به سمت قطر هدف قرار گرفته و از بین رفتند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
