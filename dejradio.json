    {
      "id": 5969,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e علی خامنه‌ای نابود شد؛ مجتبی تو نفر بعدی هستی!\u003cbr/\u003e\u003cbr/\u003eشهروند معترض: \u0026#34;این حکومت مستبد و شرور، به باور من، همه چیز را باخته و در مسیر فروپاشی و نابودی قرار گرفته است. امیدوارم به‌زودی شاهد تحقق آرزوی دیرینه مردم ایران، یعنی آزادی میهن از سلطه این حکومت، باشیم.\u0026#34;\u003cbr/\u003eمحور سنندج–همدان\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%82%D9%88%D8%B7\"\u003e#سقوط\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
