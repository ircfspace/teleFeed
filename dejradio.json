    {
      "id": 9193,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eهشدار جدی آژانس درباره برنامه هسته‌ای جمهوری اسلامی؛ سرنوشت ذخایر اورانیوم و تأسیسات چهارم همچنان نامعلوم است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eآژانس بین‌المللی انرژی اتمی در تازه‌ترین گزارش خود نسبت به ادامه ابهام درباره وضعیت تأسیسات هسته‌ای و ذخایر اورانیوم غنی‌شده جمهوری اسلامی هشدار داد و اعلام کرد به دلیل نبود همکاری و دسترسی کافی،نمی‌تواند تأیید کند که مواد هسته‌ای اعلام‌شده ایران از فعالیت‌های صلح‌آمیز منحرف نشده‌اند.\u003cbr/\u003eبر اساس گزارش روز آدینه ۱۳نوامبر،آژانس از زمان حملات نظامی ژوئن ۲۰۲۵ تاکنون نتوانسته وضعیت بخش مهمی از تأسیسات آسیب‌دیده و ذخایر اورانیوم غنی‌شده را راستی‌آزمایی کند. این نهاد بین‌المللی وضعیت موجود را موجب نگرانی جدی درباره اشاعه تسلیحات هسته‌ای دانسته و خواستار رفع فوری محدودیت‌های بازرسی شده است.\u003cbr/\u003eیکی از مهم‌ترین ابهام‌های مطرح‌شده در این گزارش،سرنوشت تأسیسات چهارم غنی‌سازی جمهوری اسلامی موسوم به «کارخانه غنی‌سازی سوخت اصفهان» است؛ تأسیساتی که تهران در ژوئن ۲۰۲۵ موجودیت آن را اعلام کرد،اما تاکنون اجازه بازرسی از آن را نداده است.\u003cbr/\u003eآژانس تأکید کرده که هنوز از محل دقیق این تأسیسات،وضعیت عملیاتی آن و اینکه آیا مواد هسته‌ای در آن نگهداری می‌شود یا خیر،اطلاع تأییدشده‌ای ندارد. همچنین مشخص نیست فعالیت غنی‌سازی در این مجموعه آغاز شده است یا نه.\u003cbr/\u003eدر همین حال،نمایندگی جمهوری اسلامی در وین روز شنبه ۱۴نوامبر در واکنش به گزارش رافائل گروسی،قطعنامه‌های شورای حکام را از نظر فنی و حقوقی مخدوش توصیف کرد و اعلام کرد تا زمانی که شرایط کنونی ادامه داشته باشد،اجرای عادی تعهدات پادمانی و بازرسی‌های آژانس از سر گرفته نخواهد شد.\u003cbr/\u003eاین موضع‌گیری در حالی مطرح می‌شود که آژانس بار دیگر تأکید کرده است تعهدات پادمانی جمهوری اسلامی همچنان لازم‌الاجراست و تهران باید اطلاعات دقیق درباره وضعیت تأسیسات و ذخایر مواد هسته‌ای خود را در اختیار بازرسان قرار دهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D9%87_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#برنامه_اتمی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%BA%D9%86%DB%8C_%D8%B3%D8%A7%D8%B2%DB%8C\"\u003e#غنی_سازی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%DA%98%D8%A7%D9%86%D8%B3_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#آژانس_اتمی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
