    {
      "id": 6808,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eآمریکا شبکۀ مالی بابک زنجانی را هدف تحریم‌های تازه قرار داد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت خزانه‌داری آمریکا چهار فرد و ۹ نهاد مرتبط با شبکۀ مالی بابک زنجانی را به دلیل کمک به جمهوری اسلامی برای دورزدن تحریم‌ها، در فهرست تحریم‌های خود قرار داد.\u003cbr/\u003eبه گفتۀ این وزارتخانه، شبکۀ زنجانی از طریق شرکت‌های دارایی دیجیتال، تجارت طلا و سنگ‌های قیمتی و پروژه‌های حمل‌ونقل و زیرساختی، منابع مالی مورد نیاز حکومت و سپاه پاسداران را تأمین می‌کرد.\u003cbr/\u003eواشینگتن اعلام کرد این اقدام بخشی از تلاش گسترده‌تر برای محدودکردن منابع مالی برنامه‌های هسته‌ای و موشکی جمهوری اسلامی و فعالیت‌های منطقه‌ای سپاه پاسداران است. وزارت خزانه‌داری همچنین به دولت‌ها و مؤسسات مالی هشدار داد از همکاری با بابک زنجانی و شرکت‌های وابسته به او خودداری کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%A7%D8%A8%DA%A9_%D8%B2%D9%86%D8%AC%D8%A7%D9%86%DB%8C\"\u003e#بابک_زنجانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
