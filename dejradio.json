    {
      "id": 5647,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5839239365850568848\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9BA9.png\u0026#39;)\"\u003e\u003cb\u003e🛩️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسرائیل مواضع حزب‌الله در جنوب لبنان را بمباران کرد؛ هشدار تخلیه برای ده‌ها شهر و روستا\u003cbr/\u003e\u003cbr/\u003eارتش اسرائیل روز شنبه در پی صدور هشدار تخلیه برای چندین شهر و روستا در جنوب لبنان، حملات به مواضع شبه‌نظامیان حزب‌الله را در این مناطق ازسرگرفت.\u003cbr/\u003eبنا بر گزارش‌ها، جنگنده‌های اسرائیلی مواضع و امکانات حزب‌الله را در مناطقی از جمله روستای سجود و ریحان در نزدیکی نبطیه، هدف گرفتند.\u003cbr/\u003eارتش اسرائیل اعلام کرد این عملیات در واکنش به فعالیت‌های حزب‌الله و نقض آتش‌بس انجام می‌شود.\u003cbr/\u003e اسرائیل از ساکنان این مناطق خواسته که به شمال رود زهرانی بروند.\u003cbr/\u003eارتش همچنین از رهگیری دومین پهپاد نیروهای حزب‌الله در شبانه‌روز پیشین که به سوی خاک اسرائیل پرتاب شده بود، خبر داد.\u003cbr/\u003eارتش اسرائیل هشدار داد ادامۀ حملات پهپادی حزب‌الله می‌تواند دامنۀ درگیری را گسترش بدهد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B2%D8%A8_%D8%A7%D9%84%D9%84%D9%87\"\u003e#حزب_الله\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
