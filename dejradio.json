    {
      "id": 8251,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e دو جوان اهل سیستان و بلوچستان در جریان تعقیب‌وگریز نیروی نظامی در محدوده اسکله صیادی کنارک، پس از برخورد خودروی نیروی نظامی با موتورسیکلت آنان، به‌شدت مجروح شدند. \u003cbr/\u003e\u003cbr/\u003eبه گزارش شبکه اسناد حقوق بشر بلوچستان، روز چهارشنبه ۸ مهرماه ۱۴۰۵، نیروهای نظامی در جریان تعقیب یک موتورسیکلت در محدوده اسکله صیادی کنارک، با خودروی خود از پشت با این موتورسیکلت برخورد کردند که در پی آن، دو سرنشین آن به زمین افتاده و مجروح شدند.\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌های دریافتی، این دو جوان از ناحیه سر، دست و پا دچار جراحت شده و پس از حادثه، شهروندان حاضر در محل آنان را برای دریافت خدمات درمانی به مراکز درمانی منتقل کردند.\u003cbr/\u003e\u003cbr/\u003eمنابع اعلام‌ کردند، برخورد خودروی نیروهای نظامی با موتورسیکلت عمدی بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%DB%8C_%D8%A7%D9%86%D8%AA%D8%B8%D8%A7%D9%85%DB%8C\"\u003e#نیروی_انتظامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%DB%8C%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#سیستان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
