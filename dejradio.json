    {
      "id": 4575,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس گزارش‌های منابع محلی، یک نفت‌کش متعلق به جمهوری اسلامی که قصد خروج از محدوده محاصره دریایی آمریکایی را داشت توسط موشک هدف قرار گرفت. \u003cbr/\u003eتاریخ دقیق اصابت مشخص نیست اما گفته شده ۱۹ یا ۲۰ اردیبهشت اتفاق افتاده است. بر اساس تصاویر زبانه‌های آتش و دود سیاه غلیظ از قسمت انتهایی عرضه این نفتکش کاملا پیداست اما از خدمه کسی کشته نشده است. \u003cbr/\u003eنام این کشتی در گذشته «سنندج» بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%AA%D8%B4%D8%A8%D8%B3\"\u003e#آتشبس\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
