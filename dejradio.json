    {
      "id": 4509,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e منابع میدانی:\u003cbr/\u003eهیچکدام از موشک‌ها و پهپادهای نیروهای مسلح جمهوری اسلامی به ناوشکن‌های آمریکا اصابت نکرده است\u003cbr/\u003e\u003cbr/\u003eناوشکن‌های آمریکایی که برای اسکورت کشتی‌های تجاری بعد از عبور از تنگه هرمز وارد خلیج فارس شده بودند، پنجشنبه ۱۷ اردیبهشت از تنگه عبور کردند و وارد دریای عمان شدند. در هر دو بار تعدادی موشک کروز و بالستیک ضد کشتی و پهپاد انتحاری به سمت آنها شلیک شد اما هیچ کدام از آنها به ناوشکن‌ها اصابت نکرد و عملاً این حملات بی‌نتیجه بود زیرا سیستم‌های پدافنی این ناوشکن‌ها در بالاترین سطح با پرتابه‌ها مقابله کرد.\u003cbr/\u003e\u003cbr/\u003eبرخی منابع غیررسمی داخلی با انتقاد از عملکرد نیروهای مسلح جمهوری اسلامی گفته‌اند این وضعیت نه تنها موجب افزایش اعتماد به نفس آمریکایی‌ها و کشتی‌های تجاری برای عبور از تنگه شد بلکه آنها را برای ورود به جزایر و حتی سواحل جنوبی ایران راسخ‌تر می‌کند.\u003cbr/\u003e\u003cbr/\u003eسخنگوی قرارگاه خاتم‌الانبیا ادعا کرده بود نیروهای مسلح شناورهای نظامی آمریکا در شرق تنگه هرمز را «هدف» قرار دادند. این در حالیست که آمریکا حداقل دو نفتکش جمهوری اسلامی را که قصد داشتند از محاصره دریایی عبور کنند هدف قرار دادند. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
