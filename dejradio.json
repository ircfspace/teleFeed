    {
      "id": 5326,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بحران انرژی در هرمز، سبب گسترش همکاری بین ونزوئلا و هند می‌شود\u003cbr/\u003e\u003cbr/\u003eدلسی رودریگز، رئیس جمهوری موقت ونزوئلا، برای گفت‌وگو درمورد همکاری‌های انرژی به هندوستان سفر کرد.\u003cbr/\u003eرویترز گزارش داد مقامات دو کشور دربارۀ گسترش پروژه‌های تولید و پالایش نفت ونزوئلا مذاکره کردند.\u003cbr/\u003eهندوستان در ماه پیشین روزانه ۴۲۷ هزار بشکه نفت از ونزوئلا وارد کرد و به دومین مشتری بزرگ نفت این کشور تبدیل شد.\u003cbr/\u003eمقام‌های هندی می‌گویند افزایش واردات نفت ونزوئلا، بخشی از فشار ناشی از اختلال تنگۀ هرمز را جبران کرده است.\u003cbr/\u003eرودرندرا تاندون، مقام وزارت خارجۀ هندوستان گفت ونزوئلا هند را شریک اصلی خود در حوزۀ انرژی می‌داند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%86%D8%B1%DA%98%DB%8C\"\u003e#انرژی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
