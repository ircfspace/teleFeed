    {
      "id": 5964,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e  صادرات نفت از کشورهای خلیج فارس ۵۰ درصد افزایش یافت\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eآژانس جهانی انرژی اعلام کرد صادرات نفت کشورهای حوزۀ خلیج فارس در ماه جاری میلادی نسبت به ماه پیشین درحدود ۵۰ درصد افزایش یافته است.\u003cbr/\u003eبر اساس این گزارش، صادرات روزانه نفت و فرآورده‌های نفتی کشورهای عرب‌نشین حوزۀ خلیج فارس، از کمتر از ۱۰ میلیون بشکه در ماه پیشین اکنون به حدودا ۱۵ میلیون بشکه در روز رسیده است\u003cbr/\u003eاین رقم همچنان پایین‌تر از سطح صادرات پیش از انسداد تنگۀ هرمز توسط سپاه است.\u003cbr/\u003eپیش از آغاز جنگ چهل روزه، روزانه درحدود ۲۵ میلیون بشکه نفت و فرآورده‌های نفتی از کشورهای منطقه صادر می‌شد.\u003cbr/\u003eآژانس جهانی انرژی همچنین اعلام کرد تولید نفت و فرآورده‌های نفتی در ایران که در پی جنگ و محاصرۀ دریایی آمریکا از حدود پنج میلیون بشکه در روز به ۳.۳ میلیون بشکه کاهش یافته بود، در ماه جاری به حدود ۳.۸ میلیون بشکه در روز رسیده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D9%84%DB%8C%D8%AC_%D9%81%D8%A7%D8%B1%D8%B3\"\u003e#خلیج_فارس\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
