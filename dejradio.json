    {
      "id": 5331,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e قیمت نفت برنت به ۹۷ دلار نزدیک شد\u003cbr/\u003e\u003cbr/\u003eبهای هر بشکه نفت برنت دریای شمال در معاملات صبح پنج‌شنبۀ آسیا به درحدود ۹۷ دلار برای هر بشکه رسید.\u003cbr/\u003eحملات جمهوری اسلامی به کویت و بحرین و درگیری‌های تازۀ آمریکا و جمهوری اسلامی در جنوب ایران، بازار نفت را بازهم متلاطم کرد.\u003cbr/\u003eتحلیلگران انتظار دارند توافق آتش‌بس لبنان و اسرائیل، مانع شود که بهای نفت برنت در روزهای آخر هفته از مرز ۱۰۰ دلا عبور کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%81%D8%AA\"\u003e#نفت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
