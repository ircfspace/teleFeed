    {
      "id": 6526,
      "message": "\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e فرماندهی مرکزی ایالات متحده، سنتکام، اعلام کرد آخرین موج حملات نیروهای آمریکایی علیه جمهوری اسلامی، شامگاه چهارشنبه ۱۵ژوئیه، ساعت ۹شب به وقت شرق آمریکا، به پایان رسیده است.\u003cbr/\u003eبه گفتۀ سنتکام، در این عملیات مراکز فرماندهی، سامانه‌های پدافند هوایی، توانمندی‌های موشکی و پهپادی و همچنین تأسیسات پایش ساحلی جمهوری اسلامی هدف حملات دقیق قرار گرفت تا توانایی تهران برای تهدید کشتی‌های تجاری عبوری از تنگه هرمز بیش از پیش کاهش یابد.\u003cbr/\u003eسنتکام افزود در این حملات از مهمات هدایت‌شونده دقیق استفاده شده و اهدافی در چندین منطقه، از جمله بندرعباس، مورد اصابت قرار گرفته‌اند.\u003cbr/\u003eاین فرماندهی همچنین اعلام کرد نیروهای آمریکایی بامداد همان روز، در عملیاتی ۹۰دقیقه‌ای، مواضع دفاع ساحلی و سایت‌های موشک کروز در جزیره تنب بزرگ را هدف قرار داده‌اند.\u003cbr/\u003eسنتکام در پایان تأکید کرد ارتش ایالات متحده به دستور رئیس‌جمهوری آمریکا، جمهوری اسلامی را در قبال اقداماتش پاسخگو خواهد کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87\"\u003e#حمله\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
