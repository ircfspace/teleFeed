    {
      "id": 8516,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس تصاویر ماهواره‌ای، پایگاه هفتم شکاری شیراز که در جنگ ایران و عراق نقش اساسی در ماموریت‌های نیروی هوایی داشت، در جنگ ۴۰ روزه به یک دخمه ویرانه تبدیل شده است.\u003cbr/\u003e\u003cbr/\u003eهواپیمای ترابری سی‌-۱۳۰، آشیانه‌ها و انبارهایی که منهدم شدند، تصویری از وضعیت کنونی نیروی هوایی جمهوری اسلامی است، چون اوضاع پایگاه‌های تبریز و همدان هم از این بهتر نیست.\u003cbr/\u003e\u003cbr/\u003eدو فروند جنگنده‌بمب‌افکن سوخو که برای هدف قراردادن پایگاه آمریکا به قطر اعزام شده و دیگر بازنگشتند، از این پایگاه برخاسته بودند. \u003cbr/\u003eدر آن ماموریت یک خلبان آن کشته و سه خلبان دیگر مفقود شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%DB%8C%D8%B1%D8%A7%D8%B2\"\u003e#شیراز\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
