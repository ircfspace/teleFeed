    {
      "id": 5859,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  رافائل گروسی در لوسرن سوئیس؛ رسانۀ نزدیک به سپاه انکار کرد\u003cbr/\u003e\u003cbr/\u003eرافائل گروسی، مدیرکل آژانس جهانی انرژی اتمی، از دیدار با ایگناسیو کاسیس، وزیر امور خارجۀ سوئیس، در حاشیۀ نشست لوسرن خبر داد.\u003cbr/\u003eمدیرکل آژانس جهانی انرژی اتمی، همزمان با سفر هیئت اعزامی جمهوری اسلامی به محل نشست لوسرن رفته است.\u003cbr/\u003eگروسی گفت هدف از دیدار با مقام سوئیسی، بررسی تحولات اخیر مربوط به جمهوری اسلامی، مسیر پیش رو و نقش آژانس در روند دیپلماتیک بود.\u003cbr/\u003eپیش از این دیدار، عباس عراقچی، وزیر امور خارجۀ جمهوری اسلامی نیز با همتای سوئیسی خود دیدار کرده بود.\u003cbr/\u003eحضور گروسی در مکان مذاکرات، در حالی است که مقامات رژیم مدعی‌اند فعلا در مورد مسائل هسته‌ای گفت‌وگویی انجام نمی‌شود.\u003cbr/\u003eاز سویی انتشار تصاویر این دیدارها در حالی صورت گرفته که برخی رسانه‌های نزدیک به سپاه پاسداران مدعی‌اند گروسی در محل مذاکرات حضور ندارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%AF%D8%B1%D9%88%D8%B3%DB%8C\"\u003e#گروسی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%88%D8%A6%DB%8C%D8%B3\"\u003e#سوئیس\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
