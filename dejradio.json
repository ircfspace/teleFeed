    {
      "id": 6860,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس آمار منابع غیررسمی بعد از جنگ ۱۲ و ۴۰ روزه موارد خـ.ـودزنی و خـ.ـودکـ.ــشی در بین نظامیان جمهوری اسلامی افزایش پیدا کرد. \u003cbr/\u003e\u003cbr/\u003eهاجر براتی روانپزشک می‌گوید، فرسودگی، خستگی، ناامیدی و طولانی شدن جنگ از عواملی است که روحیه نیروهای مسلح را تضعیف می‌کند و باعث می‌شود آنها به زندگی خود پایان دهند.\u003cbr/\u003e\u003cbr/\u003eبه گفته او عدم بازیابی روحی و جسمی، استرس دائمی ناشی از حذف فرماندهان ارشد و خطر همیشگی مرگ از دلایل افزایش این آمار است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AA%D8%B1%D8%B3\"\u003e#استرس\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D9%88%D8%AF%DA%A9%D8%B4%DB%8C\"\u003e#خودکشی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
