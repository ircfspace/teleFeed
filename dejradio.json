    {
      "id": 8981,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eرایزنی‌های فشرده شاهزاده رضا پهلوی در پارلمان اروپا؛ از تشدید تحریم‌ها تا حمایت از اینترنت آزاد برای ایرانیان\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی در جریان سفر خود به بروکسل،با شماری از مقام‌های ارشد پارلمان اروپا دیدار و درباره راهکارهای عملی حمایت از مبارزات مردم ایران برای پایان دادن به جمهوری اسلامی و استقرار دموکراسی گفت‌وگو کرد.\u003cbr/\u003eشاهزاده رضا پهلوی روز سه‌شنبه با ژنرال کریستوف گومار،نایب‌رئیس کمیته امنیت و دفاع پارلمان اروپا،دیدار کرد و ضمن قدردانی از حمایت مستمر او از مبارزات مردم ایران و احترامش به تمدن ایرانی،درباره راهکارهای عملی حمایت از ایرانیان،از جمله حفظ دسترسی آنان به اینترنت،به تبادل نظر پرداخت.\u003cbr/\u003eاو همچنین با فرانسوا گزاویه بلامی،از مقام‌های ارشد حزب مردم اروپا،دیدار کرد. شاهزاده رضا پهلوی پس از این دیدار از تعهد جدی بلامی برای کمک به مردم ایران در مسیر بازپس‌گیری کشور از جمهوری اسلامی و برقراری دموکراسی پایدار قدردانی کرد.\u003cbr/\u003eبر اساس اعلام شاهزاده رضا پهلوی،قرار است روز چهارشنبه این دو در یک نشست خبری مشترک در پارلمان اروپا درباره ضرورت اقدام اروپا در حمایت از مردم ایران و راهکارهای عملی آن سخن بگویند.\u003cbr/\u003eشاهزاده رضا پهلوی همچنین با دیوید مک‌آلیستر،رئیس کمیته امور خارجی پارلمان اروپا،دیدار و درباره مجموعه‌ای از اقدامات احتمالی اتحادیه اروپا،از تشدید تحریم‌ها علیه جمهوری اسلامی تا حمایت از دسترسی ایرانیان به اینترنت،گفت‌وگو کرد.\u003cbr/\u003eاو مک‌آلیستر را دوست واقعی آرمان مردم ایران توصیف کرد و از تعهد او به آزادی و دموکراسی در ایران قدردانی کرد.\u003cbr/\u003eاین دیدارها در چارچوب تلاش‌های دیپلماتیک شاهزاده رضا پهلوی برای جلب حمایت عملی نهادهای اروپایی از مبارزات مردم ایران انجام شده و محور اصلی آن،تبدیل حمایت‌های سیاسی به اقدامات مشخص علیه جمهوری اسلامی و در پشتیبانی از مردم ایران است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A8%D8%B1%D9%88%DA%A9%D8%B3%D9%84\"\u003e#بروکسل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
