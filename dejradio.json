    {
      "id": 6944,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e هجوم صدها پناهجوی مسلمان آفریقایی به سواحل اسپانیا\u003cbr/\u003e\u003cbr/\u003eصدها پناهجوی مسلمان آفریقایی از مراکش وارد منطقه خودمختار «سبته» اسپانیا شدند. \u003cbr/\u003e\u003cbr/\u003eاین شهر بخشی از خاک اسپانیا است اما در ساحل شمالی آفریقا قرار دارد و تنها مرز زمینی آن با کشور مراکش است. \u003cbr/\u003e\u003cbr/\u003eمنابع اسپانیایی گزارش دادند روز پنجشنبه هشتم امرداد ۱۴۰۵ بین دو تا سه هزار پناهجو وارد این شهر شدند. پلیس نتوانست جلوی آنها را بگیرد.\u003cbr/\u003eمهاجران «به‌صورت گسترده از راه دریا و زمین» و از مسیر موج‌شکن تاراخال وارد شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%BE%D9%86%D8%A7%D9%87%D8%AC%D9%88\"\u003e#پناهجو\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B3%D9%84%D9%85%D8%A7%D9%86\"\u003e#مسلمان\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D9%BE%D8%A7%D9%86%DB%8C%D8%A7\"\u003e#اسپانیا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
