    {
      "id": 4993,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5998861151096544852\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8C90.png\u0026#39;)\"\u003e\u003cb\u003e🌐\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e نت‌بلاکس اعلام کرد با وجود بازگشت نسبی، اختلال گستردۀ اینترنت در ایران ادامه دارد\u003cbr/\u003e\u003cbr/\u003eنت‌بلاکس روز سه‌شنبه اعلام کرد داده‌های مستقیم نشان داد  اتصال به اینترنت در ایران به صورت نسبی برقرار شده است.\u003cbr/\u003eاین نهاد جهانی پایش اینترنت از سویی نوشت با وجود ابلاغ مصوبۀ بازگشت اینترنت از سوی مسعود پزشکیان، اختلال گسترده در ایران همچنان ادامه دارد.\u003cbr/\u003eنت‌بلاکس گزارش داد ایران وارد هشتادوهشتمین روز «خاموشی دیجیتال» شده و بیش از ۲۰۸۸ ساعت انزوای ارتباطی را سپری کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D9%86%D8%AA%D8%B1%D9%86%D8%AA\"\u003e#اینترنت\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
