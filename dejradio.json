    {
      "id": 5820,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eحملات تازۀ اسرائیل به مواضع حزب‌الله در جنوب لبنان\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003e واکنش اسرائیل به حملات پهپادی حزب‌الله در روز آدینه دستکم ۱۶ کشته بر جا گذاشت.\u003cbr/\u003eبر پایۀ گزارش‌ها، چندین منطقه در استان نبطیۀ لبنان در فاصلۀ شامگاه پنج‌شنبه تا بامداد آدینه، هدف چند موج حملۀ هوایی ارتش اسرائیل قرار گرفت.\u003cbr/\u003eارتش اسرائیل اعلام کرد این عملیات را در پاسخ به «نقض‌های مکرر آتش‌بس» از سوی حزب‌الله انجام داده است.\u003cbr/\u003eبر اساس بیانیۀ ارتش اسرائیل، حملات علیه نیروها و زیرساخت‌های حزب‌الله در جنوب لبنان در طول شامگاه گذشته ادامه یافت.\u003cbr/\u003eدر پی برخورد بمب نیروهای حزب‌الله به یک تانک ارتش اسرائیل، چهار تن از نظامیان این کشور جان باخته‌اند.\u003cbr/\u003eاین حملات تنها یک روز پس از امضای تفاهمنامه میان جمهوری اسلامی و آمریکا انجام شده است.\u003cbr/\u003eدر نخستین بند این تفاهمنامه اعلام شده که به درگیری‌ در همۀ جبهه‌ها از جمله لبنان پایان داده می‌شود.\u003cbr/\u003eاسرائیل اعلام کرده به تفاهمنامۀ میان تهران و واشینگتن پایبند نیست و در برابر حملات حزب‌الله، از امنیت خود  مراقبت می‌کند.\u003cbr/\u003eحزب‌الله که توسط جمهوری اسلامی پشتیبانی و هدایت می‌شود، در سیاهۀ تروریستی آمریکا قرار دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e  \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
