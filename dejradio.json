    {
      "id": 6593,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5949629152163271756\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e دو مأمور نیروی انتظامی سپیده‌دم شنبه ۲۷ تیرماه ۱۴۰۵ در درگیری مسلحانه در شهرستان بویراحمد کشته شدند. \u003cbr/\u003e\u003cbr/\u003eساعت ۵.۳۰ بامداد ماموران پاسگاه دمچنار برای بازداشت عاملان یک درگیری، به منطقه عشایری «زنگوا» اعزام شدند اما به محض اینکه از ماشین پیاده شدند به سمت آنان تیراندازی شد. \u003cbr/\u003e\u003cbr/\u003eدر این حادثه، ستوان‌یکم رحمت‌الله سجادی‌مهر از ناحیه پیشانی هدف اصابت گلوله قرار گرفته بود. ادعا شد ضاربان دستگیر شدند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%88%DB%8C%D8%B1%D8%A7%D8%AD%D9%85%D8%AF\"\u003e#بویراحمد\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%B1%DA%AF%DB%8C%D8%B1%DB%8C_%D9%85%D8%B3%D9%84%D8%AD%D8%A7%D9%86%D9%87\"\u003e#درگیری_مسلحانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D9%85%DA%86%D9%86%D8%A7%D8%B1\"\u003e#دمچنار\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
