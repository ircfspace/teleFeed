    {
      "id": 8354,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5785322240497160767\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87BAF09F87B8.png\u0026#39;)\"\u003e\u003cb\u003e🇺🇸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسنتکام: ۱۳۰ کشتی در اجرای محاصره دریایی جمهوری اسلامی تغییر مسیر داده‌اند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eفرماندهی مرکزی آمریکا، سنتکام، اعلام کرد نیروهای این فرماندهی روز ۵ اکتبر در ادامه اجرای محاصره دریایی جمهوری اسلامی، \u003cb\u003eصدوسی‌امین کشتی تجاری\u003c/b\u003e را در خاورمیانه وادار به تغییر مسیر کرده‌اند.\u003cbr/\u003eبراساس بیانیه سنتکام، اجرای این محاصره از ۱۴ ژوئیه به دستور رئیس‌جمهوری آمریکا از سر گرفته شده و تاکنون علاوه بر تغییر مسیر ۱۳۰ کشتی، \u003cb\u003eسه شناور که از اجرای دستورات سرپیچی کرده‌اند از کار انداخته شده‌اند\u003c/b\u003e.\u003cbr/\u003eسنتکام همچنین اعلام کرد طی ۱۲ هفته گذشته \u003cb\u003e۱۳ کشتی تجاری\u003c/b\u003e را که در حال نقض محاصره یا بخشی از «شبکه سایه چندمیلیارد دلاری سپاه پاسداران» بوده‌اند، منهدم کرده است.\u003cbr/\u003eدریاسالار برد کوپر، فرمانده سنتکام، هشدار داد نیروهای آمریکایی علیه هر شناوری که برای شکستن محاصره تلاش کند «به‌سرعت اقدام خواهند کرد» و تأکید کرد مأموریت اجرای محاصره با شدت ادامه دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%AD%D8%A7%D8%B5%D8%B1%D9%87_%D8%AF%D8%B1%DB%8C%D8%A7%DB%8C%DB%8C\"\u003e#محاصره_دریایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%B7%D8%B1%D8%AF_%D8%A7%D9%82%D8%AA%D8%B5%D8%A7%D8%AF%DB%8C\"\u003e#طرد_اقتصادی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
