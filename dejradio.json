    {
      "id": 6299,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e حمایت دانشگاهیان و بنیاد آکادمیک میترا از حضور شاهزاده رضا پهلوی در پارلمان هلند\u003cbr/\u003e\u003cbr/\u003eدانشگاهیان، اساتید دانشگاه‌ها و اعضای بنیاد آکادمیک میترا در هلند، هم‌زمان با حضور شاهزاده رضا پهلوی در پارلمان این کشور، در کنار دیگر ایرانیان آزادی‌خواه در همایش میهن‌پرستان هلند حضور داشتند و بر حمایت خود از رهبری ایشان و مطالبات مردم ایران تأکید کردند. \u003cbr/\u003eبنیاد میترا پیش از برگزاری این دیدار نیز با راه‌اندازی دادخواستی در حمایت از حفظ دعوت شاهزاده رضا پهلوی به پارلمان هلند، توانست در کمتر از ۴۸ ساعت نزدیک به ۱۳۰۰ امضا جمع‌آوری و آن را به نمایندگان پارلمان ارائه کند.\u003cbr/\u003e\u003cbr/\u003eدر گفت‌وگو با دکتر هادی میرگل‌بابایی، دکتر بابک رضایی و دکتر احسان صادقی، بر ضرورت رساندن صدای واقعی مردم ایران به نهادهای اروپایی، تقویت ارتباط با دانشگاهیان و نسل جوان، و معرفی دقیق‌تر خواسته‌های ملت ایران در عرصه بین‌المللی تأکید شد.\u003cbr/\u003e\u003cbr/\u003eبنیاد میترا (شیروخورشید هلند) به ابتکار جمعی از کنشگران دانشجویی، دانشگاهیان و کنشگران جنبش آکادمیک نسل جوان ایرانی در هلند شکل گرفت. هدف این بنیاد، ایجاد شبکه‌ای منسجم از نسل جوان ایرانی برای آگاهی‌رسانی درباره وضعیت ایران، برقراری ارتباط با جامعه دانشگاهی و نهادهای تصمیم‌گیر هلند و رساندن صدای مردم ایران به افکار عمومی و سیاستمداران این کشور است.\u003cbr/\u003e\u003cbr/\u003eاین بنیاد فعالیت خود را از دانشگاه‌ها آغاز کرده و با برگزاری نشست‌ها و کنفرانس‌های تخصصی، به معرفی انقلاب ملی ایران، نقش شاهزاده رضا پهلوی، پروژه شکوفایی ایران و چشم‌انداز ایران پس از جمهوری اسلامی می‌پردازد. این بنیاد همچنین در قالب میز دانشجویی سازمان نسل Z، در کنار دیگر فعالان ملی برای تقویت جنبش دانشجویی حامی انقلاب ملی ایران فعالیت می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%DB%8C%D8%A7%D8%AF_%D9%85%DB%8C%D8%AA%D8%B1%D8%A7\"\u003e#بنیاد_میترا\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF\"\u003e#شیروخورشید\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
