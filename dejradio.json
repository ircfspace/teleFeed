    {
      "id": 5960,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e عملیات خروج اسناد هسته‌ای از ایران در آفریقا تمرین شده بود\u003cbr/\u003e\u003cbr/\u003eیوسی کوهن، رئیس پیشین موساد، سازمان اطلاعات خارجی اسرائیل، در کتاب خود با عنوان «شمشیر آزادی» فاش کرد سازمان تحت مدیریت او، پیش از آغاز عملیات خروج اسناد هسته‌ای از «تورقوزآباد»؛ عملیاتی که به خروج دونالد ترامپ از برجام و فراهم شدن زمینه حمله نظامی به جمهوری اسلامی انجامید، این مأموریت را در یکی از کشورهای آفریقایی با استفاده از ماکت‌هایی در ابعاد واقعی به‌طور کامل تمرین کرده بود.\u003cbr/\u003e\u003cbr/\u003eتوانایی ده‌ها مأمور موساد در نفوذ به تأسیسات به‌شدت حفاظت‌شده بایگانی اسناد هسته‌ای جمهوری اسلامی، بدون آنکه هیچ‌گونه هشدار یا زنگ خطری به صدا درآید یا مقام‌های رژیم در طول ۶ ساعت و ۲۹ دقیقه حضور آن‌ها در محل و حتی حدود دو ساعت پس از آن از این عملیات آگاه شوند، این امکان را برای آنان فراهم کرد که قفسه‌های کامل حاوی اسناد اصلی برنامه هسته‌ای را با خود خارج کنند و تمامی اعضای تیم نیز بدون هیچ آسیبی از محل بگریزند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B3%D8%A7%D8%AF\"\u003e#موساد\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D9%86%D8%A7%D8%AF_%D9%85%D8%AD%D8%B1%D9%85%D8%A7%D9%86%D9%87\"\u003e#اسناد_محرمانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%82%D9%88%D8%B2%D8%A2%D8%A8%D8%A7%D8%AF\"\u003e#تورقوزآباد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
