    {
      "id": 5910,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eاختلال گسترده در خدمات چند بانک بزرگ ایران در پی حملۀ سایبری\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eخدمات بانکی چند بانک بزرگ در ایران روز سه‌شنبه بار دیگر دچار اختلال گسترده شد.\u003cbr/\u003eبر پایۀ گواهی شماری از کاربران و گزارش رسانه‌های داخلی، خدمات پرداخت الکترونیک، انتقال وجه و برخی سرویس‌های بانکی در بانک‌های ملی، تجارت، صادرات و ملت دچار اختلال است.\u003cbr/\u003eخبرگزاری‌ حکومتی فارس به نقل از منابع خود از احتمال حملۀ سایبری به زیرساخت‌های پشتیبان شبکۀ بانکی گزارش داد.\u003cbr/\u003eشرکت خدمات انفورماتیک نیز با انتشار بیانیه‌ای اعلام کرد حملات سایبری علیه سامانه‌های این شرکت شناسایی شده است.\u003cbr/\u003eاین نهاد مدعی شد برای «جلوگیری از دسترسی غیرمجاز و حفاظت از اطلاعات و دارایی‌های مشتریان» بخشی از خدمات مبتنی بر کارت، فعلا از دسترس خارج شده است.\u003cbr/\u003eاین دومین اختلال گسترده در شبکۀ بانکی ایران طی درحدود دو هفتۀ اخیر به‌شمار می‌رود.\u003cbr/\u003e در اواسط خرداد نیز چند بانک ایرانی با اختلالات مشابه مواجه شده بودند.\u003cbr/\u003eتاکنون هیچ گروه یا کشوری مسئولیت این حملات را برعهده نگرفته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%AE%D8%AA%D9%84%D8%A7%D9%84_%D8%A8%D8%A7%D9%86%DA%A9%DB%8C\"\u003e#اختلال_بانکی\u003c/a\u003e  \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%B3%D8%A7%DB%8C%D8%A8%D8%B1%DB%8C\"\u003e#حمله_سایبری\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
