    {
      "id": 4796,
      "message": "\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e میانجی‌گری اسلام‌آباد بخشی از توافق مالی پنهان با تهران است\u003cbr/\u003e\u003cbr/\u003eبه گزارش کانال ۱۴ اسرائیل، تلاش‌ پاکستان برای میانجی‌گری میان تهران و واشینگتن، بخشی از یک توافق مالی محرمانه با جمهوری اسلامی است.\u003cbr/\u003eبراساس این گزارش، اسلام‌آباد به ازای پشتیبانی از مواضع تهران در مذاکرات، امیدوار است پس از کاهش تحریم‌ها از کمک مالی جمهوری اسلامی برای مدیریت بدهی‌های خارجی خود بهره‌مند شود.\u003cbr/\u003eاین رسانۀ اسرائیلی اعلام کرد پاکستان با بیش از یک‌صد میلیارد دلار بدهی خارجی روبه‌رو شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D9%BE%D8%A7%DA%A9%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#پاکستان\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
