    {
      "id": 4987,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e نتانیاهو و کاتز نشستی امنیتی با محور جمهوری اسلامی و لبنان برگزار کردند\u003cbr/\u003e\u003cbr/\u003eبنا بر گزارش الجزیرۀ قطر، بنیامین نتانیاهو، نخست‌وزیر اسرائیل، و یسرائیل کاتز، وزیر دفاع این کشور روز سه‌شنبه نشست‌هایی امنیتی را درمورد جبهه‌های نبرد با لبنان و جمهوری اسلامی برگزار کردند.\u003cbr/\u003eاز سویی ایتامار بن‌گویر، وزیر امنیت داخلی اسرائیل اعلام کرد این کشور اجازه نمی‌دهد ترامپ توافقی بد با جمهوری اسلامی امضا کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
