    {
      "id": 5915,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003e از سرنوشت ۷۰۰ میلیون دلار بودجۀ ویژۀ واردات دارو خبری دردست نیست\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eیک عضو کمیسیون بهداشت مجلس شورای اسلامی اعلام کرد نمایندگان مجلس از سرنوشت ۷۰۰ میلیون دلار بودجۀ تخصیص‌یافته برای واردات دارو آگاهی ندارند.\u003cbr/\u003eروح‌الله لک علی‌آبادی گفت پیش‌تر یک میلیارد دلار از صندوق توسعۀ ملی برای تأمین دارو اختصاص یافته بود.\u003cbr/\u003eبه گفته او، حدود ۳۰۰ میلیون دلار از این مبلغ هزینه شده اما مشخص نیست ۷۰۰ میلیون دلار باقی‌مانده در چه مسیری مصرف شده است.\u003cbr/\u003eاین نمایندۀ مجلس گفت قرار است مسئولان سازمان غذا و دارو در آینده توضیحات رسمی دربارۀ سرنوشت این منابع ارائه کنند.\u003cbr/\u003eاظهارات این مقام رسمی رژیم در حالی مطرح شده که مقام‌های جمهوری اسلامی در ماه‌های پیشین کمبود برخی داروها را به تحریم‌ها و اختلال در واردات مرتبط کرده بودند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%AE%D8%AA%D9%84%D8%A7%D8%B3\"\u003e#اختلاس\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%B2%D8%AF%DB%8C\"\u003e#دزدی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%A7%D8%B1%D9%88\"\u003e#دارو\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
