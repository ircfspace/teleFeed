    {
      "id": 5643,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e جمهوری اسلامی دستور توقیف اموال ۱۰۰ شهروند دیگر را در اصفهان صادر کرد\u003cbr/\u003e\u003cbr/\u003eرئیس کل دادگستری اصفهان از صدور دستور شناسایی و توقیف اموال ۱۰۰ شهروند به اتهام آنچه «همکاری با دشمن» نامید، خبر داد.\u003cbr/\u003eاین اقدام در ادامۀ موج تازۀ برخوردهای قضایی و مالی جمهوری اسلامی علیه منتقدان، فعالان و مخالفان حکومت انجام می‌شود.\u003cbr/\u003eپیش‌تر سخنگوی قوه قضاییه اعلام کرده بود بیش از ۳۱۰۰ نفر در این راستا تحت تعقیب قرار گرفته‌اند.\u003cbr/\u003eدستگاه قضائی جمهوری اسلامی همچنین از بازداشت بیش از ۲۴۰۰ نفر و توقیف اموال صدها تن از شهروندان خبر داده بود.\u003cbr/\u003e نهادهای حقوق بشری می‌گویند این روند بخشی از فشار اقتصادی و قضائی رژیم علیه مخالفان برای ساکت کردن آنها است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D8%A7%D8%AC%DA%AF%DB%8C%D8%B1%DB%8C\"\u003e#باجگیری\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
