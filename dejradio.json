    {
      "id": 5354,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e رافائل گروسی، مدیرکل آژانس بین‌المللی انرژی اتمی، روز جمعه ۱۵ خرداد اعلام کرد که دسترسی بازرسان آژانس به تأسیسات هسته‌ای جمهوری اسلامی همچنان محدود است و تهران در تعیین محل‌های بازرسی نقش تعیین‌کننده دارد.\u003cbr/\u003e\u003cbr/\u003eگروسی در یک نشست خبری گفت که پس از جنگ ۱۲ روزه و همچنین رخدادهای نظامی اخیر، تلاش‌های متعددی برای ازسرگیری فعالیت‌های راستی‌آزمایی در ایران انجام شده است. به گفته او، جمهوری اسلامی متعهد به اطلاع‌رسانی و فراهم کردن دسترسی برای بازرسان است، اما شرایط جنگی مانع اجرای کامل این تعهدات شده بود.\u003cbr/\u003e\u003cbr/\u003eمدیرکل آژانس افزود که با وجود برقراری آتش‌بس، آژانس تنها توانسته در برخی مراکز مورد تأیید تهران، از جمله نیروگاه هسته‌ای بوشهر و چند تأسیسات دیگر، فعالیت‌های نظارتی انجام دهد.\u003cbr/\u003e\u003cbr/\u003eگروسی تأکید کرد که جمهوری اسلامی همچنان در عمل تعیین می‌کند بازرسان چه بخش‌هایی را ببینند و چه بخش‌هایی را نبینند. او در عین حال یادآور شد که تعهدات حقوقی ایران در قبال آژانس، صرف‌نظر از شرایط، پابرجاست و باید اجرا شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%A3%D8%B3%DB%8C%D8%B3%D8%A7%D8%AA_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#تأسیسات_اتمی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
