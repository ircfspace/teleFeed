    {
      "id": 7991,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e تجمع «جانفدایان» که شنبه ۲۷ شهریور ۱۴۰۵ در تهران برگزار شد، حواشی زیادی داشت. حکومت برای «نمایش قدرت» هر چه توانسته بود سیاهی‌لشکر مسلح به خیابان آورد تا بگوید انبوهی هوادار دارد.\u003cbr/\u003eدر میان جانفداهای شیعی بوسه دو پرستوی جانفدا عضو گردان‌های امنیتی ۶۰۵ تَرک موتور که چفیه بسته بودند و کلاشنیکف بدست داشتند حاشیه ساز شد.\u003cbr/\u003eظهور نسل جدیدی از مردان و زنان نظام که هم به حسین و کربلا و دین علاقمندند، همه به جنس موافق از باجناغ گرفته تا همسنگر.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D9%86%D9%81%D8%AF%D8%A7\"\u003e#جانفدا\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B2%D8%AF%D9%88%D8%B1\"\u003e#مزدور\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
