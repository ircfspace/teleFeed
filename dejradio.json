    {
      "id": 5903,
      "message": "‌\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک منبع امنیتی به دژ می‌گوید پس از اعلام «آتش‌بس موقت»، با آغاز مذاکرات اسلام‌آباد میان جمهوری اسلامی و آمریکا با میانجیگری پاکستان، تهدیدات داخلی و خارجی علیه محمدباقر قالیباف به عنوان عضو ارشد تیم مذاکرات آغاز شد، اما همزمان با حضور او در زوریخ برای مذاکره با جی‌دی‌ ونس او و خانواده‌اش از سوی حامیان متعصب نظام و مخالفان داخلی توافق با آمریکا به مرگ تهدید شده‌اند. برهمین اساس تیم‌های محافظتی او و خانواده‌اش تقویت شده‌اند.\u003cbr/\u003e\u003cbr/\u003eاز نگاه بخش بزرگی از طرفداران جمهوری اسلامی، قالیباف «خائن» است زیرا بعد از قتل علی خامنه‌ای و جمعی از فرماندهان ارشد سـ.ـپاه و نیروهای میدانی، به جای انتقام پای میز مذاکره نشسته است و به دنبال تسلیم نظام در برابر آمریکاست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A2%D8%AA%D8%B4%D8%A8%D8%B3\"\u003e#آتشبس\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D9%85%D8%AF%D8%A8%D8%A7%D9%82%D8%B1_%D9%82%D8%A7%D9%84%DB%8C%D8%A8%D8%A7%D9%81\"\u003e#محمدباقر_قالیباف\u003c/a\u003e  \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
