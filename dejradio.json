    {
      "id": 6016,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E29ABD.png\u0026#39;)\"\u003e\u003cb\u003e⚽️\u003c/b\u003e\u003c/i\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شعار در سیاتل:\u003cbr/\u003eذرت و جو آوردن، رهبرشونو بردن\u003cbr/\u003e\u003cbr/\u003eگروهی از ایرانیان میهن‌دوست که در استادیوم سیاتل به تماشای مسابقه فوتبال تیم مصر و جمهوری اسلامی رفته بودند، با اشاره به مذاکرات و «توافق» اولیه حکومت با دولت ترامپ برای واردات محصولات کشاورزی آمریکایی در ازای پول‌های بلوکه شده و کشته شدن خامنه‌ای در جنگ، شعار دادند: «ذرت و جو آوردن، رهبرشونو بردن.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
