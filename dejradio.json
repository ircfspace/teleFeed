    {
      "id": 4515,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e منابع دژ گزارش دادند که ماموران امنیتی، پس از دستیابی به پرونده شماری از دانش‌آموزان دبیرستان دخترانه «شرافت» در تهران منطقه ۱۳، به صورت تلفنی آنها را تهدید جنسی کرده‌اند.\u003cbr/\u003eخانواده این دانش‌آموزان نگران از وضعیت فرزندانشان با پلیس تماس گرفتند اما پیگیری آنها به نتیجه نرسیده است.\u003cbr/\u003e\u003cbr/\u003eآنها نمی‌دانند چرا دختران آنها مورد تهدید قرار گرفته‌اند، اما متوجه شدند مسئولان مدرسه پرونده دانش‌آموزان را در اختیار ماموران امنیتی قرار دادند.\u003cbr/\u003e\u003cbr/\u003eاین افراد با حرف‌های زشت و رکیک دختران را خطاب قرار دادند و گفته‌اند ترددشان را زیر نظر دارند: \u0026#34;حواسمون بهتون هست.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D8%A8%DB%8C%D8%B1%D8%B3%D8%AA%D8%A7%D9%86_%D8%B4%D8%B1%D8%A7%D9%81%D8%AA\"\u003e#دبیرستان_شرافت\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#تهران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
