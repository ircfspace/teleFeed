    {
      "id": 5327,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e مکزیک ویزای همۀ اعضای تیم فوتبال جمهوری اسلامی را صادر کرد\u003cbr/\u003e\u003cbr/\u003eبخش رسانه‌ای تیم فوتبال جمهوری اسلامی اعلام کرد همۀ اعضای این تیم ویزای مکزیک را دریافت کرده‌اند.\u003cbr/\u003eبنا بر گزارش‌ها تیم ملی فوتبال جمهوری اسلامی روز شنبه ۱۶ خرداد از ترکیه راهی تیخوانا در مکزیک می‌شود.\u003cbr/\u003eمقام‌های جمهوری اسلامی پیش‌تر به‌ناچار محل اقامت تیم در جام جهانی ۲۰۲۶ را از آمریکا به مکزیک منتقل کرده بودند.\u003cbr/\u003eمهدی تاج، رئیس فدراسیون روز چهارشنبه گفته بود به جز دو نفر، ویزای مکزیک برای همۀ اعضا صادر شده، اما وضعیت صدور ویزای آمریکا هنوز مشخص نیست.\u003cbr/\u003eمارکو روبیو پیش‌تر گفته بود آمریکا اجازۀ ورود افراد مرتبط با سپاه در هیئت همراه تیم فوتبال جمهوری اسلامی را به خاک این کشور نمی‌دهد.\u003cbr/\u003eنام سپاه توسط ایالات متحده در سیاهۀ سازمان‌های تروریستی  قرار گرفته است.\u003cbr/\u003eمهدی تاج پیشینۀ عضویت در سپاه را دارد. همچنین شماری از اعضای اکیپ جمهوری اسلامی، در دوران خدمت سربازی یا مأموریت، در سپاه بوده‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
