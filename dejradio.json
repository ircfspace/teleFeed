    {
      "id": 5174,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e ادعای قرارگاه خاتم‌الانبیا: هرگونه مداخلۀ نظامی در مدیریت تنگۀ هرمز، با واکنش روبه‌رو می‌شود\u003cbr/\u003e\u003cbr/\u003eقرارگاه مرکزی خاتم‌الانبیا مدعی شد هرگونه اقدام شناورهای نظامی برای «مداخله» در مدیریت تنگۀ هرمز یا ایجاد اختلال در تردد کشتی‌ها، با واکنش نیروهای مسلح جمهوری اسلامی روبه‌رو می‌شود.\u003cbr/\u003eاین قرارگاه که مورد تحریم آمریکا قرار دارد، ادعا کرد همۀ کشتی‌، شناور و نفتکش‌ها تنها باید از مسیرهای تعیین‌شده عبور کنند و از نیروی دریایی سپاه پاسداران مجوز بگیرند.\u003cbr/\u003eدر این بیانیه ادعا شد هرگونه تخلف از این ضوابط، امنیت تردد شناورها را با «مخاطرۀ جدی» روبه‌رو می‌کند.\u003cbr/\u003eبر پایۀ برخی گزارش‌های تأییدنشده، شماری از شناورها تلاش کرده‌اند از بخش‌هایی از تنگۀ هرمز که در آب‌های عمان قرار دارد، عبور کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
