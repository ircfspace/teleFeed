    {
      "id": 7228,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e حمله پهپادی حوثی‌‌ها به پالایشگاه آرامکو عربستان \u003cbr/\u003e\u003cbr/\u003eشبه نظامیان حوثی وابسته به جمهوری اسلامی پنجشنبه ۲۲ امرداد ۱۴۰۵ مدعی شد پالایشگاه آرامکو در جیزان عربستان سعودی با دو پهپاد هدف قرار داده است.\u003cbr/\u003e\u003cbr/\u003eهمچنین گزارش شد اردوگاه نیروهای «سپر وطن» مورد حمایت عربستان سعودی در منطقه العبر استان حضرموت نیز هدف قرار گرفته است که، دست‌کم ۲ کشته و ۱۵ زخمی بر جای گذاشته است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A8%D8%B3%D8%AA%D8%A7%D9%86_%D8%B3%D8%B9%D9%88%D8%AF%DB%8C\"\u003e#عربستان_سعودی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%88%D8%AB%DB%8C\"\u003e#حوثی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
