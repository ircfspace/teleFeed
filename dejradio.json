      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e جام جهانی ۲۰۲۶؛\u003cbr/\u003eپرداخت ۱۰۰ تا ۳۰۰ دلار پول به مکزیکی‌ها برای حمل پرچم جمهوری اسلامی در استادیوم‌ها\u003cbr/\u003e\u003cbr/\u003eجمهوری اسلامی ایران سال‌هاست آنقدر درمانده شده است که به افراد پول می‌دهد تا خود را به عنوان حامیانش به دنیای خارج معرفی کند. پس از پول‌پاشی برای راه‌اندازی تجمعات سیاسی در لندن و برلین و قشون‌کشی با کمک آفریقایی تبارها و عرب تبارها به اسم حامیان جمهوری اسلامی، از حاشیه مسابقات جام جهانی ۲۰۲۶ خبر رسیده که رژیم، به شهروندان مکزیکی بین ۱۰۰ تا ۳۰۰ دلار پول داده تا در آمریکا با پرچم جمهوری اسلامی به استادیوم‌ها بروند و از تیم فوتبال حمایت کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%BE%D8%B1%DA%86%D9%85_%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#پرچم_جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%DA%A9%D8%B2%DB%8C%DA%A9\"\u003e#مکزیک\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
