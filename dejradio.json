    {
      "id": 6069,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eاسرائیل اعلام کرد جنگ با جمهوری اسلامی ممکن است هر لحظه ازسر گرفته شود\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eیسرائیل کاتز، وزیر دفاع اسرائیل روز دوشنبه گفت جنگ با جمهوری اسلامی ممکن است هر لحظه ازسرگرفته شود.\u003cbr/\u003eوزیر دفاع اسرائیل اعلام کرد ارتش برای عملیات مستقل علیه جمهوری اسلامی آمادگی دارد و تنها منتظر یک دستور است.\u003cbr/\u003eکاتز هشدار داد هرگونه شلیک موشک به اسرائیل، با حمله‌ای گسترده به مواضع جمهوری اسلامی در خاک ایران پاسخ داده می‌شود.\u003cbr/\u003eبه گفتۀ یسرائیل کاتز، ممکن است با تصمیم ترامپ یا شلیک موشکی از سوی جمهوری اسلامی، جنگ ازسرگرفته شود.\u003cbr/\u003eبنا بر اعلام وزیر دفاع اسرائیل، اهداف مرتبط با جمهوری اسلامی که باید مورد حمله قرار گیرد، از پیش انتخاب شده‌ است.\u003cbr/\u003eکاتز گفت ارتش اسرائیل برای عملیات احتمالی علیه رژیم در آماده‌باش کامل قرار دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
