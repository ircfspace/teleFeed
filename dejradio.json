    {
      "id": 6586,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eمنابع حکومتی از هدف گرفته شدن یک تونل و دو پل دیگر در جنوب ایران خبر دادند \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبر پایۀ گزارش‌های مردمی، هدف گرفته شدن پل‌هایی در مسیر کرمان به هرمزگان در حملات بامداد شنبه ۲۷ تیرماه سبب توقف تردد در برخی محورهای منتهی به بندرعباس شد.\u003cbr/\u003eخبرگزاری حکومتی فارس، وابسته به سپاه پاسداران اعلام کرد در حملات شنبه تونل «شهید میرزایی» و دو پل در مسیر میناب هدف قرار گرفته و سبب مسدود شدن مسیرها شده است.\u003cbr/\u003e سنتکام از شامگاه آدینه تا بامداد شنبه، هفتمین شب عملیات متوالی را علیه مواضعی که در خدمت اهداف نظامی رژیم جمهوری اسلامی قرار دارد، پی گرفت.\u003cbr/\u003eمنابع حکومتی تأیید کردند در پی حملات بامداد شنبه، شمار پل‌های هدف قرار گرفته در جنوب ایران به هشت مورد رسیده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87\"\u003e#حمله\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%D9%88%D8%A8\"\u003e#جنوب\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
