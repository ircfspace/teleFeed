    {
      "id": 5957,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e فرمانده گروه سایبری «حنظله» در جنگ چهل روزه کشته شده است\u003cbr/\u003e\u003cbr/\u003eرسانه‌های داخلی از کشته شدن سید یحیی حسینی پنجکی، مشهور به یحیی حمیدی، در جریان حملات هوایی ایالات متحده و اسرائیل خبر داده‌اند. پس از انتشار این خبر، کانال‌های نزدیک به نهادهای اطلاعاتی جمهوری اسلامی او را به‌عنوان فرمانده گروه هکری «حنظله» معرفی کردند؛ گروهی که طی ماه‌های گذشته مسئولیت چندین حمله سایبری و انتشار اطلاعات مربوط به اهداف اسرائیلی را بر عهده گرفته بود.\u003cbr/\u003e\u003cbr/\u003eپیش از این، نام حسینی پنجکی عمدتا در ارتباط با ساختارهای اطلاعاتی جمهوری اسلامی و پرونده‌های مرتبط با عملیات‌های برون‌مرزی مطرح می‌شد. اما پس از کشته‌شدن او، روایت تازه‌ای از نقش وی در هدایت و مدیریت عملیات‌های سایبری گروه حنظله منتشر شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D8%A7%D8%AA_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حملات_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
