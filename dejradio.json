    {
      "id": 5172,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e ترامپ بندهایی از توافق‌نامۀ پیشنهادی را برای جمهوری اسلامی دشوارتر کرد\u003cbr/\u003e\u003cbr/\u003eنیویورک‌تایمز گزارش داد دونالد ترامپ تغییراتی را تفاهم‌نامۀ پیشنهادی اعمال وشرایط را برای جمهوری اسلامی دشوارتر کرده است.\u003cbr/\u003eبنا بر گزارش رسانه‌های آمریکایی، نسخۀ اصلاح‌شدۀ تفاهم‌نامه برای بررسی دوباره به تهران فرستاده شد.\u003cbr/\u003eبر اساس این گزارش، در تغییرات مدنظر ترامپ، جمهوری اسلامی حتا حق خرید تجهیزات برای سلاح هسته‌ای را هم ندارد.\u003cbr/\u003eهمچنین وبسایت آکسیوس گزارش داد یکی از محورهای اصلی تغییرات، تأکید بیشتر بر تعیین تکلیف ذخایر هسته‌ای جمهوری اسلامی است.\u003cbr/\u003eبنا بر گزارش‌ها روند گفت‌وگوها برای دستیابی احتمالی به توافق میان واشینگتن و تهران، همچنان ادامه می‌یابد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
