    {
      "id": 8166,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e به گزارش خبرنامه «امیرکبیر»، دانشجویان دانشگاه علامه طباطبایی، دوشنبه ۶ مهرماه در پردیس مرکزی این دانشگاه تجمع اعتراضی برگزار کردند. \u003cbr/\u003e\u003cbr/\u003eافزایش شهریه دانشجویان شبانه و سنواتی، وضعیت ارزاق خوابگاه‌ها و خدمات تغذیه، همچنین اعتراض به حجاب اجباری، از موضوعات مطرح‌شده در این تجمع بوده است.\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش دانشجویان، نیروهای بسیج با عنوان گفت‌وگو، درصدد برهم‌زدن تجمع برآمده و دانشجویان را به انداختن در «گونی» تهدید کردند. \u003cbr/\u003eدانشجویان نیز در واکنش، شعار «گفت‌وگوی تو گونی، نمی‌خوایم، نمی‌خوایم» سر داده‌اند.\u003cbr/\u003e\u003cbr/\u003eمعترضان با شعارهای «دانشگاه پولکی، نمی‌خوایم نمی‌خوایم» و «با رتبه‌های عالی، تو خوابگاه پوشالی»، نارضایتی خود را از هزینه‌های تحصیل و وضعیت خوابگاه‌ها ابراز کردند. \u003cbr/\u003eشعارهای «گرانی، تورم، بلای جان مردم» و «بیگاری، بیکاری، حجاب زن اجباری» نیز از دیگر شعارهای گزارش‌شده در این تجمع بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87_%D8%B9%D9%84%D8%A7%D9%85%D9%87_%D8%B7%D8%A8%D8%A7%D8%B7%D8%A8%D8%A7%DB%8C%DB%8C\"\u003e#دانشگاه_علامه_طباطبایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6_%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C%D8%A7%D9%86\"\u003e#اعتراض_دانشجویان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
