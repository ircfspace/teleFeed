    {
      "id": 4792,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e بر اساس گزارش منابع محلی یک مامور نیروی انتظامی در سراوان روز چهارشنبه ۳۰ اردیبهشت در اثر تیراندازی افراد مسلح ناشناس کشته شد.\u003cbr/\u003e\u003cbr/\u003eرسانه‌های حکومتی از جمله خبرگزاری تسنیم وابسته به سـ.ـپاه پاسداران، هویت نیروی کشته‌شده را «امیرحسین شهرکی» با درجه ستوان‌سومی اعلام کرده و مدعی شده‌اند که وی بر اثر اصابت گلوله جان خود را از دست داده است.\u003cbr/\u003e\u003cbr/\u003eمهاجمان از داخل یک ماشین به سمت خودرو پلیس شلیک کردند. خبرگزاری ایلنا گزارش داد دو فرد مسلح نیز در تبادل آتش کشته شدند. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B1%D8%A7%D9%88%D8%A7%D9%86\"\u003e#سراوان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
