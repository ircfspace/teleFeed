    {
      "id": 5901,
      "message": "‌\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e ستوان یکم عمار شریفی اهل چهارمحال و بختیاری، شهرستان لردگان که تقریبا دو سال است به نیرو زمینی سـ.ـپاه پاسداران مامور شده، این دو سال فرمانده یگان ضد شورش بوده است.\u003cbr/\u003e\u003cbr/\u003eشریفی قبل از خیزش دی‌ماه ۱۴۰۴، در جریان مراسم تدفین خسرو علیکردی وکیل دادگستری که آذرماه ۱۴۰۴ برگزار شد در جریان سرکوب مردم مشهد حضور داشت.\u003cbr/\u003eمنبع دژ می‌گوید: «او یک دیوانه است که برای پول هرکاری می‌کند.»\u003cbr/\u003e\u003cbr/\u003eاو در خیزش دی‌ماه از فرماندهان میدانی یگان‌های ضدشورش بود که مسلح بود و بارها به سمت مردم تیراندازی کرد. در حال حاضر به اهواز منتقل شده است و گاهی در شهر لردگان فعالیت‌های حفاظتی دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D9%85%D8%A7%D8%B1_%D8%B4%D8%B1%DB%8C%D9%81%DB%8C\"\u003e#عمار_شریفی\u003c/a\u003e  \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
