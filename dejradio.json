    {
      "id": 5858,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e وزیر دفاع اسرائیل اعلام کرد این کشور از منطقۀ امنیتی در جنوب لبنان عقب‌نشینی نمی‌کند\u003cbr/\u003e\u003cbr/\u003eیسرائیل کاتز، وزیر دفاع اسرائیل، روز یکشنبه اعلام کرد ارتش این کشور از منطقۀ امنیتی جنوب لبنان خارج نمی‌شود.\u003cbr/\u003eبه گفتۀ یسرائیل کاتز، مراقبت از جان شهروندان و نظامیان اسرائیل اولویت مطلق دولت است.\u003cbr/\u003e او افزود که نیروهای اسرائیلی برای مقابله با تهدیدها از آزادی عمل کامل برخوردارند.\u003cbr/\u003eبه گزارش شماری از رسانه‌های غربی، موضوع لبنان به یکی از محورهای اصلی مذاکرات نمایندگان تهران و واشینگتن در سوئیس تبدیل شده است.\u003cbr/\u003eسی‌ان‌ان مدعی شده پایان حملات در لبنان اولویت نخست هیئت جمهوری اسلامی در مذاکرات سوئیس به‌شمار می‌رود.\u003cbr/\u003eجی‌دی ونس، معاون رئیس جمهوری آمریکا، در سفر به سوئیس از پاسخ به پرسش خبرنگاران دربارۀ اسرائیل و نتانیاهو خودداری کرد.\u003cbr/\u003eشماری از وزاری کابینۀ نتانیاهو می‌گویند اسرائیل به تفاهم  میان رژیم حاکم بر ایران و ایالات متحده، متعهد نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A6%DB%8C%D9%84\"\u003e#اسرئیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
