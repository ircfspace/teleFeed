    {
      "id": 8414,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5785322240497160767\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F87BAF09F87B8.png\u0026#39;)\"\u003e\u003cb\u003e🇺🇸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسنتکام: عبور بیش از ۱.۲۵میلیارد بشکه نفت از خلیج فارس؛ صادرات نفت جمهوری اسلامی به صفر رسیده است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eفرماندهی مرکزی ارتش آمریکا،سنتکام،اعلام کرد نیروهای آمریکایی طی ماه‌های اخیر از انتقال بیش از یک‌میلیارد و ۲۵۰میلیون بشکه نفت خام کشورهای حاشیه خلیج فارس و عبور آن از تنگه هرمز پشتیبانی کرده‌اند،در حالی که به‌دلیل محاصره کامل بنادر جمهوری اسلامی،هیچ محموله نفتی از ایران صادر نشده است.\u003cbr/\u003eسنتکام در بیانیه‌ای پس از نشست مجازی با نمایندگان صنعت کشتیرانی بین‌المللی تأکید کرد نیروهای آمریکایی با پاکسازی مین‌های دریایی از مسیرهای اصلی تردد،عبور ایمن هزاران کشتی تجاری را از تنگه هرمز امکان‌پذیر کرده‌اند.\u003cbr/\u003eدریاسالار برد کوپر،فرمانده سنتکام،ضمن قدردانی از همکاری شرکت‌های کشتیرانی و نهادهای دولتی آمریکا،به تلفات و آسیب‌های خدمه غیرنظامی کشتی‌ها در حملات جمهوری اسلامی اشاره کرد.\u003cbr/\u003eبر اساس اعلام سنتکام،مسیرهای تردد آزاد در تنگه هرمز برای تمامی شناورهایی که محاصره آمریکا علیه جمهوری اسلامی را نقض نکنند،باز است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%B4%D8%AA%DB%8C%D8%B1%D8%A7%D9%86%DB%8C\"\u003e#کشتیرانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
