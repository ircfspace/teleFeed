    {
      "id": 7855,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e یک کارشناس هوانوردی به دژ می‌گوید، تحریم ایرلاین‌ها و شرکت‌های هوایی جمهوری اسلامی باعث می‌شود هزینه‌ها و ریسک پرواز با هواپیماهای ایرانی به شدت افزایش یابد.\u003cbr/\u003e\u003cbr/\u003eوقتی قطعات وارد ایران نشود، با توجه به فرسودگی ناوگان هوانوردی عملا هواپیماها یا زمینگیر می‌شوند یا ریسک پرواز با آنها زیاد خواهد شد همچنان که طی ماه‌های اخیر موارد بازگشت پرواز به مبداء یا فرود اضطراری بیشتر شده است.\u003cbr/\u003e\u003cbr/\u003eپیش‌تر با وجود تحریم‌ها، دلال‌ها از مسیر چند شرکت مستقر در بریتانیا، ترکیه، مالزی و قزاقستان برای شرکت‌های هواپیمایی ایرانی قطعه تامین می‌کردند اما این شرکت‌ها لو رفتند و وزارت خزانه‌داری آمریکا آنها را تحریم کرد. \u003cbr/\u003e\u003cbr/\u003eبرخی منابع حکومتی مدعی شدند تحریم‌ها فقط برای هواپیماهای بوئینگ مشکل‌ساز خواهد بود اما همین کارشناس می‌گوید قطعات «ایرباس» و سایر هواپیماها نیز شامل تحریم می‌شود.\u003cbr/\u003e\u003cbr/\u003eجمهوری اسلامی امیدوار است چین، مالزی و چند کشور دیگر از تحریم‌های آمریکا تبعیت نکنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%B7%D9%88%D8%B7_%D9%87%D9%88%D8%A7%DB%8C%DB%8C\"\u003e#خطوط_هوایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D8%A2%D9%85%D8%B1%DB%8C%DA%A9%D8%A7\"\u003e#حمله_آمریکا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
