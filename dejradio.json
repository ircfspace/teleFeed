    {
      "id": 5590,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e صادرات فرش ایرانی در یک دهۀ اخیر ۹۸ درصد افت کرد\u003cbr/\u003e\u003cbr/\u003eبر پایۀ آمارهای رسمی صادرات فرش ایرانی از حدود ۴۰۰ میلیون دلار در یک دهۀ پیش به کمتر از ۴۲ میلیون دلار در سال پیشین رسید.\u003cbr/\u003eخبرگزاری حکومتی رکنا گزارش داد فرش ایرانی پس از بازگشت تحریم‌ها در سال ۱۳۹۷ بازار اصلی خود در آمریکا را از دست داد.\u003cbr/\u003eبنا بر این گزارش، صنعت فرش ایرانی اکنون زیر فشار رقبا، سیاست‌های ارزی جمهوری اسلامی، افت گردشگری و کاهش قدرت خرید داخلی، برای یافتن مشتری داخلی در تلاش است.\u003cbr/\u003eدر حالی که صادرات فرش ایرانی به پایین‌ترین رقم تاریخ خود رسیده، ترکیه در سال پیشین معادل نزدیک به سه میلیارد دلار فرش را به ۱۸۲ کشور صادر کرد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D8%B1%D8%B4\"\u003e#فرش\u003c/a\u003e \u003ca href=\"?q=%23%D8%B5%D8%A7%D8%AF%D8%B1%D8%A7%D8%AA\"\u003e#صادرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
