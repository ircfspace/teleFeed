    {
      "id": 9092,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e شاهزاده رضا پهلوی در نشست خبری با رسانه‌های بین‌المللی در کراکوف (لهستان) که دوشنبه ۱۸ ابان ۱۴۰۵ برگزار شد، گفت جهان در برابر تمامیت‌خواهی شوروی، فاشیسم هیتلر و رژیم نژادپرست آپارتاید ایستاد، اما جمهوری اسلامی هر سه ویژگی را یکجا در خود دارد و همچنان با اقدام قاطع جهانی روبه‌رو نشده است.\u003cbr/\u003eاو در این نشست، که در حاشیه مراسم اهدای «جایزه سلیمان» به او و به میزبانی انجمن یهودیان اروپا برگزار شد، پرسید: دیگر چه باید رخ دهد تا جهان برای جلوگیری از هولوکاستی دیگر، پایان دادن به سرکوب مردم ایران و دفاع از آزادی اقدام کند؟\u003cbr/\u003eطبق گزارش رسانه‌های ویژه دفتر شاهزده رضا پهلوی او در این نشست سه پیام روشن دارد: به نمایندگی از ملت ایران برای ادای احترام به قربانیان هولوکاست به اینجا آمده است، هشدار می‌دهد که جمهوری اسلامی موجودیت اسرائیل و یهودیان سراسر اروپا را تهدید می‌کند، و از جهان می‌خواهد از کسانی که با این رژیم مبارزه می‌کنند، مردم ایران، حمایت کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%84%D9%87%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#لهستان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
