      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e تیرماه ۱۳۷۸، دانشجویان دانشگاه تهران در اعتراض به فقدان آزادی مطبوعات دست به اعتراض زدند و در ۱۸ تیر، در خوابگاه‌هایشان، معروف به «کوی دانشگاه»، توسط نیروهای سرکوبگر رژیم مورد ضرب‌وشتم شدید قرار گرفتند. شدت سرکوب بسیار بالا بود و اخبار و گزارش‌ها از جان باختن شماری از دانشجویان خبر می‌داد. \u003cbr/\u003e\u003cbr/\u003eچند روز بعد، سعید زینالی، دانشجوی دانشگاه تهران، در منزلش بازداشت شد و با وجود پیگیری‌های خانواده‌اش و نهادهای حقوق بشری، تاکنون هیچ خبری از سرنوشت وی به دست نیامده و جمهوری اسلامی نیز در این‌باره پاسخگو نبوده است.\u003cbr/\u003e\u003cbr/\u003eسال‌ها گذشت تا اینکه در ۱۸ تیر ۱۴۰۶، بقایای ناچیزی از جسد سیدعلی خامنه‌ای، رهبر پیشین جمهوری اسلامی، که در جریان جنایات کوی دانشگاه با بیان اینکه دشمن و بیگانگان در آن اعتراضات نقش‌آفرینی کرده‌اند، عملا مهر تأییدی بر سرکوب دانشجویان زد، در مشهد دفن شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D9%88%DB%8C_%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87\"\u003e#کوی_دانشگاه\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D8%B9%DB%8C%D8%AF_%D8%B2%DB%8C%D9%86%D8%A7%D9%84%DB%8C\"\u003e#سعید_زینالی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6_%D8%AF%D8%A7%D9%86%D8%B4%D8%AC%D9%88%DB%8C%D8%A7%D9%86\"\u003e#اعتراض_دانشجویان\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
