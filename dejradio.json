      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eتأیید همکاری اطلاعاتی اسرائیل و عربستان علیه حوثی‌ها؛ ارتش اسرائیل برای رویارویی احتمالی با حملات چندجبهه‌ای آماده می‌شود\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eروزنامه جروزالم پست به نقل از یک مقام ارشد دفاعی اسرائیل گزارش داد که ارتش این کشور با میانجیگری آمریکا،همچنان اطلاعات و توانمندی‌های پیشرفته اطلاعاتی خود را برای کمک به عملیات نظامی عربستان سعودی علیه حوثی‌های مورد حمایت جمهوری اسلامی در اختیار ریاض قرار می‌دهد.\u003cbr/\u003eاین مقام تأکید کرد که همکاری اطلاعاتی اسرائیل با عربستان مطابق با منافع امنیت ملی اسرائیل و دستورهای رهبری سیاسی این کشور انجام می‌شود.\u003cbr/\u003eبه گفته این مقام دفاعی،حملات گسترده عربستان به مواضع و زیرساخت‌های نظامی حوثی‌ها،ضمن تضعیف توان رزمی این گروه،به اسرائیل امکان می‌دهد تاکتیک‌های عملیاتی و تسلیحات مورد استفاده حوثی‌ها،از جمله سلاح‌های تولیدشده در خارج از یمن را بررسی کند.\u003cbr/\u003eاین مقام همچنین هشدار داد که کشورهای سنی منطقه با نگرانی حملات حوثی‌ها به عربستان را دنبال می‌کنند و بیم آن دارند که خود به اهداف بعدی این گروه تبدیل شوند.\u003cbr/\u003eجروزالم پست در بخش دیگری از گزارش نوشت که ارتش اسرائیل در حال تکمیل آمادگی‌های دریایی،هوایی،زمینی و جنگ الکترومغناطیسی برای مقابله با حمله احتمالی حوثی‌ها در چارچوب یک درگیری چندجبهه‌ای با مشارکت جمهوری اسلامی،حزب‌الله و شبه‌نظامیان شیعه عراق است.\u003cbr/\u003eاین آماده‌سازی‌ها شامل به‌کارگیری فناوری‌ها و حسگرهای جدید،تقویت ارتباطات میان بخش‌های مختلف ارتش اسرائیل و افزایش هماهنگی عملیاتی با نیروهای آمریکایی است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%88%D8%AB%DB%8C\"\u003e#حوثی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%B9%D8%B1%D8%A8%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#عربستان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
