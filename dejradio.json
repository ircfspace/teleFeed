    {
      "id": 6171,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e شرکت هواپیمایی \u0026#34;ماهان‌ایر\u0026#34; اصلی‌ترین شریک سپاه پاسداران در حمل مهمات و تجهیزات جنگی است. این شرکت با ایده قاسم سلیمانی به ویژه در جنگ سوریه از هواپیماهای مسافربری به عنوان سپر انسانی استفاده کرد.\u003cbr/\u003e\u003cbr/\u003eبرخی منابع گزارش دادند شرکت ECT Aviation Support که در امارات مستقر است تاکنون پنج فروند بوئینگ به ماهان‌ایر تحویل داده است.\u003cbr/\u003e\u003cbr/\u003eاین پنج فروند هواپیمای پهن‌پیکر دست‌دوم بوئینگ 777-268ER  پیش‌تر متعلق به شرکت دولتی هواپیمایی عربستان بودند.\u003cbr/\u003e\u003cbr/\u003eگفته می‌‌شود که دست‌کم دو فروند از این هواپیما‌ها در فرودگاه مهرآباد تهران هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D9%88%D8%A7%D9%BE%DB%8C%D9%85%D8%A7%DB%8C%DB%8C_%D9%85%D8%A7%D9%87%D8%A7%D9%86\"\u003e#هواپیمایی_ماهان\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e#سپر_انسانی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
