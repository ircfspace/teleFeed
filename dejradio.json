    {
      "id": 5982,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e وزیر دفاع اسرائیل خطاب به قاآنی: جاسوسی بیشتر به تو می‌آید\u003cbr/\u003e\u003cbr/\u003eیسرائیل کاتز، وزیر دفاع اسرائیل در واکنش به تهدید دوباره جمهوری اسلامی، در پستی به زبان فارسی در شبکه اجتماعی ایکس با خطاب قرار دادن اسماعیل قاآنی، عباس عراقچی و محمدباقر قالباف نوشت:\u003cbr/\u003e\u0026#34;فرمانده نیروی قدس، قاآنی، این روزها مدام اسرائیل را تهدید می‌کند.\u003cbr/\u003eبه نظر می‌رسد نقش یک جاسوس و خائن خیلی بیشتر از این ژست‌های مضحکِ تهدید به او می‌آید.\u003cbr/\u003e\u003cbr/\u003eدر هر صورت اگر جمهوری اسلامی به اسرائیل حمله کند، بزرگ‌ترین اشتباه خود را مرتکب خواهد شد.\u003cbr/\u003eنه هرمز به آن‌ها کمک خواهد کرد و نه حمله به غیرنظامیان، هیچ‌‌چیز ما را متوقف نخواهند کرد.\u003cbr/\u003eنیروهای ما آماده‌اند تا کار را به پایان برسانند.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%A7%D8%A2%D9%86%DB%8C\"\u003e#قاآنی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
