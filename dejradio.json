    {
      "id": 9139,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک منبع اختصاصی به دژ گفت، ۸ ماه پس از جنگ، به علت تخریب ساختمان کلانتری‌ها در تهران، بسیاری از پرسنل همچنان در کانکس مستقر هستند و به علت محدودیت دسترسی به سرویس بهداشتی (توالت) و آب سالم انواع بیماری‌های عفونی و انگلی به‌ویژه بین سربازان شیوع پیدا کرده است.\u003cbr/\u003e\u003cbr/\u003eدر بیمارستان سجاد تهران وابسته به فراجا، روزانه شمار زیادی سرباز با علائم مشابه برای درمان یا بستری مراجعه می‌کنند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://www.instagram.com/explore/tags/%D8%AC%D9%86%DA%AF/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"https://www.instagram.com/explore/tags/%D8%B3%D8%B1%D8%A8%D8%A7%D8%B2/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e#سرباز\u003c/a\u003e \u003ca href=\"https://www.instagram.com/explore/tags/%D8%A8%D9%87%D8%AF%D8%A7%D8%B4%D8%AA/\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e#بهداشت\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
