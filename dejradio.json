    {
      "id": 6587,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eآمریکا از اقدام بریتانیا علیه سپاه پاسداران انقلاب اسلامی استقبال کرد \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eوزارت امور خارجۀ آمریکا از تصمیم بریتانیا برای قرار دادن سپاه پاسداران و گروه «حرکت انصار یمین اسلامیه» در فهرست نهادهای ممنوع در این کشور استقبال کرد.\u003cbr/\u003eتامی پیگوت، سخنگوی وزارت امور خارجۀ آمریکا گفت تلاش‌های جمهوری اسلامی برای قتل، ربایش، آزار و ارعاب در آمریکا، بریتانیا و دیگر کشورها، حاکمیت ملی و هنجارهای بین‌المللی را تضعیف می‌کند.\u003cbr/\u003eپیگوت تأکید کرد که آمریکا به همکاری با متحدان خود برای پاسخگو کردن جمهوری اسلامی در قبال تروریسم مورد حمایت رژیم، ادامه می‌دهد.\u003cbr/\u003eبریتانیا سپاه پاسداران را بر اساس قانون جدید امنیت ملی در فهرست گروه‌های غیرقانونی قرار داده و هرگونه پشتیبانی یا فعالیت به نمایندگی از این نهاد را جرم‌انگاری کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%A7%D9%87_%D8%AA%D8%B1%D9%88%D8%B1%DB%8C%D8%B3%D8%AA%DB%8C_%D9%BE%D8%A7%D8%B3%D8%AF%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#سپاه_تروریستی_پاسداران\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A8%D8%B1%DB%8C%D8%AA%D8%A7%D9%86%DB%8C%D8%A7\"\u003e#بریتانیا\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
