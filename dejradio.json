      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e عادل فردوسی‌پور که چندی پیش به محدود شدن برنامه‌هایش توسط عوامل پشت پرده معترض شده بود، در مراسم ختم اکبر عبدی بر دستان صالحی امیری وزیر میراث فرهنگی و نماینده پیشین خامنه‌ای در روزنامه اطلاعات بوسه زد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B9%D8%A7%D8%AF%D9%84_%D9%81%D8%B1%D8%AF%D9%88%D8%B3%DB%8C_%D9%BE%D9%88%D8%B1\"\u003e#عادل_فردوسی_پور\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%DA%A9%D9%88%D9%85%D8%AA%DB%8C\"\u003e#حکومتی\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%B9%D9%84%DB%8C\"\u003e#موشعلی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
