      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e مترسک مجتبی؛ ابتکار دانشجویان دانشکده سینما و تئاتر دانشگاه تهران\u003cbr/\u003e\u003cbr/\u003eشماری از دانشجویان دانشکده سینما و تئاتر دانشگاه هنر تهران، با ارسال ویدیویی از مترسک مجتبی خامنه‌ای نوشتند: \u0026#34;با ساخت این مجسمه پوشالی مترسکی، خواستیم  به طور واضح و مشخص به همه دنیا آشکار کنیم که ایران الأن داره به‌دست کی اداره می‌شه.\u003cbr/\u003eکلاغ به‌جای اینکه از مترسک بترسه، داره اداره‌اش می‌کنه.\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87_%D8%AA%D9%87%D8%B1%D8%A7%D9%86\"\u003e#دانشگاه_تهران\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%87%D8%A8%D8%B1_%D9%85%D9%82%D9%88%D8%A7%DB%8C%DB%8C\"\u003e#رهبر_مقوایی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
