    {
      "id": 7226,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5938304994145998707\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B8.png\u0026#39;)\"\u003e\u003cb\u003e🔸\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e لغو مجازات اعدام در لبنان\u003cbr/\u003e\u003cbr/\u003eپارلمان لبنان ۲۰ امرداد ۱۴۰۵ لغو مجازات اعدام را تصویب و حبس ابد را جایگزین آن کرد. لبنان که از سال ۲۰۰۴ هیچ اعدامی اجرا نکرده بود، با این تصمیم از تعلیق عملی اعدام به لغو قانونی آن رسید؛ اقدامی که اتحادیه اروپا و سازمان‌های حقوق بشری آن را نقطه عطفی برای منطقه ارزیابی کرده‌اند.\u003cbr/\u003e\u003cbr/\u003eسفر جوزف عون به واشنگتن در همین چارچوب اهمیت دارد. دونالد ترامپ در دیدار با او آشکارا از کمک گسترده آمریکا به لبنان سخن گفت؛ در مقابل، واشنگتن خواهان اقدامات ملموس بیروت برای تقویت حاکمیت دولت و خلع سلاح حزب‌الله است. تحلیل‌های پیش از این دیدار هم نیاز دولت عون به حمایت مالی و عملیاتی آمریکا را یکی از محورهای اصلی مذاکرات ارزیابی کرده بودند.\u003cbr/\u003e\u003cbr/\u003eبه هر شکل، این تصمیم را می‌توان در چارچوب گسترده‌تر چرخش سیاسی لبنان در دوره عون دید: تقویت نهاد دولت، فاصله گرفتن از نفوذ حزب‌الله و نزدیک‌تر شدن به استانداردهای حقوق بشری غرب. البته فشار بین‌المللی، به‌ویژه از سوی اروپا و سازمان ملل، نیز به گفته مدافعان طرح در تصویب نهایی مؤثر بوده است.\u003cbr/\u003e\u003cbr/\u003eاین تصمیم در مقطعی اتخاذ شده که دولت جوزف عون برای بازسازی اقتدار دولت مرکزی، تضعیف ساختار موازی حزب‌الله و جذب حمایت مالی و سیاسی آمریکا و اروپا تلاش می‌کند.\u003cbr/\u003eاز این رو، لغو اعدام می‌تواند نخستین نشانه مهم از همگرایی سیاسی و حقوقی لبنان با غرب تلقی شود؛ همگرایی‌ که افزایش کمک‌ها و سرمایه‌گذاری غربی را برای دولت عون قابل دفاع‌تر می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AF%D8%A7%D9%85\"\u003e#اعدام\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%BA%D9%88_%D9%85%D8%AC%D8%A7%D8%B2%D8%A7%D8%AA_%D8%A7%D8%B9%D8%AF%D8%A7%D9%85\"\u003e#لغو_مجازات_اعدام\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%87_%D8%A8%D9%87_%D8%A7%D8%B9%D8%AF%D8%A7%D9%85\"\u003e#نه_به_اعدام\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
