    {
      "id": 5768,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e ضرب‌وشتم زنان بی‌دفاع در فاریاب کرمان توسط نیروی انتظامی \u003cbr/\u003e\u003cbr/\u003eبه گزارش \u0026#34;حال‌ وش\u0026#34; روز چهارشنبه ۲۷ خردادماه ۱۴۰۵، نیروهای نظامی به تجمع اعتراضی اهالی روستای پشموکی از توابع شهرستان فاریاب در استان کرمان یورش بردند.\u003cbr/\u003e\u003cbr/\u003eماموران باتوم، مشت و لگد به سمت زنان و شهروندان معترض هجوم برده و آنان را مورد ضرب‌وشتم قرار دادند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D8%B1%DA%A9%D9%88%D8%A8_%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA\"\u003e#سرکوب_اعتراضات\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%B1%D9%85%D8%A7%D9%86\"\u003e#کرمان\u003c/a\u003e  \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
