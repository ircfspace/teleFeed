    {
      "id": 9132,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e گروهی از کارکنان مالباخته هوانیروز، چهارشنبه ۲۰ آبان ۱۴۰۵، در اعتراض به بلاتکلیفی پروژه تعاونی مسکن برای ساخت خانه‌هایشان مقابل استانداری کرمانشاه تحصن کردند. \u003cbr/\u003e\u003cbr/\u003eتجمع‌کنندگان به نشانه اعتراض، جاده مقابل استانداری را بستند و مانع تردد شدند.\u003cbr/\u003eاین افراد از سال ۱۳۹۰، هم‌زمان با تاسیس تعاونی مسکن هوانیروز زمین خریدند و امیدوار بودند که با ساخت‌وساز تعاونی مسکن در این زمین‌ها صاحب خانه شوند.\u003cbr/\u003e\u003cbr/\u003eبر اساس گزارش‌ها، با گذشت ۱۵ سال از تاسیس این تعاونی، پروژه ساخت مسکن برای کارکنانی که زمین خریده‌اند هنوز به مرحله اجرا نرسیده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B1%D8%A7%D8%B6%D8%A7%D8%AA\"\u003e#اعتراضات\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%B1%D9%88%D9%87%D8%A7%DB%8C_%D9%85%D8%B3%D9%84%D8%AD\"\u003e#نیروهای_مسلح\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
