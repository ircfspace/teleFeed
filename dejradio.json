    {
      "id": 7751,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951677112829088371\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eگروسی: آژانس بیش از یک سال است از برنامۀ هسته‌ای جمهوری اسلامی بی‌خبر است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eرافائل گروسی، مدیرکل آژانس بین‌المللی انرژی اتمی، روز دوشنبه ۱۶ شهریور، هم‌زمان با آغاز نشست فصلی شورای حکام، اعلام کرد این نهاد دست‌کم از ژوئن ۲۰۲۵ تاکنون هیچ اطلاعی از وضعیت برنامۀ هسته‌ای جمهوری اسلامی ندارد.\u003cbr/\u003eگروسی در نشست شورای حکام گفت آژانس نه اطلاعاتی درباره وضعیت مواد و تأسیسات هسته‌ای اعلام‌شده دریافت کرده و نه به این تأسیسات دسترسی داشته است تا فعالیت‌های راستی‌آزمایی میدانی را انجام دهد.\u003cbr/\u003eبه گفتۀ مدیرکل آژانس، این محدودیت‌ها باعث شده است که این نهاد نتواند مسئولیت‌های نظارتی خود را در چارچوب موافقت‌نامۀ پادمان‌های معاهدۀ منع گسترش سلاح‌های هسته‌ای در تأسیسات اعلام‌شدۀ جمهوری اسلامی انجام دهد.\u003cbr/\u003eگروسی همچنین در نشست خبری پس از این جلسه تأکید کرد که همکاری با آژانس بین‌المللی انرژی اتمی به نفع جمهوری اسلامی است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%88%D8%B1%D8%A7%DB%8C_%D8%AD%DA%A9%D8%A7%D9%85\"\u003e#شورای_حکام\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D9%87_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#برنامه_اتمی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
