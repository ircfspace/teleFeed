    {
      "id": 6614,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5839239365850568848\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9BA9.png\u0026#39;)\"\u003e\u003cb\u003e🛩️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eسنتکام از آغاز دور جدید حملات هوایی آمریکا علیه جمهوری اسلامی خبر داد\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eفرماندهی مرکزی ایالات متحده، سنتکام، اعلام کرد نیروهای آمریکایی ساعت ۶ عصر امروز به وقت شرق آمریکا، به دستور دونالد ترامپ، فرمانده کل قوای ایالات متحده، دور جدیدی از حملات هوایی علیه جمهوری اسلامی را آغاز کردند.\u003cbr/\u003eسنتکام اعلام کرد هدف از این حملات، تضعیف بیشتر توان جمهوری اسلامی برای تهدید کشتی‌های تجاری در تنگۀ هرمز و مجازات سریع نیروهای سپاه پاسداران است.\u003cbr/\u003eبر اساس این پیام، حملات جدید آمریکا در واکنش به حملۀ شب گذشته نیروهای سپاه پاسداران به نظامیان آمریکایی در اردن انجام شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%A7%D9%88%D8%B1%D9%85%DB%8C%D8%A7%D9%86%D9%87\"\u003e#خاورمیانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%86%D8%AA%DA%A9%D8%A7%D9%85\"\u003e#سنتکام\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
