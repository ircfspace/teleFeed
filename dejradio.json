    {
      "id": 7152,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e محمدامین خدری، سرکوبگر دهه هشتادی بـ.ـسیج است که در اعتراضات لیدرها را شناسایی و تیم‌های شلیک را با لیزر به سمت آنها هدایت می‌کند.\u003cbr/\u003e\u003cbr/\u003eبر اساس اطلاعات بررسی شده، نام‌برده در خیزش ۱۴۰۱ و دی‌ماه ۱۴۰۴ به عنوان آمر پایش و هدایت تیم‌های شلیک در سه شهر قم، تهران و کرج فعالیت داشته است.\u003cbr/\u003e\u003cbr/\u003eخودرو عملیاتی او یک دستگاه ساینا جهت شناسایی و تردد چرخشی ۱۵ روزه بین پایتخت و قم استفاده می‌کند.\u003cbr/\u003e\u003cbr/\u003eپاتوق‌های اصلی او محدوده میدان عطار تهران و منطقه پردیسان قم در پایگاه موسوم به «علی لاریجانی» زیر مجموعه قرارگاه ثارالله است.\u003cbr/\u003e\u003cbr/\u003eدار و دسته خدری با مهره‌های دانه‌درشتی مثل اسداللهی (مداح بیت)، ذوالنور و روانبخش پیوند مستقیم دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D8%A7%D8%B4\"\u003e#جاش\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DB%8C%DB%B1%DB%B4%DB%B0%DB%B4\"\u003e#دی۱۴۰۴\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%AD%D9%85%D8%AF%D8%A7%D9%85%DB%8C%D9%86_%D8%AE%D8%AF%D8%B1%DB%8C\"\u003e#محمدامین_خدری\u003c/a\u003e \u003ca href=\"?q=%23%D8%A2%D8%AF%D9%85_%D9%81%D8%B1%D9%88%D8%B4\"\u003e#آدم_فروش\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
