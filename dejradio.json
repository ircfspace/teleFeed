    {
      "id": 5298,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e کشف تونل ۶۰۰ متری قاچاق کوکائین در تیخوانا؛ نگرانی‌ها از محل اردوی تیم ملی افزایش یافت\u003cbr/\u003e\u003cbr/\u003eماموران فدرال آمریکا از کشف یک تونل پیشرفتۀ قاچاق مواد مخدر میان تیخوانا مکزیک و کالیفرنیا خبر دادند.\u003cbr/\u003eتیم ملی فوتبال جمهوری اسلامی ایران قرار است در تیخوانا که یکی از خشن‌ترین شهرهای دنیا به‌شمار می‌رود، اردو بزند.\u003cbr/\u003eتیخوانا، محل کمپ تیم ملی فوتبال ایران برای جام جهانی، بارها در فهرست شهرهای با بالاترین نرخ قتل جهان قرار گرفته است.\u003cbr/\u003eدر عملیات اخیر بیش از یک تن کوکائین به ارزش تقریبی ۴۵ میلیون دلار کشف و ضبط شده است.\u003cbr/\u003eرقابت کارتل‌های مواد مخدر و خشونت سازمان‌یافته از عوامل اصلی ناامنی این شهر عنوان می‌شود.\u003cbr/\u003eمهدی تاج، رئیس فدراسیون فوتبال جمهوری اسلامی مدعی شد تیخوانا ناامن نیست و سه لایۀ امنیتی فیفا در آنجا حضور دارد.\u003cbr/\u003eاو ادعا کرد مقام‌های محلی مکزیک این شهر را برای میزبانی تیم ملی مناسب دانسته‌اند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%81%D9%88%D8%AA%D8%A8%D8%A7%D9%84\"\u003e#فوتبال\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%DA%A9%D8%B2%DB%8C%DA%A9\"\u003e#مکزیک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D8%A7%D9%85_%D8%AC%D9%87%D8%A7%D9%86%DB%8C\"\u003e#جام_جهانی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
