    {
      "id": 6659,
      "message": "\u003cb\u003e\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003c/b\u003e\u003cb\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e یک منبع نظامی:\u003cbr/\u003eبا شدت گرفتن حملات آمریکا «ترک خدمت» سربازان وظیفه افزایش یافته است\u003cbr/\u003e\u003cbr/\u003eیک منبع نظامی به دژ می‌گوید با شدت گرفتن حملات آمریکا به مراکز نظامی موارد «ترک خدمت» سربازان وظیفه در اغلب واحدها افزایش پیدا کرده است. \u003cbr/\u003e\u003cbr/\u003eتخمین زده می‌شود از ۲۰ تیرماه پس از آغاز دور تازه حملات آمریکا به مراکز نظامی با تمرکز بر پادگان‌ها و مقرهای سپاه پاسداران  و ارتش در نیمه جنوبی کشور، حدود هزار سرباز وظیفه ترک خدمت کرده‌اند.\u003cbr/\u003e\u003cbr/\u003eکارشناسان نظامی دژ به خانواده‌ها هشدار داده‌اند سربازان را به پادگان نفرستند زیرا نیروهای مسلح جمهوری اسلامی فاقد توان پدافندی و نیروی هوایی است؛ بنابراین در پادگان‌ها و مقرها، سرباز و کادر بی‌دفاع هستند و فقط آمار تلفات بالا می‌رود، هرچند که حکومت تلاش می‌کند یا تبلیغات قربانی شدن نیروها را زیر عنوان «میهن‌دوستی» و «شجاعت» توجیه کند.\u003cbr/\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"?q=%23%D8%AE%D8%AF%D9%85%D8%AA_%D8%B3%D8%B1%D8%A8%D8%A7%D8%B2%DB%8C\"\u003e\u003cb\u003e#خدمت_سربازی\u003c/b\u003e\u003c/a\u003e\u003cb\u003e \u003c/b\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e\u003cb\u003e#سپر_انسانی\u003c/b\u003e\u003c/a\u003e\u003cb\u003e\u003cbr/\u003e\u003c/b\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e\u003cb\u003e@DEJradio\u003c/b\u003e\u003c/a\u003e",
