    {
      "id": 5799,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eپیام منتسب به مجتبی خامنه‌ای: نظرم به نظر پزشکیان نزدیک نبود\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدر تازه‌ترین پیام منتسب به مجتبی خامنه‌ای عنوان شد که در مورد توافق با آمریکا نظر دیگری داشته است.\u003cbr/\u003eدر این پیام تأکید شده که مسئولیت تفاهمنامه با پزشکیان و دیگر اعضای شورای عالی امنیت ملی نظام است.\u003cbr/\u003eرسانه‌های جمهوری اسلامی شامگاه پنجشنبه متن پیامی منتسب به مجتبی خامنه‌ای را منتشر کردند که در آن دربارهٔ تفاهم‌نامه میان تهران و واشینگتن موضع‌گیری شده است.\u003cbr/\u003eدر این پیام آمده است که خامنه‌ای  در اصل نسبت به این توافق نظر موافق نداشته است.\u003cbr/\u003eبنا بر ادعای منتسب به خامنه‌ای، او به دلیل تعهدی که مسعود پزشکیان به عنوان رئیس شورای عالی امنیت ملی و دیگر اعضای شورا دادند، با امضای یادداشت تفاهم موافقت کرده است.\u003cbr/\u003eدر پیام منتسب به رهبر جمهوری اسلامی، تفاهم‌ با آمریکا عملا به‌عنوان «تفاهم‌نامه‌ای بین روسای دولت جمهوری اسلامی و آمریکا» به‌نظر می‌رسد.\u003cbr/\u003eدر این پیام همچنین ادعا شده که مذاکرات حضوری آینده، به معنای پذیرش نظر آمریکا نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%D9%88%D8%B4%D8%AA%D8%A8%D8%A7\"\u003e#موشتبا\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%81%D8%A7%D9%87%D9%85\"\u003e#تفاهم\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
