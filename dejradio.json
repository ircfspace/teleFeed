    {
      "id": 7845,
      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس گزارش رسانه‌های هوانوردی ترکیه، شرکت‌های Havaş و Çelebi قراردادهای فعلی خود برای ارائه خدمات زمینی به شرکت‌های هواپیمایی ایرانی را خاتمه داده‌اند. \u003cbr/\u003e\u003cbr/\u003eبر اساس اطلاعات منتشرشده، این دو شرکت از ابتدای اکتبر ۲۰۲۶ ارائه خدمات زمینی به ایرلاین‌های ایرانی در فرودگاه‌های ترکیه را متوقف خواهند کرد.\u003cbr/\u003e\u003cbr/\u003eاین تصمیم در پی عملیات اقتصادی آمریکا علیه جمهوری اسلامی اتخاذ شده است. خدمات زمینی بخش مهمی از عملیات پرواز شامل هندلینگ مسافر، بار و برخی خدمات رمپ را دربر می‌گیرد و توقف همکاری این دو شرکت، ایرلاین‌های ایرانی را نیازمند استفاده از ارائه‌دهندگان جایگزین در فرودگاه‌های ترکیه خواهد کرد.\u003cbr/\u003e\u003cbr/\u003eدر حال حاضر بیش از ۱۳ شرکت هواپیمایی ایرانی به استانبول پرواز دارند و مجموع پروازهای آنها به این شهر نزدیک به ۱۰۰ پرواز در هفته اعلام شده است؛ علاوه بر استانبول، پروازهایی از ایران به مقاصدی همچون دنیزلی، ترابزون، اسپارتا و وان نیز انجام می‌شود.\u003cbr/\u003e\u003cbr/\u003eاین اقدام احتمال توقف پروازهای ایران به ترکیه را زیاد کرده است.‌\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%DA%A9%DB%8C%D9%87\"\u003e#ترکیه\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%DB%8C%D8%B1%D8%A7%D9%86_%D8%A7%DB%8C%D8%B1\"\u003e#ایران_ایر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%AD%D8%B1%DB%8C%D9%85\"\u003e#تحریم\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
