    {
      "id": 6377,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003cb\u003e اسرائیل برای هر واکنشی علیه جمهوری اسلامی آماده است \u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eیسرائیل کاتز، وزیر دفاع اسرائیل اعلام کرد ارتش این کشور برای هرگونه واکنش علیه رژیم حاکم بر ایران آمادگی دارد.\u003cbr/\u003eکاتز در پاسخ به تهدیدهای محمدباقر ذوالقدر، دبیر شورایعالی امنیت ملی جمهوری اسلامی نوشت ارتش اسرائیل هر لحظه برای حمله و دفاع در آمادگی کامل است.\u003cbr/\u003eمحمدباقر ذوالقدر پیش‌تر تهدید کرده بود که جمهوری اسلامی در پاسخ به حملات آمریکا اسرائیل را هدف قرار می‌دهد.\u003cbr/\u003e ذوالقدر، از فرماندهان پیشین سپاه، در پی کشته شدن علی لاریجانی در جریان جنگ چهل روزه، جایگزین او در سمت دبیری شورای عالی امنیت ملی جمهوری اسلامی شد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
