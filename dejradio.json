    {
      "id": 6326,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e فرود موشک‌های جمهوری اسلامی روی سفره‌های مردم\u003cbr/\u003e\u003cbr/\u003eیک هموطن از شهرستان چالدران در استان آذربایجان غربی با ارسال ویدیویی نوشت: \u0026#34;این دیوارنویسی اعتراضی با مضمون موشک‌های شما بر سفره مردم فرود می‌آیند که اینجا انجام دادم رو براتون ارسال می‌کنم. این حکومت مستبد و به‌ویژه سپاه پاسداران و احمد وحیدی فرمانده‌اش با این جنگ افروزی‌ها و موشک پراکنی‌هاشون اقتصاد کشور و معیشت مردم رو نابود کردن. همه این موارد نشانگر اینه که تنها با سقوط این حکومت ضدملی، اقتصاد کشور و سفره مردم نجات پیدا خواهند کرد!\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%B1%D9%85\"\u003e#تورم\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%AA%D8%A7%D9%86_%D8%A2%D8%B0%D8%B1%D8%A8%D8%A7%DB%8C%D8%AC%D8%A7%D9%86\"\u003e#استان_آذربایجان\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
