    {
      "id": 7343,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e کارزار شناسایی سرکوبگران؛\u003cbr/\u003eامیرعلی وزیری مخبر بـ.ـسیجی و بازجو \u003cbr/\u003e\u003cbr/\u003eامیرعلی وزیری از عوامل موتوری بسـ.ـیج که نقش اساسی در سرکوب مردم در قیام ۱۸و ۱۹ دی‌ماه ۱۴۰۴ در محلات پردیس، تهرانپارس، حکیمیه، صادقیه و ایستگاه بانک نازی‌آباد داشت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%85%DB%8C%D8%B1%D8%B9%D9%84%DB%8C_%D9%88%D8%B2%DB%8C%D8%B1%DB%8C\"\u003e#امیرعلی_وزیری\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DB%8C%DB%B1%DB%B4%DB%B0%DB%B4\"\u003e#دی۱۴۰۴\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
