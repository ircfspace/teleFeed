    },
    {
      "id": 6066,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003e اگر اسرائیل از غزه خارج می‌شد خامنه‌ای، نصرالله و اسد همچنان بر سر قدرت بودند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبنیامین نتانیاهو، نخست‌وزیر اسرائیل روز دوشنبه اعلام کرد که باقی ماندن نیروهای اسرائیل در غزه، مانع از حفظ قدرت توسط رهبران جمهوری اسلامی، حماس، حزب‌الله و حکومت پیشین سوریه شده است.\u003cbr/\u003eنتانیاهو در نشست با فرماندهان ارشد ارتش گفت برخی پیشنهاد کرده بودند اسرائیل در ازای آزادی همۀ گروگان‌ها از غزه خارج شود، اما او این گزینه را «یک شکست بزرگ» دانست و آن را رد کرد.\u003cbr/\u003eاو افزود تنها راه درست، ترکیب فشار نظامی شدید، فشار دیپلماتیک و در صورت امکان، برخورداری از پشتیبانی آمریکا بود.\u003cbr/\u003eنخست‌وزیر اسرائیل تأکید اگر اسرائیل شروط حماس را می‌پذیرفت محمد الضیف، یحیی سنوار، اسماعیل هنیه، حسن نصرالله، علی خامنه‌ای و بشار اسد همگی همچنان بر مسند قدرت بودند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%DB%8C%D8%A7%D9%85%DB%8C%D9%86_%D9%86%D8%AA%D8%A7%D9%86%DB%8C%D8%A7%D9%87%D9%88\"\u003e#بنیامین_نتانیاهو\u003c/a\u003e  \u003ca href=\"?q=%23%D8%B3%D8%B1_%D8%A7%D8%AE%D8%AA%D8%A7%D9%BE%D9%88%D8%B3\"\u003e#سر_اختاپوس\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/Dejradio\" target=\"_blank\"\u003e@Dejradio\u003c/a\u003e",
