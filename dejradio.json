      "message": "\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e منابع محلی در استان سیستان و بلوچستان، گزارش دادند که نیروهای سـ.ـپاه پاسداران در مناطق مرزی سراوان اقدام به مین‌گذاری کرده‌اند. \u003cbr/\u003e\u003cbr/\u003eگفته شد مناطقی که مین‌گذاری شده، محل تردد شهروندان عشایر بلوچ، دامداران، سوخت‌بران، مسافران و دیگر ساکنان منطقه است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%85%DB%8C%D9%86_%DA%AF%D8%B0%D8%A7%D8%B1%DB%8C\"\u003e#مین_گذاری\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%DB%8C%D8%B3%D8%AA%D8%A7%D9%86\"\u003e#سیستان\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
