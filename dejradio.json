    {
      "id": 9313,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5841473431744287874\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9B91.png\u0026#39;)\"\u003e\u003cb\u003e🛑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eبلومبرگ: احتمال آغاز دور تازه حملات گسترده آمریکا علیه جمهوری اسلامی افزایش یافته است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eخبرگزاری بلومبرگ روز پنجشنبه ۱۹ نوامبر در گزارشی اختصاصی به نقل از مقام‌های غربی اعلام کرد که با تشدید درگیری‌های نظامی پراکنده میان آمریکا و جمهوری اسلامی،احتمال آغاز دور تازه‌ای از حملات گسترده ایالات متحده علیه مواضع رژیم در ایران افزایش یافته است.\u003cbr/\u003eبر اساس این گزارش،دونالد ترامپ هنوز تصمیم نهایی خود را برای صدور فرمان حمله اتخاذ نکرده،اما به گفته یک مقام آگاه،گزینه ازسرگیری عملیات نظامی گسترده همچنان به‌طور جدی در دست بررسی است.\u003cbr/\u003eبلومبرگ نوشت که ترامپ طی هفته‌های گذشته بارها درباره آغاز مرحله تازه‌ای از جنگ شدید علیه جمهوری اسلامی هشدار داده،اما پس از انتخابات میان‌دوره‌ای آمریکا و شکست جمهوری‌خواهان در کسب اکثریت کنگره،با فشارهای سیاسی برای یافتن راه‌حلی دیپلماتیک روبه‌رو شده است.\u003cbr/\u003eبلومبرگ به بن‌بست مذاکرات و افزایش درگیری‌ها در منطقه،به‌ویژه تنگه هرمز اشاره کرده؛ شرایطی که به ارزیابی تحلیلگران،خطر تبدیل برخوردهای محدود نظامی به یک رویارویی گسترده را افزایش داده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D9%86%DA%AF%D9%87_%D9%87%D8%B1%D9%85%D8%B2\"\u003e#تنگه_هرمز\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D8%B3%D8%A7%D9%86%D9%87_%D8%AE%D8%A7%D8%B1%D8%AC%DB%8C\"\u003e#رسانه_خارجی\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
