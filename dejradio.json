    {
      "id": 6697,
      "message": "\u003ctg-emoji emoji-id=\"5841473431744287874\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9B91.png\u0026#39;)\"\u003e\u003cb\u003e🛑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eوال‌استریت ژورنال: جمهوری اسلامی هزاران سانتریفیوژ را به تأسیسات زیرزمینی کوه کلنگ در نزدیکی نطنز منتقل کرده است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eروزنامه وال‌استریت ژورنال به نقل از مقام‌های آمریکایی و اسرائیلی گزارش داد جمهوری اسلامی پاییز گذشته هزاران سانتریفیوژ غنی‌سازی اورانیوم را به تأسیسات زیرزمینی واقع در اعماق کوه کلنگ، در جنوب مجتمع هسته‌ای نطنز، منتقل کرده است.\u003cbr/\u003eبر اساس این گزارش، انتقال این تجهیزات پس از جنگ ۱۲ روزه ژوئن ۲۰۲۵ و در پی حملات آمریکا و اسرائیل به سه مرکز اصلی هسته‌ای جمهوری اسلامی در عملیات موسوم به «چکش نیمه‌شب» انجام شده است.\u003cbr/\u003eمقام‌های آمریکایی و اسرائیلی معتقدند استقرار سانتریفیوژها در اعماق این کوه نشان‌دهنده تلاش جمهوری اسلامی برای حفظ توان غنی‌سازی اورانیوم، حتی در صورت حملات نظامی گسترده، است.\u003cbr/\u003eبه گزارش وال‌استریت ژورنال، مجموعه تونلی در حال ساخت زیر کوه کلنگ در هیچ‌یک از حملات پیشین هدف قرار نگرفته و تصاویر ماهواره‌ای نشان می‌دهد این تأسیسات در عمقی بیش از ۱۰۰ متر زیر سنگ‌های کوه ساخته شده؛ عمقی که حتی نفوذ به آن برای پیشرفته‌ترین بمب‌های سنگرشکن آمریکا نیز بسیار دشوار ارزیابی می‌شود.\u003cbr/\u003eجمهوری اسلامی مدعی است این مجموعه تنها برای تولید و مونتاژ سانتریفیوژهای پیشرفته ساخته شده و مرکز فعال غنی‌سازی نیست، اما تاکنون از ورود بازرسان آژانس بین‌المللی انرژی اتمی به این محل جلوگیری کرده است.\u003cbr/\u003eدر همین حال، رافائل گروسی، مدیرکل آژانس بین‌المللی انرژی اتمی، خواستار ارائه توضیحات درباره فعالیت‌های این سایت شده، اما به گفته این گزارش، پاسخ‌های جمهوری اسلامی برای راستی‌آزمایی ادعاهای تهران یا رد احتمال وجود مواد هسته‌ای در این مجموعه کافی نبوده است.\u003cbr/\u003eوال‌استریت ژورنال همچنین نوشت استحکام و عمق این تأسیسات، آن را به یکی از اهداف اصلی در تقابل میان ایالات متحده و جمهوری اسلامی تبدیل کرده است. دونالد ترامپ نیز پیش‌تر تهدید کرده بود این سایت را نابود خواهد کرد و اعلام کرده بود دولت آمریکا فعالیت‌های اطراف ورودی‌های تونل را به دقت زیر نظر دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D9%88%D9%87_%DA%A9%D9%84%D9%86%DA%AF\"\u003e#کوه_کلنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D9%87_%D8%A7%D8%AA%D9%85%DB%8C\"\u003e#برنامه_اتمی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
