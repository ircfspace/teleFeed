    {
      "id": 5417,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسرائیل: فرماندۀ مرتبط با حملۀ تروریستی ۷ اکتبر در جنوب غزه کشته شد\u003cbr/\u003e\u003cbr/\u003eارتش اسرائیل و شاباک اعلام کردند صقر ابوکریم، از فرماندهان «یگان نخبۀ حماس» در حمله‌ای در جنوب نوار غزه کشته شد.\u003cbr/\u003eشبه‌نظامیان حماس که توسط جمهوری اسلامی پشتیبانی می‌شوند، در سیاهۀ تروریستی اتحادیۀ اروپا و آمریکا قرار دارند.\u003cbr/\u003eبه گفتۀ ارتش اسرائیل، صقر ابوکریم در حملۀ تروریستی هفتم اکتبر ۲۰۲۳ فرماندۀ یورش به منطقۀ کیسوفیم بوده است.\u003cbr/\u003eارتش اسرائیل اعلام کرد این فرماندۀ حماس در ماه‌های اخیر در بازسازی توان عملیاتی، نگهداری سلاح و آموزش نیروها نقش داشت.\u003cbr/\u003eاسرائیل اعلام کرد در این حمله، یکی از مسئولان ارتباطات حماس نیز کشته شد.\u003cbr/\u003eارتش اسرائیل می‌گوید این عملیات بخشی از روند هدف‌گیری افراد مرتبط با حملۀ تروریستی هفتم اکتبر است.\u003cbr/\u003eاسرائیل در هفته‌های پیشین نیز از کشته شدن چند فرماندۀ دیگر حماس خبر داده بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e  \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D8%A7%D8%B3\"\u003e#حماس\u003c/a\u003e \u003ca href=\"?q=%23%D9%87%D9%81%D8%AA%D9%85_%D8%A7%DA%A9%D8%AA%D8%A8%D8%B1\"\u003e#هفتم_اکتبر\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
