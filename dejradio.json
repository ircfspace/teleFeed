    {
      "id": 5175,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e خانۀ کارگر بندر شاهپور از موج تازۀ تعدیل نیرو در این بندر و ماهشهر خبر داد\u003cbr/\u003e\u003cbr/\u003eابراهیم پیرایش، دبیر اجرایی خانۀ کارگر بندر شاهپور، از آغاز موج تازۀ تعدیل نیرو در ماهشهر و بندر شاهپور خبر داد.\u003cbr/\u003eبه گفتۀ او گفت برخی شرکت‌ها بدون رعایت ضوابط قانونی، کارگران را اخراج می‌کنند.\u003cbr/\u003eپیرایش افزود برخی از شرکت‌های پیمانکاری از جمله پتروناد و لوله‌سازی ماهشهر، با وجود ممنوعیت اخراج از سوی شورای کارگری فرمانداری، نیروهای خود را تعدیل می‌کنند.\u003cbr/\u003eبه گفته پیرایش، برخی شرکت‌ها با این استدلال که پروژه‌ها به پایان رسیده است اقدام به اخراج نیروها می‌کنند، در حالی که کار پایان نیافته است.\u003cbr/\u003eاو افزود در برخی از واحدها اخراج‌های دسته‌جمعی ۳۰ تا ۴۰ نفره و حتی بالای ۱۰۰ نفر گزارش شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%A7%D8%B1%DA%AF%D8%B1%D8%A7%D9%86\"\u003e#کارگران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
