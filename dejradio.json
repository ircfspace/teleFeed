    {
      "id": 8857,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e یک کشتی کانتینربر، پنجشنبه هفتم آبان ۱۴۰۵، متعلق به شرکت کشتیرانی اسرائیلی «زیم» (ZIM)، در دریای سیاه هدف حمله پهپادی (یا شهپادی) قرار گرفت.  \u003cbr/\u003e\u003cbr/\u003eاین شرکت در سال ۱۹۴۵ در اسرائیل تأسیس شده و سهام آن در بورس نیویورک معامله می‌شود. \u003cbr/\u003eمبدا شلیک هنوز پیدا نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
