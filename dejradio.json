      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e بر اساس تصاویری که از منابع محلی در شبکه‌های اجتماعی به اشتراک گذاشته شده، سـ.ـپاه از تونل «پونه» واقع در استان لرستان (جاده بروجرد- خرم‌آباد) به عنوان سپر انسانی استفاده کرده است. \u003cbr/\u003e\u003cbr/\u003eزمان دقیق این تصاویر مشخص نیست اما طی جنگ ۱۲ روزه و ۴۰ روزه چندین تونل هدف حمله قرار گرفت.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B3%D9%BE%D8%B1_%D8%A7%D9%86%D8%B3%D8%A7%D9%86%DB%8C\"\u003e#سپر_انسانی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A8%D8%B1%D9%88%D8%AC%D8%B1%D8%AF\"\u003e#بروجرد\u003c/a\u003e \u003ca href=\"?q=%23%D8%AE%D8%B1%D9%85_%D8%A2%D8%A8%D8%A7%D8%AF\"\u003e#خرم_آباد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
