    {
      "id": 5733,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e اسرائیل هیوم گزارش داد آمریکا یک ماه پیش با دادوستد مالی قطر و جمهوری اسلامی موافقت کرده بود\u003cbr/\u003e\u003cbr/\u003eروزنامۀ اسرائیل هیوم به نقل از سه مقام دیپلماتیک گزارش داد دولت دونالد ترامپ درحدود یک ماه پیش به‌صورت محرمانه با یک توافق مالی و دریایی میان قطر و جمهوری اسلامی موافقت کرده بود.\u003cbr/\u003eبر پایۀ این گزارش، قطر در چارچوب یک تفاهم «میلیاردها دلار» را در اختیار تهران قرار داد.\u003cbr/\u003eاز سویی جمهوری اسلامی نیز عبور آزاد کشتی‌ها و نفتکش‌های قطری را از تنگۀ هرمز تضمین کرده بود.\u003cbr/\u003eبه گزارش اسرائیل هیوم، مبادلات دوحه و تهران، با آگاهی و موافقت واشینگتن انجام شد.\u003cbr/\u003eبنا بر این گزارش، هدف ترامپ از این چشم‌پوشی بر انتقال پول به تهران، کاهش تنش در بازار جهانی انرژی و جلوگیری از جهش قیمت نفت بوده است.\u003cbr/\u003eبه گزارش رسانۀ اسرائیلی، بخشی از پرداخت‌ها در پوشش هزینۀ عبور کشتی‌ها انجام شد. همچنین یک خط اعتباری  برای خرید کالا تا سقف یک میلیارد دلار نیز توسط قطر ایجاد شد.\u003cbr/\u003eبه گزارش اسرائیل هیوم، افشای این توافق نشان می‌دهد زمینۀ تفاهم کنونی میان واشینگتن و جمهوری اسلامی از هفته‌ها پیش و از مسیر همکاری نزدیک آمریکا و قطر در حال شکل‌گیری بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D8%B1%D8%A7%D9%85%D9%BE\"\u003e#ترامپ\u003c/a\u003e \u003ca href=\"?q=%23%D9%82%D8%B7%D8%B1\"\u003e#قطر\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
