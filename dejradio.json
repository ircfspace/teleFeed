    {
      "id": 5328,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e جنگ ۴۰ روزه؛\u003cbr/\u003eانهدام گاراژ کامیون‌ها در تبریز به دلیل استقرار دو لانچر\u003cbr/\u003e\u003cbr/\u003eدر تبریز به علت استقرار دو لانچر موشک در گاراژ کامیون‌ها ده‌ها دستگاه تریلی در بمباران از بین رفتند و هیچ مقامی پاسخگو نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF%DB%B4%DB%B0%D8%B1%D9%88%D8%B2%D9%87\"\u003e#جنگ۴۰روزه\u003c/a\u003e \u003ca href=\"?q=%23%D8%AA%D8%A8%D8%B1%DB%8C%D8%B2\"\u003e#تبریز\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D8%A7%D9%85%DB%8C%D9%88%D9%86%D8%AF%D8%A7%D8%B1%D8%A7%D9%86\"\u003e#کامیونداران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
