    {
      "id": 9011,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e بر اساس ویدیوهایی که آدینه ۱۵ آبان ۱۴۰۵، از تهران منتشر شد، یک فروند بوئینگ «ساها» متعلق به نیروی هوایی در فرودگاه مهرآباد پرواز آزمایشی انجام داده است.\u003cbr/\u003e\u003cbr/\u003eاین هواپیما بیش از ۱۰ سال زمینگیر بود و سه الی چهار سال تعمیرات (اورهال) آن طول کشید و حالا نخستین پرواز خود را پس از مدت‌ها انجام داد.\u003cbr/\u003e \u003cbr/\u003eاین بویینگ که قبلا به عنوان سوخت‌رسان نیروی هوایی ارتش فعال بود، پس از تغییر کاربری به مسافربری تبدیل اما با محدود شدن فعالیت ساها زمینگیر شد. \u003cbr/\u003e\u003cbr/\u003eاکنون که این بوئینگ پس از سال‌ها به پرواز درآمده رنگ آن تغییر کرده و شبیه هواپیماهای بوئینگ ۷۰۷ نیروی هوایی اسرائیل رنگ‌آمیزی شده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%81%D8%B1%D9%88%D8%AF%DA%AF%D8%A7%D9%87_%D9%85%D9%87%D8%B1%D8%A2%D8%A8%D8%A7%D8%AF\"\u003e#فرودگاه_مهرآباد\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
