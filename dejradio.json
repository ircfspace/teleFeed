    {
      "id": 5217,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e منابع میدانی از استان لرستان گزارش دادند یکی از عوامل اصلی سرکوب مردم در خیزش ملی دی‌ماه ۱۴۰۴ در خرم‌آباد سرهنگ پاسدار بازنشسته  قباد اصل‌مرز است. \u003cbr/\u003e\u003cbr/\u003eاو همچنین مخبر سـ.ـپاه است و سردسته اراذل و اوباش ۶۰۰ تا ۷۰۰ نفری که هدایت آنها در تجمعات شبانه را هم بر عهده دارد.\u003cbr/\u003e\u003cbr/\u003eاو در سال ۱۴۰۱ نیز در سرکوب مردم ازنا و الیگودرز میدان‌دار بود.\u003cbr/\u003eقباد اصل‌مرز  با نام مستعار «ابوحسام»  سابقه حضور در جنگ سوریه در حمایت از رژیم بشار اسد را دارد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%DA%A9%D8%A7%D8%B1%D8%B2%D8%A7%D8%B1_%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C_%D8%B3%D8%B1%DA%A9%D9%88%D8%A8%DA%AF%D8%B1%D8%A7%D9%86\"\u003e#کارزار_شناسایی_سرکوبگران\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
