    {
      "id": 8097,
      "message": "\u003ctg-emoji emoji-id=\"5186162212372218744\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F938C.png\u0026#39;)\"\u003e\u003cb\u003e📌\u003c/b\u003e\u003c/i\u003e شاهزاده رضا پهلوی در گفت‌وگو با فاکس‌نیوز، خواستار تغییر راهبرد حمایت از مردم ایران و «تجهیز» آن‌ها در برابر سرکوب شد. او پیشنهاد کرد دارایی‌های مسدودشده ایران برای پشتیبانی از این مبارزه به کار گرفته شود.\u003cbr/\u003e\u003cbr/\u003eشاهزاده رضا پهلوی در این گفت‌وگو که پنجشنبه دوم مهرماه ۱۴۰۵ منتشز شد به روشنی گفت: «مردم ایران دست خالی‌اند و اراذل و اوباش رژیم به  آنها شلیک می‌کنند. پیشنهاد می‌دهم به دونالد ترامپ به جای آنکه نیروی زمینی به ایران بفرستد مردم ایران را تجهیز کند و منبع تامین پول این پشتیبانی‌ها می‌تواند میلیون‌ها دلار دارایی‌های مسدود شده ایران باشد.»\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D9%86%D9%82%D9%84%D8%A7%D8%A8_%D8%B4%DB%8C%D8%B1%D9%88%D8%AE%D9%88%D8%B1%D8%B4%DB%8C%D8%AF\"\u003e#انقلاب_شیروخورشید\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%A8%D8%A7%D8%B1%D8%B2%D9%87_%D9%85%D8%B3%D9%84%D8%AD%D8%A7%D9%86%D9%87\"\u003e#مبارزه_مسلحانه\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
