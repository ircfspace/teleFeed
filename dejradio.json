    {
      "id": 5243,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"6048749957903555159\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A1.png\u0026#39;)\"\u003e\u003cb\u003e📡\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003eشاهدخت نور پهلوی: ائتلاف مخالفان جمهوری اسلامی رو به گسترش است\u003cbr/\u003e\u003cbr/\u003eشاهدخت نور پهلوی در نشست انجمن آزادی اسلو گفت شاهزاده رضا پهلوی و ائتلاف رو به گسترش او، در پاسخ به خواستۀ مردم ایران برای رهبری دوران گذار آماده‌اند.\u003cbr/\u003eاو با اشاره به نشست همبستگی ملی در مونیخ گفت نمایندگان گرایش‌های مختلف سیاسی، مذهبی و قومی برای شکل دادن به ائتلافی گسترده علیه جمهوری اسلامی گردهم آمدند.\u003cbr/\u003eفرزند ارشد شاهزاده رضا پهلوی، در نشست نروژ گفت هدف خانوادۀ پهلوی گذار به انتخابات آزاد و منصفانه در ایران است و آنها برای بازگرداندن پادشاهی مبارزه نمی‌کنند.\u003cbr/\u003eبه گفتۀ شاهدخت نور پهلوی، پروژۀ شکوفایی ایران برای دوران گذار آماده است. شاهدخت گفت این پروژه یک نقشۀ راه عمومی برای بازسازی کشور پس از جمهوری اسلامی است. او افزود آیندۀ ایران به امیدواری منحصر نمی‌شود، بلکه برای آن برنامه‌ریزی شده است.\u003cbr/\u003eشاهدخت نور پهلوی یادآور شد که جمهوری اسلامی حکومت نیست، بلکه نیرویی اشغالگر است که از منابع و جان ایرانیان برای تثبیت قدرت خود استفاده می‌کند. او افزود که جمهوری اسلامی نمایندۀ مردم ایران نیست.\u003cbr/\u003eشاهدخت نور پهلوی گفت جمهوری اسلامی هیچ مشروعیتی برای سخن گفتن به نام ایران ندارد. او گفت کشته‌شدگان اعتراضات اخیر نشان دادند جمهوری اسلامی ازهیچ پشتوانۀ مردمی و حقی برای نمایندگی مردم ایران، برخوردار نیست.\u003cbr/\u003eشاهدخت نور پهلوی گفت بیمناک بودن از دریافت خبر اعدام افراد بیشتری در ایران، سبب شده که هر صبح با ترس اخبار را پی می‌گیرد.\u003cbr/\u003eشاهدخت نور پهلوی گفت که با روایت‌های مادربزرگ خود دربارۀ ایران بزرگ شده است. به گفتۀ او، شهبانو فرح پهلوی از ایرانی سخن می‌گفت با خیابان‌های پر از رنگ، زنده با موسیقی، هنر، بحث، جاه‌طلبی و سرشار از امکان.\u003cbr/\u003eشاهدخت نور پهلوی افزود بر اساس آموزه‌های شهبانو آن تصویری از کشور ایران در ذهنش نقش بسته است که ستون صلح، رفاه و ثبات منطقه و متحد جهان غرب بود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%AF%D8%AE%D8%AA\"\u003e#شاهدخت\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%D9%88%D8%B1_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#نور_پهلوی\u003c/a\u003e  \u003ca href=\"?q=%23%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#پهلوی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D9%84%D9%88\"\u003e#اسلو\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
