    {
      "id": 8382,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5951842387465605469\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eانتقال ۲۰۰میلیون دلار از جمهوری اسلامی به حزب‌الله؛ واسطه‌ها ۲۰درصد کارمزد گرفتند\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eبا وجود بحران اقتصادی در ایران و شرایط طاقت فرسای زندگی ایرانیان، جمهوری اسلامی ماه گذشته ۲۰۰میلیون دلار در اختیار گروه تروریستی حزب‌الله لبنان قرار داده است؛ انتقالی که با وجود تشدید فشارهای اقتصادی آمریکا و دشوارتر شدن مسیرهای تأمین مالی این گروه انجام شده است.\u003cbr/\u003eبه گزارش جروزالم‌پست به نقل از دو منبع مطلع، واسطه‌های انتقال پول به دلیل ریسک بالای معامله با حزب‌الله، \u003cb\u003e۲۰درصد از مبلغ را به‌عنوان کارمزد دریافت کرده‌اند؛ رقمی چهار برابر نرخ معمول\u003c/b\u003e.\u003cbr/\u003eقرار است حزب‌الله از این منابع در مرحله نخست به حدود ۵۰هزار خانواده،نفری ۳هزار دلار پرداخت کند. \u003cbr/\u003eپیشتر وزارت خزانه‌داری آمریکا اعلام کرده بود جمهوری اسلامی تنها در ۱۰ماه نخست سال ۲۰۲۵ حدود \u003cb\u003eیک‌میلیارد دلار\u003c/b\u003e به حزب‌الله منتقل کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003ca href=\"?q=%23%D9%84%D8%A8%D9%86%D8%A7%D9%86\"\u003e#لبنان\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
