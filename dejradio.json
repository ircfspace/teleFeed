    {
      "id": 8037,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e جت‌های جنگنده ناتو در بالتیک دوشنبه شب ۳۰ شهریور ۱۴۰۵ به‌دلیل احتمال وجود یک تهدید هوایی در شهر کرَسلاوا لتونی، به پرواز درآمدند.\u003cbr/\u003e\u003cbr/\u003eبه ساکنان اعلام شد که در حال حاضر نیازی به انجام اقدام اضافی نیست. ماهیت تهدید احتمالی هنوز اعلام نشده است.\u003cbr/\u003e\u003cbr/\u003eلتونی با روسیه و بلاروس مرز مشترک دارد.\u003cbr/\u003eپیش‌تر سرویس‌های اطلاعاتی اروپا هشدار داده بودند روسیه در حال برنامه‌ریزی برای اقدام علیه ناتو است.\u003cbr/\u003e\u003cbr/\u003eمیخال کودِلکا، رئیس سرویس امنیتی جمهوری چک (BIS)، گفته بود بخشی از عملیات روسیه ممکن است علاوه بر افزایش فعالیت پهپادها، یک تهاجم محدود به خاک یکی از کشورهای عضو ناتو باشد.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AC%D9%86%DA%AF\"\u003e#جنگ\u003c/a\u003e \u003ca href=\"?q=%23%D8%B1%D9%88%D8%B3%DB%8C%D9%87\"\u003e#روسیه\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
