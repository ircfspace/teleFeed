    {
      "id": 8211,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e بر اساس اطلاعات سایت «فلایت رادار ۲۴»، هواپیمای بوئینگ شرکت اماراتی «فلای دوبی» به مقصد تل‌آویو روز چهارشنبه هشتم مهرماه ۱۴۰۵ در آسمان اردن کد «۷۷۰۰» (اضطراری عمومی) ارسال کرد اما پس از مدت اندکی کد به «۷۵۰۰» (هواپیماربایی- مداخله) تغییر کرد. \u003cbr/\u003eهواپیما در فرودگاه تبوک (عربستان سعودی) فرود آمد.\u003cbr/\u003e\u003cbr/\u003eبرخی منابع گزارش دادند در هواپیما درگیری پیش آمده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D9%88%D8%A7%D9%BE%DB%8C%D9%85%D8%A7%D8%B1%D8%A8%D8%A7%DB%8C%DB%8C\"\u003e#هواپیماربایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D9%85%D8%A7%D8%B1%D8%A7%D8%AA\"\u003e#امارات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
