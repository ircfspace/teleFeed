    {
      "id": 7459,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e هم‌زمان با ذخیره‌سازی اضطراری سوخت توسط نیروهای مسلح، بر اساس گزارش منابع میدانی، روز دوشنبه سوم شهریور ۱۴۰۵ به علت کمبود بنزین صف‌های طولانی چند کیلومتری در جایگاه‌های سوخت ایجاد شد که امتداد آن به خروجی برخی بزرگراه‌ها و اتوبان‌های اصلی کشید و در برخی مناطق ترافیک قفل شد.\u003cbr/\u003e\u003cbr/\u003eدر مناطق شمالی تهران عملا بنزین نایاب شده است. شهروندان می‌گویند پمپ بنزین‌ در محله‌های پاسداران و فرمانیه کلا تعطیل است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A8%D9%86%D8%B2%DB%8C%D9%86\"\u003e#بنزین\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%88%D8%AE%D8%AA\"\u003e#سوخت\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D9%85%D8%A8%D9%88%D8%AF_%D8%A8%D9%86%D8%B2%DB%8C%D9%86\"\u003e#کمبود_بنزین\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
