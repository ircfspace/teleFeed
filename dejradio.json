    {
      "id": 4994,
      "message": "\u003ctg-emoji emoji-id=\"5949286409478082944\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/E2AD95.png\u0026#39;)\"\u003e\u003cb\u003e⭕️\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e لاپید: توافق احتمالی تهران و واشینگتن اهداف اسرائیل از جنگ را برآورده نمی‌کند\u003cbr/\u003e\u003cbr/\u003eیائیر لاپید، رهبر مخالفان دولت مستقر اسرائیل گفت تفاهمی که میان آمریکا و جمهوری اسلامی در حال شکل‌گیری است، برای اسرائیل، منطقه و مردم ایران توافقی بد به شمار می‌رود.\u003cbr/\u003eنخست‌وزیر پیشین اسرائیل گفت این توافق هیچ‌یک از اهداف اعلام‌شدۀ اسرائیل از جنگ، از جمله نابودی برنامۀ موشکی و هسته‌ای جمهوری اسلامی و پایان پشتیبانی تهران از گروه‌های نیابتی را برآورده نمی‌کند.\u003cbr/\u003e رهبر مخالفان دولت نتانیاهو تأکید کرد کشورش باید آزادی عمل خود را در موازات با عملکرد دولت ایالات متحده، حفظ کند.\u003cbr/\u003eمقامات آمریکایی پیش‌تر تأکید کردند توافق با جمهوری اسلامی یا کامل و معنادار انجام می‌شود، یا هیچ توافقی در کار نیست.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AE%D8%A8%D8%B1\"\u003e#خبر\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DA%98\"\u003e#دژ\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e \u003ca href=\"?q=%23%D8%A7%D8%B3%D8%B1%D8%A7%D8%A6%DB%8C%D9%84\"\u003e#اسرائیل\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
