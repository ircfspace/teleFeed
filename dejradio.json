    {
      "id": 6210,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA5.png\u0026#39;)\"\u003e\u003cb\u003e🎥\u003c/b\u003e\u003c/i\u003e اعتصاب کارگران معدن مس درخشان؛ «سه ماه حقوق نگرفته‌ایم»\u003cbr/\u003e \u003cbr/\u003eکارگران معدن مس درخشان تخت گنبد سیرجان روز شنبه ۱۳ تیر ۱۴۰۵، در اعتراض به پرداخت نشدن حقوق سه ماه گذشته خود، دست از کار کشیدند و اعتصاب کردند.\u003cbr/\u003eبه گفته منابع محلی، کارگران با تجمع در محل معدن، خواستار پرداخت فوری مطالبات معوقه و رسیدگی به وضعیت معیشتی خود شدند.\u003cbr/\u003eکارگران می‌گویند با وجود گذشت سه ماه، هنوز حقوق و مطالبات مزدی آن‌ها پرداخت نشده و ادامه این وضعیت، فشار اقتصادی سنگینی بر خانواده‌هایشان وارد کرده است. آنان خواستار تعیین تکلیف هرچه سریع‌تر مطالبات معوقه و پایان بلاتکلیفی خود هستند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%B9%D8%AA%D8%B5%D8%A7%D8%A8_%DA%A9%D8%A7%D8%B1%DA%AF%D8%B1%D8%A7%D9%86\"\u003e#اعتصاب_کارگران\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
