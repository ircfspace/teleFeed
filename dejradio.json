    {
      "id": 7765,
      "message": "\u003ctg-emoji emoji-id=\"5900170756913893630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9280.png\u0026#39;)\"\u003e\u003cb\u003e💀\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5836934557550516347\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e منابع خبری استان سیستان و بلوچستان سه‌شنبه ۱۷ شهریور ۱۴۰۵ گزارش دادند عبدالرئوف اسحاقی» فرمانده پایگاه مقاومت بسیج پارود از توابع شهرستان راسک، مقابل منزلش هدف تیراندازی افراد مسلح قرار گرفت و کشته شد.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش، افراد مسلح که سوار بر دو دستگاه موتورسیکلت بودند، عبدالرئوف اسحاقی را با تیراندازی رگباری هدف قرار داده و پس از آن از محل متواری شدند.  \u003cbr/\u003eوی اهل روستای پراهین گواش شهرستان راسک بوده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%B1%D8%A7%D8%B3%DA%A9\"\u003e#راسک\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D8%B0%D9%81_%D9%87%D8%AF%D9%81%D9%85%D9%86%D8%AF\"\u003e#حذف_هدفمند\u003c/a\u003e \u003ca href=\"?q=%23%D8%AD%D9%85%D9%84%D9%87_%D9%85%D8%B3%D9%84%D8%AD%D8%A7%D9%86%D9%87\"\u003e#حمله_مسلحانه\u003c/a\u003e \u003ca href=\"?q=%23IRGCterrorists\"\u003e#IRGCterrorists\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
