    {
      "id": 7037,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93A2.png\u0026#39;)\"\u003e\u003cb\u003e📢\u003c/b\u003e\u003c/i\u003e اعتراض یک شهروند به کمبود دارو\u003cbr/\u003e\u003cbr/\u003eیکی از مخاطبان دژ با ارسال یک ویدیو نوشت: \u0026#34;سلام و وقت بخیر، ساکن ایلام هستم و این پوسترهای اعتراضی رو که دیشب بر دیوار داروخانه نصب کردم رو براتون ارسال می‌کنم. چند روز پیش اومدم برای فرزندم دارو بخرم ولی این بار هم باز دارویی موجود نبود. \u003cbr/\u003e\u003cbr/\u003eگروه دارو و سلامت برکت که تحت ستاد اجرایی فرمان امام فعالیت می‌کنه و مهدی شیری - مدیر عامل این گروه دارویی - که منصوب نهادهای حکومتی هست هیچ ارزشی برای جان و سلامت مردم قائل نیستن و فقط به فکر منافع شخصی خودشون هستن. \u003cbr/\u003e\u003cbr/\u003eمهدی شیری و گروه دارویی برکت در تولید کافی دارو، توزیع عادلانه آن در سراسر کشور و کسب استانداردهای لازم ناتوان هستن و فقط در راستای منافع اقتصادی جمهوری اسلامی و نهاد های حکومتی فعالیت می‌کنن. ملت در مقابل چنین اشخاص و موسسات فاسد و دست نشانده حکومت ساکت نخواهد نشست!\u0026#34;\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AF%D8%A7%D8%B1%D9%88\"\u003e#دارو\u003c/a\u003e \u003ca href=\"?q=%23%D8%B3%D9%84%D8%A7%D9%85%D8%AA\"\u003e#سلامت\u003c/a\u003e \u003ca href=\"?q=%23%DA%A9%D9%85%D8%A8%D9%88%D8%AF_%D8%AF%D8%A7%D8%B1%D9%88\"\u003e#کمبود_دارو\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
