    {
      "id": 132380,
      "message": "\u003ca href=\"https://pepurl.com/p/5POoN?at_medium=Messenger\u0026amp;amp;at_campaign=Telegram\u0026amp;amp;at_channel=DW_Persian\u0026amp;amp;at_dw_language=fa-ir\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B6.png\u0026#39;)\"\u003e\u003cb\u003e🔶\u003c/b\u003e\u003c/i\u003eهدف قرار گرفتن یک نفتکش در نزدیکی سواحل امارات؛ خدمه تخلیه شدند\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eمرکز عملیات تجارت دریایی بریتانیا از هدف قرار گرفته شدن یک نفتکش با پرتابه‌ای ناشناس در نزدیکی رأس‌الخیمه امارات متحده عربی خبر داد.\u003cbr/\u003e\u003cbr/\u003eبه گزارش این مرکز، این حادثه روز ۱۱ نوامبر ۲۰۲۶، در فاصله ۱۴ مایل دریایی شمال‌غرب رأس‌الخیمه رخ داده و پرتابه به بخش موتورخانه نفتکش اصابت کرده است.\u003cbr/\u003e\u003cbr/\u003eبنا به این گزارش از تلفات جانی خبری دریافت نشده و همه خدمه کشتی به‌سلامت تخلیه شده‌اند.\u003cbr/\u003e\u003cbr/\u003eمرکز عملیات تجارت دریایی بریتانیا از کشتی‌های عبوری خواسته است در این منطقه با احتیاط تردد کنند و هرگونه فعالیت مشکوک را به این مرکز گزارش دهند.\u003cbr/\u003e\u003cbr/\u003eبه گزارش رویترز نفتکش هدف‌قرارگرفته \u0026#34;ام‌تی دومینیکا پراسپریتی\u0026#34;نام دارد و با پرچم لیبریا فعالیت می‌کند.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cu\u003e@dw_farsi\u003c/u\u003e\u003c/a\u003e",
