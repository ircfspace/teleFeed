    {
      "id": 127602,
      "message": "\u003ca href=\"https://p.dw.com/p/5HOMG\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B6.png\u0026#39;)\"\u003e\u003cb\u003e🔶\u003c/b\u003e\u003c/i\u003eمراسم رنگارنگ با رقص و آواز پیش از آغاز فینال جام جهانی ۲۰۲۶\u003cbr/\u003e\u003c/a\u003e \u003cbr/\u003eپیکار نهایی مسابقات جام جهانی فوتبال ۲۰۲۶ میان آرژانتین و اسپانیا برگزار می‌شود. آرژانتین در مرحله نیمه‌نهایی از سد انگلیس گذشت و اسپانیا نیز با پیروزی مقتدرانه بر فرانسه به فینال رسید.\u003cbr/\u003e\u003cbr/\u003eپیش از آغاز مسابقه و ورود دو تیم به میدان برای گرم کردن و آماده‌سازی، مراسمی ویژه با نمایش و رقص و آواز برگزار شد.\u003cbr/\u003e\u003cbr/\u003eگروه‌های مختلف در این مراسم نمایشی رنگارنگ ارائه کردند.\u003cbr/\u003e\u003cbr/\u003eهواداران ملی‌پوشان آرژانتین بخشی از ورزشگاه نیویورک را با پیراهن تیم ملی و پرچم‌های کشورشان به رنگ‌‌های آبی و سفید درآورده‌اند.\u003cbr/\u003e\u003cbr/\u003eطرفداران تیم ملی فوتبال اسپانیا نیز بخش‌هایی از ورزشگاه نیویورک را به خود اختصاص داده و به رنگ سرخ درآورده‌اند. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e@dw_farsi\u003c/a\u003e",
