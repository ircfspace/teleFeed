    {
      "id": 131174,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B8.png\u0026#39;)\"\u003e\u003cb\u003e📸\u003c/b\u003e\u003c/i\u003e\u003ca href=\"https://pepurl.com/p/39KtY?at_medium=Messenger\u0026amp;amp;at_campaign=Telegram\u0026amp;amp;at_channel=DW_Persian\u0026amp;amp;at_dw_language=fa-ir\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eعکس روز؛ دنیای اسرارآمیز نورها در غار بارباروسا\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eغار تاریخی و شگفت‌انگیز بارباروسا در کیف‌هایزرلند آلمان، این روزها میزبان جلوه‌ای رازآلود از نورپردازی‌های هنری است. هنرمندان با الهام از تم هالووین، این غار طبیعی ۱۵ هزار متر مربعی را با نورپردازی‌های ویژه، از جمله انعکاس تار عنکبوت‌های بزرگ بر دیواره‌ها و سقف غار، به یک گالری زیرزمینی تماشایی و در عین حال کمی رعب‌آور تبدیل کرده‌اند. \u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\"\u003e@dw_farsi\u003c/a\u003e",
