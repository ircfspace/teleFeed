    {
      "id": 132376,
      "message": "\u003ca href=\"https://pepurl.com/p/5PObY?at_medium=Messenger\u0026amp;amp;at_campaign=Telegram\u0026amp;amp;at_channel=DW_Persian\u0026amp;amp;at_dw_language=fa-ir\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B6.png\u0026#39;)\"\u003e\u003cb\u003e🔶\u003c/b\u003e\u003c/i\u003eهشدار درباره کاهش احتمالی جمعیت ایران به ۳۱ میلیون نفر\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eبه گزارش ایلنا، خبرگزاری کار ایران، مرضیه وحید دستجردی، دبیر ستاد ملی جمعیت، اعلام کرد نرخ باروری کلی ایران در سال ۱۴۰۴ به ۱.۳۴ فرزند به ازای هر زن رسیده است؛ در حالی که برای حفظ \u003ca href=\"https://www.dw.com/fa-ir/%D8%AC%D9%85%D8%B9%DB%8C%D8%AA/t-72622767\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cu\u003eجمعیت\u003c/u\u003e\u003c/a\u003e فعلی ایران، این شاخص باید بیش از ۲.۱ باشد.\u003cbr/\u003e\u003cbr/\u003eاو با استناد به برآوردهای \u003ca href=\"https://www.dw.com/fa-ir/%D8%B3%D8%A7%D8%B2%D9%85%D8%A7%D9%86-%D8%AC%D9%87%D8%A7%D9%86%DB%8C-%D8%A8%D9%87%D8%AF%D8%A7%D8%B4%D8%AA/t-18039097\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cu\u003eسازمان جهانی بهداشت\u003c/u\u003e\u003c/a\u003e هشدار داد در صورت تداوم روند کنونی، جمعیت ایران طی ۷۵ سال آینده به ۳۱ میلیون نفر کاهش خواهد یافت.\u003cbr/\u003e\u003cbr/\u003eوحید دستجردی تورم، هزینه بالای مسکن، تأخیر در ازدواج، تحولات فرهنگی، فردگرایی و دشواری ایجاد تعادل میان اشتغال و فرزندآوری برای زنان شاغل را از عوامل کاهش نرخ فرزندآوری دانست.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003cu\u003e@dw_farsi\u003c/u\u003e\u003c/a\u003e",
