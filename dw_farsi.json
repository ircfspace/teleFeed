    {
      "id": 129428,
      "message": "\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B6.png\u0026#39;)\"\u003e\u003cb\u003e🔶\u003c/b\u003e\u003c/i\u003e \u003ca href=\"https://p.dw.com/p/5Jgzv\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003eسرمایه‌گذاری خارجی در آلمان ۵۰ درصد افزایش یافت\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003eسرمایه‌گذاری شرکت‌های خارجی در آلمان پس از سقوط قابل توجه در سال ۲۰۲۴، دوباره افزایش یافته است. موسسه اقتصاد آلمان در کلن می‌گوید سرمایه‌گذاری خارجی در سال ۲۰۲۵ به حدود ۸۶ میلیارد یورو رسیده است.\u003cbr/\u003e\u003cbr/\u003eبر اساس تحلیل \u0026#34;موسسه اقتصاد آلمان\u0026#34;، که بر پایه داده‌های تازه بانک مرکزی آلمان انجام شده، حجم سرمایه‌گذاری خارجی در آلمان در سال ۲۰۲۵ نسبت به سال قبل ۵۰ درصد افزایش یافته است.\u003cbr/\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\"\u003e@dw_farsi\u003c/a\u003e",
      "date": "2026-08-31T13:44:08Z",
