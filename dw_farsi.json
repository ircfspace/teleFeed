    {
      "id": 126246,
      "message": "\u003ca href=\"https://p.dw.com/p/5FlVg\" target=\"_blank\" rel=\"noopener\" onclick=\"return confirm(\u0026#39;Open this link?\\n\\n\u0026#39;+this.href);\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94B6.png\u0026#39;)\"\u003e\u003cb\u003e🔶\u003c/b\u003e\u003c/i\u003eهیات مذاکره‌کننده جمهوری اسلامی برای گفت‌وگو با آمریکا راهی سوئیس شد\u003cbr/\u003e\u003c/a\u003e\u003cbr/\u003eرسانه‌های دولتی ایران گزارش دادند که هیات مذاکره‌کننده جمهوری اسلامی برای گفت‌وگو با آمریکا درباره اجرای تفاهم‌نامه پایان جنگ، عازم سوئیس شده است.\u003cbr/\u003e\u003cbr/\u003eبر اساس این گزارش‌ها، محمدباقر قالیباف، رئیس مجلس شورای اسلامی و عباس عراقچی، وزیر امور خارجه در راس این هیات قرار دارند و عبدالناصر همتی، کاظم غریب‌آبادی، اسماعیل بقایی و حمید بورد نیز از دیگر اعضای هیات ایرانی هستند.\u003cbr/\u003e\u003cbr/\u003eدر همین زمینه خبرگزاری فارس، وابسته به سپاه پاسداران به نقل از منبعی نزدیک به تیم مذاکره‌کننده گزارش داده است که علی باقری کنی، معاون دبیر شورای‌ عالی امنیت ملی نیز در این سفر حضور دارد.\u003cbr/\u003e\u003cbr/\u003eاسماعیل بقایی، سخنگوی وزارت خارجه ایران، هدف این سفر را \u0026#34;پیگیری اجرای تعهدات طرف مقابل\u0026#34; خوانده و تاکید کرده است که این مذاکرات به معنای آغاز دور تازه‌ای از گفت‌وگوها نیست.\u003cbr/\u003e\u003cbr/\u003e\u003cu\u003e\u003cbr/\u003e\u003c/u\u003e\u003ca href=\"https://t.me/dw_farsi\" target=\"_blank\"\u003e\u003cu\u003e@dw_farsi\u003c/u\u003e\u003c/a\u003e",
